            metodo: 'Efectivo €',
            referencia: 'RESERVA-FAMILIAR',
            captureDataUrl: null,
            verificado: true
          }
        ];
      });

      // FIRMAS WAIVER (EL CLIENTE FIRMA EN SU VISTA Y EL OPERADOR LAS RECIBE EN SU PANEL)
      const [firmasDia, setFirmasDia] = useState(() => {
        try {
          const saved = localStorage.getItem('divina_firmas_v10');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return [
          { id: 'F-101', nombre: 'Ricardo Valera', documento: 'V-16.204.991', telefono: '0414-2910021', hora: '09:36 AM', firmaDataUrl: null },
          { id: 'F-102', nombre: 'Carlos A. Mendoza', documento: 'V-18.492.310', telefono: '0412-8832100', hora: '10:15 AM', firmaDataUrl: null }
        ];
      });

      // Guardar automáticamente en localStorage y sincronizar entre pestañas
      useEffect(() => {
        try {
          localStorage.setItem('divina_motos_v10', JSON.stringify(motos));
        } catch (e) {}
      }, [motos]);

      useEffect(() => {
        try {
          localStorage.setItem('divina_slots_v10', JSON.stringify(slots));
        } catch (e) {}
      }, [slots]);

      useEffect(() => {
        try {
          localStorage.setItem('divina_ventas_v10', JSON.stringify(ventasDia));
        } catch (e) {}
      }, [ventasDia]);

      useEffect(() => {
        try {
          localStorage.setItem('divina_firmas_v10', JSON.stringify(firmasDia));
        } catch (e) {}
      }, [firmasDia]);

      useEffect(() => {
        const onStorage = (e) => {
          try {
            if (e.key === 'divina_motos_v10' && e.newValue) setMotos(JSON.parse(e.newValue).map(normalizarMoto));
            if (e.key === 'divina_slots_v10' && e.newValue) setSlots(recalcularHorariosCadena(JSON.parse(e.newValue)));
            if (e.key === 'divina_ventas_v10' && e.newValue) setVentasDia(JSON.parse(e.newValue));
            if (e.key === 'divina_firmas_v10' && e.newValue) setFirmasDia(JSON.parse(e.newValue));
          } catch (err) {}
        };
        window.addEventListener('storage', onStorage);
        return () => window.removeEventListener('storage', onStorage);
      }, []);

      const [miTicketClienteId, setMiTicketClienteId] = useState(null);
      const [miReservaClienteId, setMiReservaClienteId] = useState(null);
      const [miWaiverFirmado, setMiWaiverFirmado] = useState(null);

      // MODALES
      const [modalDespachoMoto, setModalDespachoMoto] = useState(null);
      const [despachoNombre, setDespachoNombre] = useState('');
      const [despachoToldo, setDespachoToldo] = useState('');
      const [despachoDuracion, setDespachoDuracion] = useState(15);
      const [despachoMetodoPago, setDespachoMetodoPago] = useState('Efectivo €');
      const [despachoSlotId, setDespachoSlotId] = useState('');
      const [despachoIdReserva, setDespachoIdReserva] = useState('');
      const [despachoChecklistSeguridad, setDespachoChecklistSeguridad] = useState(false);

      const [modalRetornoMoto, setModalRetornoMoto] = useState(null);
      const [inputNuevoHorometro, setInputNuevoHorometro] = useState('');
      const [retornoPunto, setRetornoPunto] = useState('parguito');

      const [modalReservarSlot, setModalReservarSlot] = useState(null);
      const [reservaNombre, setReservaNombre] = useState('');
      const [reservaToldo, setReservaToldo] = useState('');
      const [reservaDuracion, setReservaDuracion] = useState(15);
      const [reservaMotoNum, setReservaMotoNum] = useState('01');
      const [reservaMotosSeleccionadas, setReservaMotosSeleccionadas] = useState(['01']);
      const [reservaCantidadMotos, setReservaCantidadMotos] = useState(1);
      const [reservaPunto, setReservaPunto] = useState('parguito');
      const [reservaPersonas, setReservaPersonas] = useState(1);
      const [reservaMetodoPago, setReservaMetodoPago] = useState('Pago Móvil BCV');
      const [reservaReferencia, setReservaReferencia] = useState('');
      const [reservaCaptureDataUrl, setReservaCaptureDataUrl] = useState(null);
      const [reservaCaptureNombre, setReservaCaptureNombre] = useState('');

      const [modalTicketDetalle, setModalTicketDetalle] = useState(null);
      const [alarmaSonando, setAlarmaSonando] = useState(false);
      const [modalVerCapture, setModalVerCapture] = useState(null);

      const [modalNuevoHorario, setModalNuevoHorario] = useState(false);
      const [customHoraInput, setCustomHoraInput] = useState('');
      const [customNombreInput, setCustomNombreInput] = useState('');
      const [customToldoInput, setCustomToldoInput] = useState('');
      const [customDuracionInput, setCustomDuracionInput] = useState(15);
      const [errorCapitania, setErrorCapitania] = useState('');

      // CALCULADORA Y FORMULARIO DIRECTO DE REPORTE DE PAGO + CAPTURE + AGENDAMIENTO
      const [calcDuracion, setCalcDuracion] = useState(15);
      const [calcCantidadMotos, setCalcCantidadMotos] = useState(1);
      const [calcMotosSeleccionadas, setCalcMotosSeleccionadas] = useState(['02']);
      const [calcRecibidoEUR, setCalcRecibidoEUR] = useState('');
      const [calcClienteManual, setCalcClienteManual] = useState('');
      const [calcMetodoManual, setCalcMetodoManual] = useState('Efectivo €');

      const [pagoNombre, setPagoNombre] = useState('');
      const [pagoToldo, setPagoToldo] = useState('');
      const [pagoMetodo, setPagoMetodo] = useState('Pago Móvil BCV');
      const [pagoReferencia, setPagoReferencia] = useState('');
      const [pagoCaptureDataUrl, setPagoCaptureDataUrl] = useState(null);
      const [pagoCaptureNombre, setPagoCaptureNombre] = useState('');
      const [pagoSlotIdSeleccionado, setPagoSlotIdSeleccionado] = useState('');
      const [pagoConfirmadoInfo, setPagoConfirmadoInfo] = useState(null);
      const [pagoPunto, setPagoPunto] = useState('parguito');

      // WAIVER CANVAS (EN VISTA CLIENTE PARA QUE EL CLIENTE FIRME ANTES DE ABORDAR)
      const [waiverNombre, setWaiverNombre] = useState('');
      const [waiverDoc, setWaiverDoc] = useState('');
      const [waiverTel, setWaiverTel] = useState('');
      const [haFirmadoCanvas, setHaFirmadoCanvas] = useState(false);
      const canvasRef = useRef(null);
      const isDrawingRef = useRef(false);

      useEffect(() => {
        const initCanvas = () => {
          if (!canvasRef.current) return;
          const canvas = canvasRef.current;
          const rect = canvas.getBoundingClientRect();
          if (rect.width === 0) return;
          const dpr = window.devicePixelRatio || 1;
          canvas.width = rect.width * dpr;
          canvas.height = rect.height * dpr;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.scale(dpr, dpr);
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.lineWidth = 2.8;
            ctx.strokeStyle = '#16171A';
          }
        };
        const timer = setTimeout(initCanvas, 150);
        window.addEventListener('resize', initCanvas);
        return () => {
          clearTimeout(timer);
          window.removeEventListener('resize', initCanvas);
        };
      }, [modoVista, tabOperador]);

      const obtenerCoordsCanvas = (e) => {
        const canvas = canvasRef.current;
        if (!canvas) return { x: 0, y: 0 };
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - rect.left, y: clientY - rect.top };
      };

      const iniciarTrazo = (e) => {
        if (e.cancelable) e.preventDefault();
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const { x, y } = obtenerCoordsCanvas(e);
        ctx.beginPath();
        ctx.moveTo(x, y);
        isDrawingRef.current = true;
        setHaFirmadoCanvas(true);
      };

      const dibujarTrazo = (e) => {
        if (!isDrawingRef.current) return;
        if (e.cancelable) e.preventDefault();
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const { x, y } = obtenerCoordsCanvas(e);
        ctx.lineTo(x, y);
        ctx.stroke();
      };

      const terminarTrazo = () => {
        isDrawingRef.current = false;
      };

      const limpiarCanvasFirma = () => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        setHaFirmadoCanvas(false);
      };

      const handleGuardarWaiver = (e) => {
        e.preventDefault();
        if (!waiverNombre.trim() || !waiverDoc.trim()) return;
        if (!haFirmadoCanvas) {
          alert('Por favor dibuja tu firma con el dedo o mouse dentro del recuadro.');
          return;
        }
        const dataUrl = canvasRef.current ? canvasRef.current.toDataURL('image/png') : null;
        const nuevaFirma = {
          id: 'F-' + Date.now().toString().slice(-3),
          nombre: waiverNombre.trim(),
          documento: waiverDoc.trim(),
          telefono: waiverTel.trim() || 'No indicado',
          hora: formatMinutesToHora(minutosVET),
          firmaDataUrl: dataUrl
        };
        setFirmasDia(prev => [nuevaFirma, ...prev]);
        setMiWaiverFirmado(nuevaFirma);
        setWaiverNombre('');
        setWaiverDoc('');
        setWaiverTel('');
        limpiarCanvasFirma();
        playChimeSound();
      };

      // =====================================================================
      // EVALUADOR DE CAPACIDAD Y DESOCUPACIÓN POR UNIDAD (#01, #02 y #03)
      // Cada moto tiene su propio carril exacto según la duración real (15, 20, 30 o 40 min).
      // Soporta multi-fecha: 'fechaConsulta' (por defecto 'fechaSeleccionada').
      // En días futuros (mañana, viernes, sábado, domingo), los turnos NO salen 'concluidos'.
      // =====================================================================
      const evaluarEstadoSlot = (slot, fechaConsulta = fechaSeleccionada) => {
        if (!slot) {
          return {
            codigo: 'disponible',
            texto: '3/3 MOTOS LIBRES',
            esEnAgua: false,
            esReservado: false,
            esDisponible: true,
            todasOcupadas: false,
            parcialmenteOcupado: false,
            esPasado: false,
            esFuturo: true,
            esHoy: false,
            fecha: fechaConsulta || fechaHoyISO,
            detalleMotos: [],
            motosLibres: UNIDADES_FLOTA,
            motosEnTaller: [],
            motosOcupadas: [],
            motosOperativasTotal: 3,
            cantLibres: 3,
            cantOcupadas: 0,
            horaInicioReal: '09:40 AM',
            horaRetornoReal: '09:55 AM',
            horaLibreReal: '09:40 AM'
          };
        }

        const fecha = fechaConsulta || fechaHoyISO;
        const esHoy = (fecha === fechaHoyISO);
        const esFuturo = (fecha > fechaHoyISO);
        const esPasadoDia = (fecha < fechaHoyISO);

        const minInicioEfectivo = slot.minDia + retrasoGlobal;
        const finAguaEfectivo = slot.finAguaMin + retrasoGlobal;
        const finMuelleEfectivo = slot.finMuelleMin + retrasoGlobal;

        // UN HORARIO ES PASADO SI:
        // [1] La fecha consultada es de un día anterior a hoy (esPasadoDia)
        // [2] Es HOY y la hora actual de Venezuela ya superó o igualó la hora de inicio de este slot (minutosVET >= minInicioEfectivo)
        const esHorarioYaTranscurrido = esPasadoDia || (esHoy && minutosVET >= minInicioEfectivo);

        // Evaluamos cada una de las 3 motos (#01, #02, #03) de forma independiente
        const detalleMotos = UNIDADES_FLOTA.map(num => {
          const objMoto = motos.find(m => m.numero === num);
          const ubicacionMoto = objMoto ? (objMoto.ubicacion || 'parguito') : 'parguito';
          const nombreModelo = objMoto ? objMoto.nombre : `YAMAHA #${num}`;

          if (objMoto && objMoto.estado === 'mantenimiento') {
            return {
              numero: num,
              nombreModelo,
              ubicacion: ubicacionMoto,
              estado: 'taller',
              motivoTaller: objMoto.motivoTaller || 'Mantenimiento preventivo',
              disponible: false,
              maxMinPosibles: 0,
              reserva: null,
              slotOrigenId: null,
              horaInicioReserva: formatMinutesToHora(minInicioEfectivo),
              horaRetornoReal: formatMinutesToHora(finAguaEfectivo),
              horaLibreReal: formatMinutesToHora(finMuelleEfectivo),
              horaSeDesocupa: null,
              horaLibreDesde: null,
              minutosLibreAntes: 0,
              textoOcupada: 'En taller',
              textoLibre: 'No disponible'
            };
          }

          // Buscamos todas las reservas de esta moto específica en toda la agenda PARA ESTA FECHA
          const todasReservasMoto = [];
          for (const s of slots) {
            const listaRes = Array.isArray(s.reservas) ? s.reservas : normalizarReservasDeSlot(s);
            for (const r of listaRes) {
              const rFecha = r.fecha || fechaHoyISO;
              if (r.motoNum === num && rFecha === fecha) {
                const iniR = (r.minInicio !== undefined ? r.minInicio : s.minDia) + retrasoGlobal;
                const durR = Number(r.duracionMin) || 15;
                const finR = iniR + durR;
                todasReservasMoto.push({ r, s, iniR, durR, finR });
              }
            }
          }

          // ¿Hay una reserva que esté ocupando esta moto en este horario exacto en esta fecha?
          let reservaEnTurno = todasReservasMoto.find(item => item.s.id === slot.id);
          let reservaSolapada = todasReservasMoto.find(item => item.iniR <= minInicioEfectivo && item.finR > minInicioEfectivo);
          let reservaActivaItem = reservaEnTurno || reservaSolapada || null;

          // Verificamos si en este momento exacto está navegando en el agua (solo aplica a hoy)
          const navegandoEstaMoto = Boolean(
            esHoy &&
            objMoto &&
            objMoto.estado === 'en_agua' &&
            objMoto.alquiler &&
            reservaActivaItem &&
            (objMoto.alquiler.idReserva === reservaActivaItem.r.idReserva ||
              objMoto.alquiler.slotId === reservaActivaItem.s.id ||
              (reservaActivaItem.r.cli && objMoto.alquiler.cliente.toLowerCase() === reservaActivaItem.r.cli.toLowerCase()))
          );

          // Si el horario ya transcurrió en el reloj oficial de Venezuela y la moto no está en el agua:
          // Ningún usuario puede agendar en el pasado (ej: agendar a las 9:00 AM si son las 4:30 PM)
          if (esHorarioYaTranscurrido && !navegandoEstaMoto) {
            const r = reservaActivaItem ? reservaActivaItem.r : null;
            const durR = reservaActivaItem ? reservaActivaItem.durR : 15;
            return {
              numero: num,
              nombreModelo,
              ubicacion: r ? (r.puntoEmbarque || ubicacionMoto) : ubicacionMoto,
              estado: r ? 'concluido' : 'pasado',
              disponible: false,
              maxMinPosibles: 0,
              reserva: r,
              slotOrigenId: reservaActivaItem ? reservaActivaItem.s.id : slot.id,
              vieneDeTurnoAnterior: Boolean(reservaActivaItem && reservaActivaItem.s.id !== slot.id),
              horaInicioReserva: formatMinutesToHora(minInicioEfectivo),
              horaRetornoReal: formatMinutesToHora(finAguaEfectivo),
              horaLibreReal: formatMinutesToHora(finMuelleEfectivo),
              horaSeDesocupa: null,
              horaLibreDesde: null,
              minutosLibreAntes: 0,
              textoOcupada: r ? `Paseo concluido (${durR}m)` : '',
              textoLibre: 'Horario ya concluido'
            };
          }

          if (reservaActivaItem) {
            const { r, s, iniR, durR, finR } = reservaActivaItem;
            const horaFinTxt = formatMinutesToHora(finR);

            return {
              numero: num,
              nombreModelo,
              ubicacion: r.puntoEmbarque || ubicacionMoto,
              estado: navegandoEstaMoto ? 'en_agua' : 'reservada',
              disponible: false,
              maxMinPosibles: 0,
              reserva: r,
              slotOrigenId: s.id,
              vieneDeTurnoAnterior: Boolean(s.id !== slot.id),
              horaInicioReserva: formatMinutesToHora(iniR),
              horaRetornoReal: horaFinTxt,
              horaLibreReal: horaFinTxt,
              horaSeDesocupa: horaFinTxt,
              horaLibreDesde: null,
              minutosLibreAntes: 0,
              textoOcupada: `Ocupada (${durR}m) • Se desocupa a las ${horaFinTxt}`,
              textoLibre: ''
            };
          }

          // Si la moto está libre en este turno futuro:
          // Calculamos cuánto tiempo tiene antes de su PRÓXIMA reserva posterior en este mismo día
          const posteriores = todasReservasMoto.filter(item => item.iniR > minInicioEfectivo).sort((a, b) => a.iniR - b.iniR);
          const proxima = posteriores[0] || null;
          const margenMinutos = proxima ? Math.max(15, proxima.iniR - minInicioEfectivo) : 40;
          const maxMinPosibles = margenMinutos >= 40 ? 40 : margenMinutos >= 30 ? 30 : margenMinutos >= 20 ? 20 : 15;

          // Última reserva previa terminada antes de este inicio de turno
          const previas = todasReservasMoto.filter(item => item.finR <= minInicioEfectivo).sort((a, b) => b.finR - a.finR);
          const ultimaPrevia = previas[0] || null;
          const minutosLibreAntes = ultimaPrevia ? Math.max(0, minInicioEfectivo - ultimaPrevia.finR) : 999;
          const horaLibreDesdeTxt = ultimaPrevia ? formatMinutesToHora(ultimaPrevia.finR) : null;

          let textoLibre = 'Lista en orilla • Libre de inmediato';
          if (ultimaPrevia && minutosLibreAntes < 180) {
            textoLibre = minutosLibreAntes > 0
              ? `Libre desde las ${horaLibreDesdeTxt} (hace ${minutosLibreAntes} min)`
              : `Libre a las ${horaLibreDesdeTxt}`;
          }

          return {
            numero: num,
            nombreModelo,
            ubicacion: ubicacionMoto,
            estado: 'libre',
            disponible: true,
            maxMinPosibles,
            reserva: null,
            slotOrigenId: null,
            vieneDeTurnoAnterior: false,
            horaInicioReserva: formatMinutesToHora(minInicioEfectivo),
            horaRetornoReal: formatMinutesToHora(minInicioEfectivo + 15),
            horaLibreReal: formatMinutesToHora(minInicioEfectivo),
            horaSeDesocupa: null,
            horaLibreDesde: horaLibreDesdeTxt,
            minutosLibreAntes,
            textoOcupada: '',
            textoLibre
          };
        });

        const motosLibres = detalleMotos.filter(d => d.disponible).map(d => d.numero);
        const motosEnTaller = detalleMotos.filter(d => d.estado === 'taller').map(d => d.numero);
        const motosOcupadas = detalleMotos.filter(d => !d.disponible && d.estado !== 'taller' && d.estado !== 'pasado' && d.estado !== 'concluido');
        const motosOperativasTotal = Math.max(1, 3 - motosEnTaller.length);
        const cantLibres = motosLibres.length;
        const cantOcupadas = motosOcupadas.length;
        const hayMotoEnAgua = detalleMotos.some(d => d.estado === 'en_agua');

        // CLAVE: Determinar si el horario ya concluyó
        let esPasado = false;
        if (esPasadoDia) {
          esPasado = true;
        } else if (esHoy) {
          if (hayMotoEnAgua) {
            esPasado = false; // está navegando en el agua ahora
          } else {
            esPasado = (minutosVET >= minInicioEfectivo);
          }
        } else {
          // esFuturo (mañana, viernes, sábado, domingo)
          esPasado = false;
        }

        // Un horario está DISPONIBLE mientras no haya pasado y tenga al menos 1 moto operativa libre
        const esDisponible = !esPasado && cantLibres > 0;
        const todasOcupadas = !esPasado && cantLibres === 0;
        const parcialmenteOcupado = !esPasado && cantOcupadas > 0 && cantLibres > 0;

        let texto = `${cantLibres}/${motosOperativasTotal} MOTOS LIBRES`;
        if (esPasado) {
          texto = 'CONCLUIDO';
        } else if (todasOcupadas) {
          texto = hayMotoEnAgua
            ? `${motosOperativasTotal}/${motosOperativasTotal} OCUPADAS (EN AGUA)`
            : `AGOTADO (${motosOperativasTotal}/${motosOperativasTotal} OCUPADAS)`;
        } else if (parcialmenteOcupado) {
          const ocupDetalles = motosOcupadas.map(m => `#${m.numero} se desocupa ${m.horaSeDesocupa || ''}`).join(', ');
          texto = `${cantLibres}/${motosOperativasTotal} LIBRES (${motosLibres.map(n => `#${n}`).join(', ')}) • ${ocupDetalles}`;
        }

        // Hora en que se libera la primera moto ocupada
        const minPrimeraLibre = motosOcupadas.length > 0
          ? Math.min(
              ...motosOcupadas.map(m =>
                m.reserva && m.reserva.finMuelleMin !== undefined
                  ? m.reserva.finMuelleMin + retrasoGlobal
                  : (m.horaSeDesocupa ? parseHoraToMinutes(m.horaSeDesocupa) : finMuelleEfectivo)
              )
            )
          : minInicioEfectivo;

        return {
          codigo: esPasado
            ? 'concluido'
            : todasOcupadas
            ? 'agotado'
            : parcialmenteOcupado
            ? 'parcial'
            : 'disponible',
          texto,
          esEnAgua: hayMotoEnAgua,
          esReservado: cantOcupadas > 0,
          esDisponible,
          todasOcupadas,
          parcialmenteOcupado,
          esPasado,
          esFuturo,
          esHoy,
          fecha,
          detalleMotos,
          motosLibres,
          motosEnTaller,
          motosOcupadas,
          motosOperativasTotal,
          cantLibres,
          cantOcupadas,
          horaInicioReal: formatMinutesToHora(minInicioEfectivo),
          horaRetornoReal: formatMinutesToHora(finAguaEfectivo),
          horaLibreReal: formatMinutesToHora(minPrimeraLibre)
        };
      };

      // Estadísticas consolidadas para cualquier fecha (reservas, ingresos previstos y disponibilidad)
      const obtenerEstadisticasFecha = (fechaISO) => {
        let totalReservas = 0;
        let totalEUR = 0;
        let totalMinutos = 0;
        const motosConCitas = new Set();

        for (const s of slots) {
          const listaRes = Array.isArray(s.reservas) ? s.reservas : normalizarReservasDeSlot(s);
          for (const r of listaRes) {
            if ((r.fecha || fechaHoyISO) === fechaISO) {
              totalReservas++;
              totalEUR += (r.tarifaEUR || TARIFAS_MAP[r.duracionMin] || 30);
              totalMinutos += (Number(r.duracionMin) || 15);
              if (r.motoNum) motosConCitas.add(r.motoNum);
            }
          }
        }

        const slotsConDisponibilidad = slots.filter(s => {
          const ev = evaluarEstadoSlot(s, fechaISO);
          return !ev.esPasado && ev.cantLibres > 0;
        }).length;

        return {
          fechaISO,
          totalReservas,
          totalEUR,
          totalBs: (totalEUR * tasaEUR).toFixed(2),
          totalMinutos,
          motosConCitas: Array.from(motosConCitas).sort(),
          slotsConDisponibilidad,
          totalSlots: slots.length
        };
      };

      // SUBIR FOTO DEL CAPTURE DE PAGO (CONVIERTE A DATA URL PARA GUARDAR EN BACKEND DE OPERACIONES)
      const handleSubirArchivoCapture = (e, tipoFormulario) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          const dataUrl = ev.target.result;
          if (tipoFormulario === 'modal') {
            setReservaCaptureDataUrl(dataUrl);
            setReservaCaptureNombre(file.name);
          } else {
            setPagoCaptureDataUrl(dataUrl);
            setPagoCaptureNombre(file.name);
          }
        };
        reader.readAsDataURL(file);
      };

      // ACCIONES DE RESERVA + REGISTRO DE PAGO EN BACKEND (RESPETANDO LAS 3 MOTOS Y EL PUNTO SUNSOL / PARGUITO)
      const handleGuardarReservaSlot = (e) => {
        e.preventDefault();
        if (!modalReservarSlot || !reservaNombre.trim()) return;
        if (reservaMetodoPago === 'Pago Móvil BCV' && !reservaReferencia.trim()) {
          alert('Por favor ingresa el número de referencia de tu Pago Móvil (o selecciona Efectivo €).');
          return;
        }

        const fechaRes = modalFechaReserva || fechaSeleccionada || fechaHoyISO;
        const slotActual = slots.find(s => s.id === modalReservarSlot.id) || modalReservarSlot;
        const evSlot = evaluarEstadoSlot(slotActual, fechaRes);
        const dur = Number(reservaDuracion) || 15;
        const motosAptasPorTiempo = evSlot.detalleMotos
          .filter(d => d.disponible && d.maxMinPosibles >= dur)
          .map(d => d.numero);

        if (motosAptasPorTiempo.length === 0) {
          alert(
            evSlot.cantLibres > 0
              ? `En este horario las motos libres tienen una cita en el turno siguiente (+20 min), por lo que solo admiten paseos de 15 o 20 min. Elige 15/20 min o selecciona el siguiente horario.`
              : 'En este horario ya están ocupadas las 3 motos. Por favor selecciona otro horario.'
          );
          return;
        }

        const seleccionUsuario = (reservaMotosSeleccionadas || []).filter(n => motosAptasPorTiempo.includes(n));
        const cantDeseada = Math.min(
          seleccionUsuario.length > 0 ? seleccionUsuario.length : (Number(reservaCantidadMotos) || 1),
          motosAptasPorTiempo.length
        );
        const motosOrdenadas = [
          ...seleccionUsuario,
          ...(motosAptasPorTiempo.includes(reservaMotoNum) && !seleccionUsuario.includes(reservaMotoNum) ? [reservaMotoNum] : []),
          ...motosAptasPorTiempo.filter(n => !seleccionUsuario.includes(n) && n !== reservaMotoNum)
        ];
        const motosAsignadas = motosOrdenadas.slice(0, cantDeseada);

        const tarifaUnitaria = TARIFAS_MAP[dur] || 30;
        const tarifaTotal = tarifaUnitaria * motosAsignadas.length;
        const refLimpia = reservaReferencia.trim() || (reservaMetodoPago === 'Efectivo €' ? 'PAGO-EN-MUELLE' : 'SIN-REF');
        const puntoElegido = reservaPunto || 'parguito';
        const cantPersonas = Number(reservaPersonas) || 1;

        const nuevasReservas = motosAsignadas.map((numMoto, idx) => ({
          idReserva: `${slotActual.id}-M${numMoto}-${Date.now().toString().slice(-3)}${idx}`,
          fecha: fechaRes,
          motoNum: numMoto,
          cli: reservaNombre.trim(),
          toldo: reservaToldo.trim() || nombrePunto(puntoElegido),
          puntoEmbarque: puntoElegido,
          personas: cantPersonas,
          chaleco: '0' + ((Math.floor(Math.random() * 8) + idx) % 8 + 1),
          duracionMin: dur,
          tarifaEUR: tarifaUnitaria,
          metodoPago: reservaMetodoPago,
          referenciaPago: refLimpia,
          captureDataUrl: reservaCaptureDataUrl || null,
          pagoVerificado: modoVista === 'operador',
          despachado: false
        }));

        const actualizados = slots.map(s => {
          if (s.id === slotActual.id) {
            const existentes = Array.isArray(s.reservas) ? s.reservas : normalizarReservasDeSlot(s);
            return {
              ...s,
              reservas: [...existentes, ...nuevasReservas]
            };
          }
          return s;
        });

        const recalculados = recalcularHorariosCadena(actualizados);
        setSlots(recalculados);

        const slotRecalculado = recalculados.find(s => s.id === slotActual.id);
        const horaInicioTxt = slotRecalculado ? formatMinutesToHora(slotRecalculado.minDia + retrasoGlobal) : slotActual.hora;
        const horaFinAguaTxt = slotRecalculado ? formatMinutesToHora(slotRecalculado.minDia + retrasoGlobal + dur) : '';

        const nuevaOperacion = {
          id: 'V-' + Date.now().toString().slice(-4),
          fecha: fechaRes,
          fechaTexto: formatFechaBonita(fechaRes),
          slotId: slotActual.id,
          idReserva: nuevasReservas[0].idReserva,
          hora: horaInicioTxt,
          horarioTurno: `${horaInicioTxt} - ${horaFinAguaTxt} (${dur}m)`,
          cliente: reservaNombre.trim(),
          toldo: `${nombrePunto(puntoElegido)} • ${reservaToldo.trim() || 'Directo'}`,
          puntoEmbarque: puntoElegido,
          moto: motosAsignadas.map(n => `Yamaha #${n}`).join(', '),
          duracionMin: dur,
          montoEUR: tarifaTotal,
          metodo: reservaMetodoPago,
          referencia: refLimpia,
          captureDataUrl: reservaCaptureDataUrl || null,
          verificado: modoVista === 'operador'
        };
        setVentasDia(prev => [nuevaOperacion, ...prev]);

        if (modoVista === 'cliente') {
          setMiTicketClienteId(slotActual.id);
          setMiReservaClienteId(nuevasReservas[0].idReserva);
          if (!waiverNombre) setWaiverNombre(reservaNombre.trim());
        }
        setModalReservarSlot(null);
        setReservaNombre('');
        setReservaToldo('');
        setReservaDuracion(15);
        setReservaCantidadMotos(1);
        setReservaPersonas(1);
        setReservaReferencia('');
        setReservaCaptureDataUrl(null);
        setReservaCaptureNombre('');
        playChimeSound();
      };

      // REPORTE DIRECTO DESDE LA SECCIÓN DE CALCULADORA & PAGO MÓVIL (#cli-precios)
      const handleReportarPagoYAgendar = (e) => {
        e.preventDefault();
        if (!pagoNombre.trim() || !pagoToldo.trim()) {
          alert('Por favor ingresa tu nombre y tu número de toldo, habitación o teléfono.');
          return;
        }
        if (pagoMetodo === 'Pago Móvil BCV' && !pagoReferencia.trim()) {
          alert('Por favor ingresa los últimos dígitos de la referencia de tu Pago Móvil (o elige Efectivo € en Muelle).');
          return;
        }

        const fechaRes = pagoFecha || fechaSeleccionada || fechaHoyISO;
        const dur = Number(calcDuracion) || 15;
        const puntoElegido = pagoPunto || 'parguito';

        // Buscamos el horario elegido que tenga motos disponibles para esa duración en la fecha elegida
        const disponibles = slots.filter(s => {
          const ev = evaluarEstadoSlot(s, fechaRes);
          const aptas = ev.detalleMotos.filter(d => d.disponible && d.maxMinPosibles >= dur);
          return !ev.esPasado && aptas.length > 0;
        });
        const slotElegido = disponibles.find(s => s.id === pagoSlotIdSeleccionado) || disponibles[0];

        if (!slotElegido) {
          alert(`No hay horarios disponibles para esa duración el día ${formatFechaBonita(fechaRes)}. Por favor selecciona otra fecha u horario.`);
          return;
        }

        const evElegido = evaluarEstadoSlot(slotElegido, fechaRes);
        const motosAptas = evElegido.detalleMotos
          .filter(d => d.disponible && d.maxMinPosibles >= dur)
          .map(d => d.numero);

        // Usamos exactamente las motos que el usuario marcó en las tarjetas (#01, #02, #03)
        const seleccionadasValidas = (calcMotosSeleccionadas || []).filter(n => motosAptas.includes(n));
        const cantMotosFinal = Math.min(
          seleccionadasValidas.length > 0 ? seleccionadasValidas.length : (Number(calcCantidadMotos) || 1),
          motosAptas.length
        );
        const ordenMotos = [
          ...seleccionadasValidas,
          ...motosAptas.filter(n => !seleccionadasValidas.includes(n))
        ];
        const motosAsignadas = ordenMotos.slice(0, cantMotosFinal);

        const tarifaUnitaria = TARIFAS_MAP[dur] || 30;
        const montoTotalEUR = tarifaUnitaria * motosAsignadas.length;
        const refLimpia = pagoMetodo === 'Pago Móvil BCV' ? pagoReferencia.trim() : 'EFECTIVO-EN-MUELLE';

        const nuevasReservas = motosAsignadas.map((numMoto, idx) => ({
          idReserva: `${slotElegido.id}-M${numMoto}-${Date.now().toString().slice(-3)}${idx}`,
          fecha: fechaRes,
          motoNum: numMoto,
          cli: pagoNombre.trim(),
          toldo: pagoToldo.trim(),
          puntoEmbarque: puntoElegido,
          personas: 2,
          chaleco: '0' + ((Math.floor(Math.random() * 8) + idx) % 8 + 1),
          duracionMin: dur,
          tarifaEUR: tarifaUnitaria,
          metodoPago: pagoMetodo,
          referenciaPago: refLimpia,
          captureDataUrl: pagoCaptureDataUrl || null,
          pagoVerificado: pagoMetodo !== 'Pago Móvil BCV',
          despachado: false
        }));

        const actualizados = slots.map(s => {
          if (s.id === slotElegido.id) {
            const existentes = Array.isArray(s.reservas) ? s.reservas : normalizarReservasDeSlot(s);
            return {
              ...s,
              reservas: [...existentes, ...nuevasReservas]
            };
          }
          return s;
        });

        const recalculados = recalcularHorariosCadena(actualizados);
        setSlots(recalculados);

        const slotFinal = recalculados.find(s => s.id === slotElegido.id);
        const evFinal = slotFinal ? evaluarEstadoSlot(slotFinal, fechaRes) : null;
        const horaInicioTxt = slotFinal ? formatMinutesToHora(slotFinal.minDia + retrasoGlobal) : slotElegido.hora;
        const horaRetornoTxt = slotFinal ? formatMinutesToHora(slotFinal.minDia + retrasoGlobal + dur) : '';
        const horaMuelleLibreTxt = slotFinal ? formatMinutesToHora(slotFinal.minDia + retrasoGlobal + (dur <= 20 ? 20 : 40)) : '';

        const nuevaOperacion = {
          id: 'V-' + Date.now().toString().slice(-4),
          fecha: fechaRes,
          fechaTexto: formatFechaBonita(fechaRes),
          slotId: slotElegido.id,
          idReserva: nuevasReservas[0].idReserva,
          hora: horaInicioTxt,
          horarioTurno: `${horaInicioTxt} - ${horaRetornoTxt} (${dur}m)`,
          cliente: pagoNombre.trim(),
          toldo: `${nombrePunto(puntoElegido)} • ${pagoToldo.trim()}`,
          puntoEmbarque: puntoElegido,
          moto: motosAsignadas.map(n => `Yamaha #${n}`).join(', '),
          duracionMin: dur,
          montoEUR: montoTotalEUR,
          metodo: pagoMetodo,
          referencia: refLimpia,
          captureDataUrl: pagoCaptureDataUrl || null,
          verificado: pagoMetodo !== 'Pago Móvil BCV'
        };

        setVentasDia(prev => [nuevaOperacion, ...prev]);
        setMiTicketClienteId(slotElegido.id);
        setMiReservaClienteId(nuevasReservas[0].idReserva);
        if (!waiverNombre) setWaiverNombre(pagoNombre.trim());

        setPagoConfirmadoInfo({
          cliente: pagoNombre.trim(),
          referencia: refLimpia,
          fechaTexto: formatFechaBonita(fechaRes),
          puntoNombre: nombrePunto(puntoElegido),
          motosAsignadas: motosAsignadas.map(n => `Moto #${n}`).join(', '),
          motosRestantesEnHorario: evFinal ? evFinal.cantLibres : 0,
          horaSalida: horaInicioTxt,
          horaRetorno: horaRetornoTxt,
          horaSiguienteLibre: horaMuelleLibreTxt,
          duracionMin: dur,
          montoEUR: montoTotalEUR,
          montoBs: (montoTotalEUR * tasaEUR).toFixed(2)
        });

        setPagoNombre('');
        setPagoToldo('');
        setPagoReferencia('');
        setPagoCaptureDataUrl(null);
        setPagoCaptureNombre('');
        playChimeSound();
      };

      const handleAlternarVerificacionPago = (ventaId, slotIdAsociado) => {
        setVentasDia(prev =>
          prev.map(v => (v.id === ventaId ? { ...v, verificado: !v.verificado } : v))
        );
        if (slotIdAsociado) {
          setSlots(prev =>
            recalcularHorariosCadena(
              prev.map(s =>
                s.id === slotIdAsociado
                  ? {
                      ...s,
                      pagoVerificado: !s.pagoVerificado,
                      reservas: (s.reservas || []).map(r => ({ ...r, pagoVerificado: !r.pagoVerificado }))
                    }
                  : s
              )
            )
          );
        }
      };

      const handleCambiarDuracionSlot = (slotId, nuevaDuracion, idReservaEspecifica = null) => {
        const dur = Number(nuevaDuracion);
        const slotActual = slots.find(s => s.id === slotId);
        const resObjetivo = slotActual && (slotActual.reservas || []).find(
          r => !idReservaEspecifica || r.idReserva === idReservaEspecifica
        );
        const diffMin = resObjetivo ? dur - (Number(resObjetivo.duracionMin) || 15) : 0;

        const actualizados = slots.map(s => {
          if (s.id !== slotId) return s;
          const reservasAct = (s.reservas || []).map((r, idx) => {
            if (!idReservaEspecifica ? idx === 0 : r.idReserva === idReservaEspecifica) {
              return { ...r, duracionMin: dur, tarifaEUR: TARIFAS_MAP[dur] || 30 };
            }
            return r;
          });
          return { ...s, duracionMin: dur, tarifaEUR: TARIFAS_MAP[dur] || 30, reservas: reservasAct };
        });
        const recalculados = recalcularHorariosCadena(actualizados);
        setSlots(recalculados);

        // Actualizamos también en el libro de operaciones si ya estaba registrado
        const slotRecalc = recalculados.find(s => s.id === slotId);
        if (slotRecalc) {
          const hIni = formatMinutesToHora(slotRecalc.minDia + retrasoGlobal);
          const hFin = formatMinutesToHora(slotRecalc.minDia + retrasoGlobal + dur);
          setVentasDia(prev =>
            prev.map(v =>
              (idReservaEspecifica ? v.idReserva === idReservaEspecifica : v.slotId === slotId)
                ? {
                    ...v,
                    duracionMin: dur,
                    montoEUR: TARIFAS_MAP[dur] || 30,
                    hora: hIni,
                    horarioTurno: `${hIni} - ${hFin} (${dur}m)`
                  }
                : v
            )
          );
        }

        // Si este turno está navegando ahora mismo en una moto, actualizamos también su cronómetro
        setMotos(prev =>
          prev.map(m => {
            if (
              m.estado === 'en_agua' &&
              m.alquiler &&
              (m.alquiler.slotId === slotId &&
                (!idReservaEspecifica || m.alquiler.idReserva === idReservaEspecifica || (resObjetivo && m.alquiler.cliente === resObjetivo.cli)))
            ) {
              return {
                ...m,
                alquiler: {
                  ...m.alquiler,
                  duracionMin: dur,
                  tarifaEUR: TARIFAS_MAP[dur] || 30,
                  horaRetornoMs: m.alquiler.horaRetornoMs + diffMin * 60 * 1000
                }
              };
            }
            return m;
          })
        );
      };

      const handleEliminarCitaSlot = (slotId, idReservaEspecifica = null) => {
        const target = slots.find(s => s.id === slotId);
        if (!target) return;
        const resBorrar = idReservaEspecifica
          ? (target.reservas || []).find(r => r.idReserva === idReservaEspecifica)
          : (target.reservas || [])[0];
        const nombreCli = resBorrar ? resBorrar.cli : target.cli;
        const motoTxt = resBorrar ? `Moto #${resBorrar.motoNum}` : 'el turno';

        const msg = modoVista === 'cliente'
          ? `¿Deseas cancelar tu reserva de ${motoTxt} a las ${target.hora}?`
          : `¿Confirmas eliminar la reserva de ${nombreCli || 'este cliente'} (${motoTxt} • ${target.hora}) y liberar esa moto?`;
        if (!window.confirm(msg)) return;

        // Si estaba en agua en esa moto, liberamos también esa unidad
        setMotos(prev =>
          prev.map(m =>
            m.estado === 'en_agua' &&
            m.alquiler &&
            ((resBorrar && (m.alquiler.idReserva === resBorrar.idReserva || m.numero === resBorrar.motoNum)) ||
              (!resBorrar && m.alquiler.slotId === slotId))
              ? { ...m, estado: 'disponible', alquiler: null }
              : m
          )
        );

        const actualizados = slots.map(s => {
          if (s.id !== slotId) return s;
          const restantes = idReservaEspecifica
            ? (s.reservas || []).filter(r => r.idReserva !== idReservaEspecifica)
            : [];
          return {
            ...s,
            reservas: restantes,
            cli: restantes[0] ? restantes[0].cli : undefined,
            minFijo: restantes.length > 0 ? s.minFijo : undefined
          };
        });

        setSlots(recalcularHorariosCadena(actualizados));
        if (miTicketClienteId === slotId && (!idReservaEspecifica || idReservaEspecifica === miReservaClienteId)) {
          setMiTicketClienteId(null);
          setMiReservaClienteId(null);
        }
        if (modalTicketDetalle && modalTicketDetalle.id === slotId) setModalTicketDetalle(null);
      };

      const abrirModalDespacho = (moto, slotPreseleccionado = null, reservaPreseleccionada = null) => {
        setModalDespachoMoto(moto);
        setDespachoChecklistSeguridad(true);
        const res = reservaPreseleccionada || (slotPreseleccionado && (slotPreseleccionado.reservas || [])[0]) || null;
        if (slotPreseleccionado && (res || slotPreseleccionado.cli)) {
          setDespachoSlotId(slotPreseleccionado.id);
          setDespachoIdReserva(res ? res.idReserva : '');
          setDespachoNombre(res ? res.cli : slotPreseleccionado.cli);
          setDespachoToldo(res ? res.toldo : (slotPreseleccionado.toldo || ''));
          setDespachoDuracion(res ? res.duracionMin : (slotPreseleccionado.duracionMin || 15));
        } else {
          setDespachoSlotId('');
          setDespachoIdReserva('');
          setDespachoNombre('');
          setDespachoToldo('');
          setDespachoDuracion(15);
        }
      };

      const handleConfirmarDespachoMoto = (e) => {
        e.preventDefault();
        if (!modalDespachoMoto || !despachoNombre.trim()) return;

        const dur = Number(despachoDuracion) || 15;
        const tarifa = TARIFAS_MAP[dur] || 30;
        const gasGastado = GAS_MAP[dur] || 4;

        // Validación de seguridad de combustible (consumo + 6L de reserva mínima en mar abierto)
        if (modalDespachoMoto.gasolinaLts < gasGastado + RESERVA_GAS_MIN_LTS) {
          alert(
            `Combustible insuficiente en Moto #${modalDespachoMoto.numero} (${modalDespachoMoto.gasolinaLts}L). ` +
            `Un paseo de ${dur} min consume ${gasGastado}L y requiere al menos ${RESERVA_GAS_MIN_LTS}L de reserva de seguridad. Por favor surte el tanque antes de zarpar.`
          );
          return;
        }

        if (!despachoChecklistSeguridad) {
          alert('Confirma el Checklist de Seguridad (Cortacorriente en muñeca + Chalecos abrochados) antes de lanzar la unidad al agua.');
          return;
        }

        const chalecoAsig = '0' + (Math.floor(Math.random() * 8) + 1);
        const retornoMs = Date.now() + dur * 60 * 1000;
        const nombreLimpio = despachoNombre.trim();
        const toldoLimpio = despachoToldo.trim() || 'Muelle Directo';
        const jornadaActual = minutosVET < 780 ? 'manana' : 'tarde';
        const numMotoDespacho = modalDespachoMoto.numero;
        const puntoDespacho = modalDespachoMoto.ubicacion || 'parguito';

        // Buscamos si corresponde a un slot seleccionado o si hay un slot en la hora actual con esa moto libre
        let targetSlotId = despachoSlotId;
        let idReservaFinal = despachoIdReserva || `RES-M${numMotoDespacho}-${Date.now().toString().slice(-3)}`;

        if (!targetSlotId) {
          const slotConCliente = slots.find(s =>
            (s.reservas || []).some(r => r.cli && r.cli.toLowerCase() === nombreLimpio.toLowerCase() && !r.despachado)
          );
          if (slotConCliente) {
            targetSlotId = slotConCliente.id;
            const resEncontrada = slotConCliente.reservas.find(
              r => r.cli && r.cli.toLowerCase() === nombreLimpio.toLowerCase() && !r.despachado
            );
            if (resEncontrada) idReservaFinal = resEncontrada.idReserva;
          } else {
            const slotConMotoLibreActual = slots.find(s => {
              const ev = evaluarEstadoSlot(s);
              return !ev.esPasado && ev.motosLibres.includes(numMotoDespacho) && Math.abs(s.minDia - minutosVET) <= 25;
            });
            if (slotConMotoLibreActual) {
              targetSlotId = slotConMotoLibreActual.id;
            }
          }
        }

        let nuevosSlots;
        if (targetSlotId) {
          nuevosSlots = slots.map(s => {
            if (s.id !== targetSlotId) return s;
            const resExistentes = Array.isArray(s.reservas) ? [...s.reservas] : normalizarReservasDeSlot(s);
            const idxRes = resExistentes.findIndex(
              r => (despachoIdReserva && r.idReserva === despachoIdReserva) || r.cli.toLowerCase() === nombreLimpio.toLowerCase()
            );
            if (idxRes !== -1) {
              resExistentes[idxRes] = {
                ...resExistentes[idxRes],
                idReserva: idReservaFinal,
                motoNum: numMotoDespacho,
                cli: nombreLimpio,
                toldo: toldoLimpio,
                puntoEmbarque: resExistentes[idxRes].puntoEmbarque || puntoDespacho,
                duracionMin: dur,
                tarifaEUR: tarifa,
                despachado: true
              };
            } else {
              resExistentes.push({
                idReserva: idReservaFinal,
                motoNum: numMotoDespacho,
                cli: nombreLimpio,
                toldo: toldoLimpio,
                puntoEmbarque: puntoDespacho,
                personas: 1,
                chaleco: chalecoAsig,
                duracionMin: dur,
                tarifaEUR: tarifa,
                metodoPago: despachoMetodoPago,
                referenciaPago: 'DESPACHO-MUELLE',
                pagoVerificado: true,
                despachado: true
              });
            }
            return {
              ...s,
              jornada: jornadaActual,
              minFijo: s.minFijo !== undefined ? s.minFijo : minutosVET,
              reservas: resExistentes
            };
          });
        } else {
          targetSlotId = 'TK-' + Date.now().toString().slice(-3);
          const nuevoTurnoAgua = {
            id: targetSlotId,
            orden: slots.length + 1,
            jornada: jornadaActual,
            minFijo: minutosVET,
            reservas: [
              {
                idReserva: idReservaFinal,
                motoNum: numMotoDespacho,
                cli: nombreLimpio,
                toldo: toldoLimpio,
                puntoEmbarque: puntoDespacho,
                personas: 1,
                chaleco: chalecoAsig,
                duracionMin: dur,
                tarifaEUR: tarifa,
                metodoPago: despachoMetodoPago,
                referenciaPago: 'DESPACHO-MUELLE',
                pagoVerificado: true,
                despachado: true
              }
            ]
          };
          nuevosSlots = [...slots, nuevoTurnoAgua];
        }

        const recalculados = recalcularHorariosCadena(nuevosSlots);
        setSlots(recalculados);

        setMotos(prev => prev.map(m => m.numero === numMotoDespacho ? {
          ...m,
          estado: 'en_agua',
          gasolinaLts: Math.max(0, m.gasolinaLts - gasGastado),
          alquiler: {
            slotId: targetSlotId,
            idReserva: idReservaFinal,
            cliente: nombreLimpio,
            doc: toldoLimpio,
            puntoEmbarque: puntoDespacho,
            duracionMin: dur,
            tarifaEUR: tarifa,
            chaleco: chalecoAsig,
            horaRetornoMs: retornoMs
          }
        } : m));

        // Si ese turno no tenía ya una venta registrada por el cliente, la agregamos al libro contable
        const yaRegistrada = ventasDia.some(v => v.idReserva === idReservaFinal || (v.slotId === targetSlotId && v.cliente === nombreLimpio));
        if (!yaRegistrada) {
          const hIni = formatMinutesToHora(minutosVET);
          const hFin = formatMinutesToHora(minutosVET + dur);
          const nuevaVenta = {
            id: 'V-' + Date.now().toString().slice(-4),
            slotId: targetSlotId,
            idReserva: idReservaFinal,
            hora: hIni,
            horarioTurno: `${hIni} - ${hFin} (${dur}m)`,
            cliente: nombreLimpio,
            toldo: `${nombrePunto(puntoDespacho)} • ${toldoLimpio}`,
            puntoEmbarque: puntoDespacho,
            moto: `Yamaha #${numMotoDespacho}`,
            duracionMin: dur,
            montoEUR: tarifa,
            metodo: despachoMetodoPago,
            referencia: 'DESPACHO-MUELLE',
            captureDataUrl: null,
            verificado: true
          };
          setVentasDia(prev => [nuevaVenta, ...prev]);
        }

        setModalDespachoMoto(null);
        setDespachoNombre('');
        setDespachoToldo('');
        setDespachoSlotId('');
        setDespachoIdReserva('');
      };

      const handleConfirmarRetornoMoto = (e) => {
        e.preventDefault();
        if (!modalRetornoMoto) return;
        const nuevoH = parseFloat(inputNuevoHorometro);
        if (isNaN(nuevoH) || nuevoH < modalRetornoMoto.horometro) {
          alert(`El nuevo horómetro debe ser igual o mayor al actual (${modalRetornoMoto.horometro} hrs).`);
          return;
        }
        setMotos(prev => prev.map(m => m.numero === modalRetornoMoto.numero ? {
          ...m,
          estado: 'disponible',
          ubicacion: retornoPunto || m.ubicacion || 'parguito',
          horometro: Number(nuevoH.toFixed(1)),
          alquiler: null
        } : m));
        setModalRetornoMoto(null);
        setInputNuevoHorometro('');
      };

      const handleSurtirTanque = (numeroMoto) => {
        setMotos(prev => prev.map(m => m.numero === numeroMoto ? { ...m, gasolinaLts: 60 } : m));
      };

      // CAMBIAR UBICACIÓN DE UNA MOTO ENTRE PLAYA PARGUITO Y SUNSOL ISLA CARIBE
      const handleCambiarUbicacionMoto = (numeroMoto, nuevaUbicacion) => {
        setMotos(prev =>
          prev.map(m => (m.numero === numeroMoto ? { ...m, ubicacion: nuevaUbicacion } : m))
        );
      };

      // GESTIÓN DE MANTENIMIENTO PREVENTIVO (SERVICIO 50 HORAS, LAVADO AGUA DULCE Y TALLER)
      const handleEnviarMotoATaller = (numeroMoto, motivo = 'Revisión técnica en muelle') => {
        const entradaBitacora = {
          id: 'B-' + Date.now().toString().slice(-4),
          fecha: 'Hoy',
          hora: formatMinutesToHora(minutosVET),
          tipo: 'ENTRADA A TALLER',
          detalle: motivo,
          horometro: (motos.find(m => m.numero === numeroMoto) || {}).horometro || 0
        };
        setMotos(prev =>
          prev.map(m =>
            m.numero === numeroMoto
              ? {
                  ...m,
                  estado: 'mantenimiento',
                  motivoTaller: motivo,
                  bitacoraMantenimiento: [entradaBitacora, ...(m.bitacoraMantenimiento || [])]
                }
              : m
          )
        );
      };

      const handleRegistrarServicio50h = (numeroMoto) => {
        setMotos(prev =>
          prev.map(m => {
            if (m.numero !== numeroMoto) return m;
            const entrada = {
              id: 'B-' + Date.now().toString().slice(-4),
              fecha: 'Hoy',
              hora: formatMinutesToHora(minutosVET),
              tipo: 'SERVICIO 50H COMPLETADO',
              detalle: 'Cambio de aceite Yamaha 4W, filtro, revisión de bujías y turbina',
              horometro: m.horometro
            };
            return {
              ...m,
              estado: m.estado === 'mantenimiento' ? 'disponible' : m.estado,
              horometroUltimoServicio: m.horometro,
              bitacoraMantenimiento: [entrada, ...(m.bitacoraMantenimiento || [])]
            };
          })
        );
      };

      const handleRegistrarLavadoAguaDulce = (numeroMoto) => {
        setMotos(prev =>
          prev.map(m => {
            if (m.numero !== numeroMoto) return m;
            const entrada = {
              id: 'B-' + Date.now().toString().slice(-4),
              fecha: 'Hoy',
              hora: formatMinutesToHora(minutosVET),
              tipo: 'ENDULZADO / TURBINA',
              detalle: 'Lavado de motor y turbina con agua dulce contra salitre',
              horometro: m.horometro
            };
            return {
              ...m,
              bitacoraMantenimiento: [entrada, ...(m.bitacoraMantenimiento || [])]
            };
          })
        );
      };

      const handleCrearHorarioEspecial = (e) => {
        e.preventDefault();
        setErrorCapitania('');
        const min = parseHoraToMinutes(customHoraInput);
        if (min < 540) {
          setErrorCapitania('Antes de las 09:00 AM el muelle permanece cerrado por seguridad de salvavidas.');
          return;
        }
        if (min > 1020) {
          setErrorCapitania('Prohibido por Capitanía de Puertos e INEA: Navegación permitida solo con luz solar hasta las 05:00 PM.');
          return;
        }

        const dur = Number(customDuracionInput) || 15;
        const finMuelleNuevo = min + dur + TIEMPO_MUELLE_CAMBIO;
        const jornadaNueva = min < 780 ? 'manana' : 'tarde';
        const nombreCli = customNombreInput.trim();

        const bloqueEnEsaHora = slots.find(s => {
          const ev = evaluarEstadoSlot(s);
          return s.jornada === jornadaNueva && s.minDia < finMuelleNuevo && s.finMuelleMin > min && ev.cantLibres > 0;
        });

        if (bloqueEnEsaHora && nombreCli) {
          const evBloque = evaluarEstadoSlot(bloqueEnEsaHora);
          const motoLibre = evBloque.motosLibres[0] || '01';
          const nuevaRes = {
            idReserva: `${bloqueEnEsaHora.id}-M${motoLibre}-${Date.now().toString().slice(-3)}`,
            motoNum: motoLibre,
            cli: nombreCli,
            toldo: customToldoInput.trim() || 'Toldo Playa',
            puntoEmbarque: 'parguito',
            personas: 1,
            chaleco: '0' + (Math.floor(Math.random() * 8) + 1),
            duracionMin: dur,
            tarifaEUR: TARIFAS_MAP[dur] || 30,
            metodoPago: 'Efectivo €',
            referenciaPago: 'MUELLE',
            pagoVerificado: true,
            despachado: false
          };
          const actualizados = slots.map(s =>
            s.id === bloqueEnEsaHora.id
              ? {
                  ...s,
                  minFijo: s.minFijo !== undefined ? s.minFijo : min,
                  reservas: [...(s.reservas || []), nuevaRes]
                }
              : s
          );
          setSlots(recalcularHorariosCadena(actualizados));
        } else {
          const nuevoId = 'TK-' + Date.now().toString().slice(-3);
          const nuevo = {
            id: nuevoId,
            orden: slots.length + 1,
            jornada: jornadaNueva,
            minFijo: min,
            reservas: nombreCli
              ? [
                  {
                    idReserva: `${nuevoId}-M01`,
                    motoNum: '01',
                    cli: nombreCli,
                    toldo: customToldoInput.trim() || 'Toldo Playa',
                    puntoEmbarque: 'parguito',
                    personas: 1,
                    chaleco: '0' + (Math.floor(Math.random() * 8) + 1),
                    duracionMin: dur,
                    tarifaEUR: TARIFAS_MAP[dur] || 30,
                    metodoPago: 'Efectivo €',
                    referenciaPago: 'MUELLE',
                    pagoVerificado: true,
                    despachado: false
                  }
                ]
              : []
          };
          setSlots(prev => recalcularHorariosCadena([...prev, nuevo]));
        }

        setModalNuevoHorario(false);
        setCustomHoraInput('');
        setCustomNombreInput('');
        setCustomToldoInput('');
      };

      const handleRegistrarCobroManual = (e) => {
        e.preventDefault();
        const montoBase = (TARIFAS_MAP[calcDuracion] || 30) * calcCantidadMotos;
        const hIni = formatMinutesToHora(minutosVET);
        const hFin = formatMinutesToHora(minutosVET + calcDuracion);
        const nueva = {
          id: 'V-' + Date.now().toString().slice(-4),
          slotId: null,
          hora: hIni,
          horarioTurno: `${hIni} - ${hFin} (${calcDuracion}m)`,
          cliente: calcClienteManual.trim() || 'Cliente Directo',
          toldo: 'Muelle Directo',
          moto: `${calcCantidadMotos} Moto(s)`,
          duracionMin: calcDuracion,
          montoEUR: montoBase,
          metodo: calcMetodoManual,
          referencia: 'CAJA-MUELLE',
          captureDataUrl: null,
          verificado: true
        };
        setVentasDia(prev => [nueva, ...prev]);
        setCalcClienteManual('');
        setCalcRecibidoEUR('');
        playChimeSound();
      };

      // MÉTRICAS Y HORARIOS DISPONIBLES / OCUPADOS EN VIVO (TENIENDO EN CUENTA LAS 3 MOTOS Y SU PUNTO DE OPERACIÓN)
      const motosEnAgua = motos.filter(m => m.estado === 'en_agua');
      const motosDisponibles = motos.filter(m => m.estado === 'disponible');
      const motosEnMantenimiento = motos.filter(m => m.estado === 'mantenimiento');
      const alertasMantenimiento = motos.filter(m => {
        const srv = estadoServicioMoto(m);
        return m.estado === 'mantenimiento' || srv.nivel !== 'ok' || m.gasolinaLts <= 15;
      });

      // Lista plana de todas las reservas pendientes por abordar en cualquiera de las 3 motos
      const reservasPendientes = useMemo(() => {
        const lista = [];
        slots.forEach(s => {
          const ev = evaluarEstadoSlot(s);
          if (!ev.esPasado) {
            (s.reservas || []).forEach(r => {
              const detalleM = ev.detalleMotos.find(d => d.numero === r.motoNum);
              const estaEnAgua = detalleM && detalleM.estado === 'en_agua';
              if (!estaEnAgua && !r.despachado) {
                lista.push({
                  ...r,
                  puntoEmbarque: r.puntoEmbarque || 'parguito',
                  personas: r.personas || 1,
                  slotId: s.id,
                  slotRef: s,
                  horaInicioReal: ev.horaInicioReal,
                  horaRetornoReal: formatMinutesToHora((r.finAguaMin || s.finAguaMin) + retrasoGlobal)
                });
              }
            });
          }
        });
        return lista;
      }, [slots, motos, minutosVET, retrasoGlobal]);

      // Resumen operativo por Punto de Embarque: Playa Parguito vs Sunsol Isla Caribe
      const resumenPuntos = useMemo(() => {
        const armarResumen = (idPunto) => ({
          motos: motos.filter(m => (m.ubicacion || 'parguito') === idPunto),
          clientesCola: reservasPendientes.filter(r => (r.puntoEmbarque || 'parguito') === idPunto),
          enAgua: motosEnAgua.filter(
            m => (m.alquiler && m.alquiler.puntoEmbarque ? m.alquiler.puntoEmbarque : m.ubicacion) === idPunto
          )
        });
        return {
          parguito: armarResumen('parguito'),
          sunsol: armarResumen('sunsol')
        };
      }, [motos, reservasPendientes, motosEnAgua]);

      // Horarios con al menos 1 moto ocupada para la fecha seleccionada
      const horariosOcupadosActivos = slots.filter(s => {
        const ev = evaluarEstadoSlot(s, fechaSeleccionada);
        return !ev.esPasado && ev.cantOcupadas > 0;
      });

      // Todos los horarios que aún no han concluido y tienen al menos 1 moto libre para la duración seleccionada en la fecha activa
      const horariosDisponiblesParaAgendar = slots.filter(s => {
        const ev = evaluarEstadoSlot(s, fechaSeleccionada);
        const aptas = ev.detalleMotos.filter(d => d.disponible && d.maxMinPosibles >= calcDuracion);
        return !ev.esPasado && aptas.length > 0;
      });
      const primerHorarioDisponible =
        horariosDisponiblesParaAgendar[0] ||
        null;
      const slotParaPagoActual =
        (pagoSlotIdSeleccionado ? horariosDisponiblesParaAgendar.find(s => s.id === pagoSlotIdSeleccionado) : null) ||
        horariosDisponiblesParaAgendar[0] ||
        null;

      // Sincroniza automáticamente las motos seleccionadas (#01, #02, #03) cuando cambia el horario, duración o fecha
      useEffect(() => {
        if (!slotParaPagoActual) return;
        const ev = evaluarEstadoSlot(slotParaPagoActual, fechaSeleccionada);
        const aptas = ev.detalleMotos
          .filter(d => d.disponible && d.maxMinPosibles >= calcDuracion)
          .map(d => d.numero);
        if (aptas.length === 0) return;
        setCalcMotosSeleccionadas(prev => {
          const validas = prev.filter(n => aptas.includes(n));
          if (validas.length > 0) {
            return validas;
          }
          return [aptas[0]];
        });
      }, [slotParaPagoActual ? slotParaPagoActual.id : '', calcDuracion, slots, motos, fechaSeleccionada]);

      useEffect(() => {
        if (calcMotosSeleccionadas.length > 0 && calcMotosSeleccionadas.length !== calcCantidadMotos) {
          setCalcCantidadMotos(calcMotosSeleccionadas.length);
        }
      }, [calcMotosSeleccionadas]);

      const totalEurosDia = ventasDia.reduce((acc, v) => acc + v.montoEUR, 0);
      const totalBsDia = totalEurosDia * tasaEUR;
      const totalMinutosNavegados = ventasDia.reduce((acc, v) => acc + v.duracionMin, 0);
      const pagosPendientesVerificar = ventasDia.filter(v => !v.verificado).length;

      const miTicketActual = useMemo(() => {
        if (!miTicketClienteId) return null;
        const s = slots.find(sl => sl.id === miTicketClienteId);
        if (!s) return null;
        const res = (s.reservas || []).find(r => !miReservaClienteId || r.idReserva === miReservaClienteId) || (s.reservas || [])[0];
        if (!res && !s.cli) return null;
        return {
          ...s,
          cli: res ? res.cli : s.cli,
          toldo: res ? res.toldo : s.toldo,
          puntoEmbarque: res ? (res.puntoEmbarque || 'parguito') : 'parguito',
          personas: res ? (res.personas || 1) : 1,
          chaleco: res ? res.chaleco : s.chaleco,
          duracionMin: res ? res.duracionMin : s.duracionMin,
          tarifaEUR: res ? res.tarifaEUR : s.tarifaEUR,
          motoAsignada: res ? res.motoNum : s.motoAsignada,
          idReservaActiva: res ? res.idReserva : null
        };
      }, [slots, miTicketClienteId, miReservaClienteId]);

      const formatCountdown = (targetMs) => {
        const diffSec = Math.floor((targetMs - nowMs) / 1000);
        const isOver = diffSec < 0;
        const abs = Math.abs(diffSec);
        const m = Math.floor(abs / 60);
        const s = abs % 60;
        const txt = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        return { txt: isOver ? `+${txt}` : txt, urgent: diffSec <= 300, diffSec };
      };

      const montoCalculadoraEUR = (TARIFAS_MAP[calcDuracion] || 30) * calcCantidadMotos;
      const montoCalculadoraBs = montoCalculadoraEUR * tasaEUR;
      const vueltoEUR = parseFloat(calcRecibidoEUR) > montoCalculadoraEUR ? (parseFloat(calcRecibidoEUR) - montoCalculadoraEUR) : 0;

      // Función para ocultar apellidos de otros clientes en la vista pública
      const anonimizarNombre = (nombreCompleto) => {
        if (!nombreCompleto) return 'Cliente';
        const partes = nombreCompleto.trim().split(' ');
        if (partes.length === 1) return partes[0];
        return `${partes[0]} ${partes[1][0]}.`;
      };

      return (
        <div className="min-h-screen bg-[#0D1B2A] py-0 sm:py-6 px-0 sm:px-4">
          <div className="max-w-[1220px] mx-auto bg-white shadow-2xl overflow-hidden">

            {/* =============================================================== */}
            {/* BARRA SUPERIOR DE CAMBIO DE ROL: VISTA CLIENTE vs OPERADOR      */}
            {/* =============================================================== */}
            <div className="bg-[#07111C] text-white px-4 sm:px-10 py-2.5 flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-white/10">
              <div className="flex items-center gap-3 text-xs">
                <span className="flex items-center gap-1.5 font-mono font-bold text-white">
                  <Icons.Clock className="w-3.5 h-3.5 text-[#E5097F]" />
                  <span>HORA VENEZUELA: {horaVET}</span>
                </span>
                <span className="text-white/25">|</span>
                <span className="font-mono font-bold text-[#8FD6F2]">
                  EURO BCV: Bs. {tasaEUR.toFixed(2)}
                </span>
              </div>

              <div className="flex items-center gap-2">
                <span className="text-[10px] font-mono uppercase text-slate-400 hidden md:inline">
                  Cambiar Pantalla:
                </span>
                <button
                  type="button"
                  onClick={() => setModoVista('cliente')}
                  className={`px-4 py-1.5 rounded-full text-xs font-condensed uppercase tracking-wider font-bold transition-all cursor-pointer flex items-center gap-1.5 ${
                    modoVista === 'cliente'
                      ? 'bg-[#E5097F] text-white shadow-lg ring-2 ring-white/30'
                      : 'bg-white/10 text-slate-300 hover:bg-white/20'
                  }`}
                >
                  <Icons.Smartphone className="w-3.5 h-3.5" />
                  <span>Vista Cliente (Web / QR Toldo)</span>
                </button>

                <button
                  type="button"
                  onClick={() => setModoVista('operador')}
                  className={`px-4 py-1.5 rounded-full text-xs font-condensed uppercase tracking-wider font-bold transition-all cursor-pointer flex items-center gap-1.5 ${
                    modoVista === 'operador'
                      ? 'bg-[#8FD6F2] text-[#0D1B2A] shadow-lg ring-2 ring-white/30'
                      : 'bg-white/10 text-slate-300 hover:bg-white/20'
                  }`}
                >
                  <Icons.Shield className="w-3.5 h-3.5" />
                  <span>Panel Operador (Control Muelle)</span>
                </button>
              </div>
            </div>

            {/* =============================================================== */}
            {/* VISTA 1: PÁGINA WEB COMPLETA DEL CLIENTE (COLORES DIVINA)       */}
            {/* Fucsia #E5097F • Azul Océano #1DA1DB • Amarillo Sol #8FD6F2     */}
            {/* =============================================================== */}
            {modoVista === 'cliente' ? (
              <>
                {/* ----------------------------------------------------------- */}
                {/* 1. HERO DEL CLIENTE CON CORTE DIAGONAL FUCSIA Y AZUL OCÉANO */}
                {/* ----------------------------------------------------------- */}
                <section className="relative bg-[#0D1B2A] text-white overflow-hidden">
                  <div
                    className="absolute inset-0 bg-cover bg-center opacity-45"
                    style={{ backgroundImage: "url('https://images.unsplash.com/photo-1505118380757-91f5f5632de0?auto=format&fit=crop&w=1600&q=80')" }}
                  ></div>
                  <div className="absolute inset-0 bg-gradient-to-b from-[#0D1B2A]/80 via-[#1DA1DB]/35 to-[#0D1B2A]/90"></div>
                  <div className="hidden md:block absolute inset-0 bg-[#E5097F] hero-red-wedge pointer-events-none"></div>

                  {/* NAVEGACIÓN DEL CLIENTE CON LOGO OFICIAL DIVINA ACUÁTICA */}
                  <header className="relative z-20 px-6 sm:px-12 pt-5 pb-4 flex flex-col lg:flex-row items-center justify-between gap-4 border-b border-white/15">
                    <div className="flex flex-col items-center lg:items-start">
                      <Icons.LogoDivinaAcuatica className="h-11 sm:h-12 w-auto drop-shadow-lg" />
                      <span className="text-[9px] tracking-[0.26em] uppercase text-[#8FD6F2] block mt-1.5 font-semibold">
                        PLAYA PARGUITO • MUELLE SUNSOL ISLA CARIBE
                      </span>
                    </div>

                    <nav className="flex flex-wrap items-center justify-center gap-4 sm:gap-7 text-xs font-condensed font-bold uppercase tracking-widest">
                      <a href="#cli-motos" className="text-white hover:text-[#8FD6F2] transition-colors">NUESTRAS MOTOS</a>
                      <a href="#cli-cola" className="text-white hover:text-[#8FD6F2] transition-colors">TURNOS EN VIVO</a>
                      <a href="#cli-horarios" className="text-white hover:text-[#8FD6F2] transition-colors">RESERVAR HORARIO</a>
                      <a href="#cli-precios" className="text-white hover:text-[#8FD6F2] transition-colors">PRECIOS & PAGO MÓVIL</a>
                      <a href="#cli-waiver" className="text-white hover:text-[#8FD6F2] transition-colors">FIRMAR CONTRATO</a>
                    </nav>

                    <a
                      href="#cli-horarios"
                      className="px-4 py-1.5 rounded-full bg-[#8FD6F2] text-[#0D1B2A] font-condensed text-xs font-bold uppercase tracking-widest shadow"
                    >
                      APARTAR TURNO AHORA
                    </a>
                  </header>

                  <div className="relative z-20 pt-8 pb-24 sm:pb-32 px-6 text-center">
                    <div className="inline-flex flex-wrap items-center justify-center gap-3 bg-[#0D1B2A]/80 backdrop-blur-md px-5 py-2 rounded-full border border-[#8FD6F2]/30 text-xs mb-5">
                      <span className="font-bold text-[#8FD6F2]">
                        {motosDisponibles.length > 0
                          ? `${motosDisponibles.length} Moto(s) Lista(s) en Muelle`
                          : 'Motos Navegando Ahora Mismo'}
                      </span>
                      <span className="text-white/30">|</span>
                      <span className="font-mono font-bold text-[#8FD6F2]">
                        15m: 30€ • 20m: 40€ • 30m: 60€ • 40m: 80€
                      </span>
                    </div>

                    <h1 className="font-script text-3xl sm:text-5xl md:text-6xl text-white drop-shadow-lg max-w-3xl mx-auto leading-tight">
                      Vive la adrenalina en Playa Parguito sin hacer fila bajo el sol!
                    </h1>

                    <div className="max-w-xl mx-auto mt-4 sm:mt-6 relative z-30">
                      <Icons.JetSkiSide className="w-full h-auto drop-shadow-2xl" />
                    </div>
                  </div>

                  <div className="absolute bottom-0 inset-x-0 h-24 sm:h-36 bg-white hero-bottom-cut z-10 pointer-events-none"></div>
                </section>

                {/* ----------------------------------------------------------- */}
                {/* SI EL CLIENTE YA TIENE UN TICKET RESERVADO, MOSTRAR ARRIBA  */}
                {/* ----------------------------------------------------------- */}
                {miTicketActual && (
                  <div className="px-6 sm:px-14 pt-2 pb-6 bg-white">
                    <div className="bg-[#0D1B2A] text-white p-6 border-l-8 border-[#E5097F] flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl">
                      <div className="space-y-1">
                        <span className="text-[10px] font-mono uppercase text-[#8FD6F2] font-bold block">
                          TU TICKET DIGITAL ACTIVO EN ESTE TELÉFONO • AUTO-ALARMA 5 MIN ANTES
                        </span>
                        <h3 className="font-condensed text-2xl font-bold uppercase">
                          PILOTO: {miTicketActual.cli} • MOTO #{miTicketActual.motoAsignada || '01'} • PASEO DE {miTicketActual.duracionMin} MIN ({miTicketActual.tarifaEUR}€ / Bs. {(miTicketActual.tarifaEUR * tasaEUR).toFixed(2)})
                        </h3>
                        <p className="text-xs text-slate-300">
                          Punto de Embarque: <strong className="text-[#8FD6F2] uppercase">{PUNTOS_OPERACION[miTicketActual.puntoEmbarque] ? PUNTOS_OPERACION[miTicketActual.puntoEmbarque].nombre : 'Playa Parguito'}</strong> • Ubicación: {miTicketActual.toldo} • Chaleco asignado: <strong>#{miTicketActual.chaleco}</strong> • Retorno estimado: <strong>{evaluarEstadoSlot(miTicketActual).horaRetornoReal}</strong>
                        </p>
                        {retrasoGlobal > 0 && (
                          <p className="text-xs text-[#8FD6F2] font-bold pt-1">
                            Aviso del Muelle (+{retrasoGlobal} min por {motivoRetraso}): Tu hora de salida ya se actualizó sola.
                          </p>
                        )}
                      </div>

                      <div className="flex flex-wrap items-center gap-3">
                        <div className="text-left md:text-right mr-2">
                          <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">Tu Hora de Zarpe</span>
                          <strong className="font-condensed text-4xl font-bold text-[#8FD6F2]">
                            {evaluarEstadoSlot(miTicketActual).horaInicioReal}
                          </strong>
                        </div>
                        <button
                          type="button"
                          onClick={() => {
                            playChimeSound();
                            alert('¡Alarma verificada! Tu teléfono sonará 5 minutos antes de tu turno para que camines hacia la orilla.');
                          }}
                          className="px-4 py-2.5 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-xs font-bold uppercase tracking-wider cursor-pointer"
                        >
                          PROBAR MI ALARMA
                        </button>
                        <button
                          type="button"
                          onClick={() => handleEliminarCitaSlot(miTicketActual.id, miTicketActual.idReservaActiva)}
                          className="px-4 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-condensed text-xs font-bold uppercase cursor-pointer"
                        >
                          CANCELAR MI TURNO
                        </button>
                      </div>
                    </div>
                  </div>
                )}

                {/* ----------------------------------------------------------- */}
                {/* 2. LAS 3 MOTOS YAMAHA EN VIVO PARA EL CLIENTE               */}
                {/* ----------------------------------------------------------- */}
                <section id="cli-motos" className="bg-white px-6 sm:px-14 pt-4 pb-16">
                  <div className="text-center mb-10">
                    <h2 className="font-condensed text-3xl sm:text-4xl font-bold uppercase text-[#0D1B2A]">
                      NUESTRA FLOTA <span className="text-[#E5097F]">YAMAHA WAVERUNNER</span> EN <span className="text-[#1DA1DB]">VIVO</span>
                    </h2>
                    <p className="text-xs text-slate-500 mt-1 max-w-xl mx-auto">
                      Mira en tiempo real cuáles unidades están listas en la orilla y cuántos minutos le faltan a la moto que está navegando en el mar.
                    </p>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {motos.map((moto) => {
                      const enAgua = moto.estado === 'en_agua' && moto.alquiler;
                      const disponible = moto.estado === 'disponible';
                      const timer = enAgua ? formatCountdown(moto.alquiler.horaRetornoMs) : null;

                      return (
                        <div key={moto.id} className="group flex flex-col justify-between">
                          <div>
                            <div className="relative h-56 w-full bg-[#0D1B2A] overflow-hidden shadow-md">
                              <img
                                src={moto.imagen}
                                alt={moto.nombre}
                                className="w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-500"
                              />
                              <div className="absolute inset-0 bg-gradient-to-t from-[#0D1B2A]/80 via-transparent to-[#0D1B2A]/30"></div>

                              <div className="absolute top-3 right-3">
                                <span className={`px-3 py-1 text-[10px] font-condensed uppercase tracking-widest font-bold ${
                                  enAgua
                                    ? 'bg-[#E5097F] text-white animate-pulse'
                                    : disponible
                                    ? 'bg-[#1DA1DB] text-white'
                                    : 'bg-slate-700 text-slate-200'
                                }`}>
                                  {enAgua ? 'EN EL AGUA AHORA' : disponible ? 'LISTA EN ORILLA' : 'EN REVISIÓN'}
                                </span>
                              </div>

                              <div className="absolute top-3 left-3 flex flex-col gap-1">
                                <span className="font-condensed font-bold text-xs bg-[#0D1B2A]/85 text-[#8FD6F2] px-2.5 py-1 border border-white/20">
                                  UNIDAD #{moto.numero}
                                </span>
                                <span className="font-mono text-[9px] font-bold uppercase bg-[#1DA1DB]/90 text-white px-2 py-0.5">
                                  {moto.ubicacion === 'sunsol' ? 'BASE: SUNSOL ISLA CARIBE' : 'BASE: PLAYA PARGUITO'}
                                </span>
                              </div>

                              {/* TRIÁNGULO FUCSIA / AZUL EN ESQUINA INFERIOR IZQUIERDA */}
                              <div className={`absolute bottom-0 left-0 w-44 h-32 corner-ribbon-red flex flex-col justify-end p-3.5 text-white ${
                                enAgua ? 'bg-[#E5097F]' : 'bg-[#1DA1DB]'
                              }`}>
                                {enAgua ? (
                                  <>
                                    <span className="font-mono font-black text-2xl leading-none">
                                      {timer.txt}
                                    </span>
                                    <span className="text-[9px] font-condensed uppercase tracking-widest opacity-90 mt-0.5">
                                      VUELVE EN MINUTOS
                                    </span>
                                  </>
                                ) : (
                                  <>
                                    <span className="font-condensed font-bold text-3xl leading-none">
                                      30€
                                    </span>
                                    <span className="text-[9px] font-condensed uppercase tracking-widest opacity-90 mt-0.5">
                                      PASEO 15 MIN
                                    </span>
                                  </>
                                )}
                              </div>
                            </div>

                            <div className="pt-5 space-y-2.5">
                              <div>
                                <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">
                                  {moto.nombre}
                                </h3>
                                <p className="text-[11px] font-bold text-[#E5097F] uppercase tracking-wider">
                                  {moto.subtitulo} • {moto.capacidad}
                                </p>
                              </div>

                              <p className="text-xs text-slate-500 leading-relaxed">
                                {moto.descripcionCliente}
                              </p>

                              <div className="pt-2 border-t border-slate-100 flex items-center justify-between text-xs font-mono">
                                <span className="text-slate-500">15m: <strong className="text-[#0D1B2A]">30€</strong> • 20m: <strong className="text-[#0D1B2A]">40€</strong></span>
                                <span className="text-slate-500">30m: <strong className="text-[#0D1B2A]">60€</strong> • 40m: <strong className="text-[#0D1B2A]">80€</strong></span>
                              </div>
                            </div>
                          </div>

                          <div className="pt-5">
                            <a
                              href="#cli-horarios"
                              onClick={() => setReservaMotoNum(moto.numero)}
                              className="inline-block px-6 py-2.5 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed font-bold text-xs uppercase tracking-widest shadow transition-all"
                            >
                              RESERVAR ESTA UNIDAD
                            </a>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </section>

                {/* ----------------------------------------------------------- */}
                {/* 3. SECCIÓN FUCSIA & BLANCA CON MOTO CENITAL PARA EL CLIENTE */}
                {/* ----------------------------------------------------------- */}
                <section id="cli-cola" className="relative grid grid-cols-1 lg:grid-cols-12 bg-white border-t border-b border-slate-200">

                  <div className="lg:col-span-6 bg-[#E5097F] text-white px-6 sm:px-14 py-12 flex flex-col justify-between space-y-6">
                    <div className="space-y-2 lg:pr-12">
                      <h2 className="font-condensed text-3xl sm:text-4xl font-bold uppercase tracking-wide">
                        ¿CÓMO FUNCIONA TU RESERVA EN PLAYA PARGUITO?
                      </h2>
                      <p className="text-xs text-white/90 leading-relaxed">
                        Olvídate de esperar de pie bajo el sol. Aparta tu hora exacta desde la comodidad de tu toldo o churuata.
                      </p>
                    </div>

                    <div className="space-y-4 lg:pr-14">
                      <div className="border-b border-white/25 pb-3">
                        <h4 className="font-condensed text-lg font-bold uppercase text-[#8FD6F2]">
                          1. Elige 15, 20, 30 o 40 Minutos de Paseo
                        </h4>
                        <p className="text-xs text-white/90 mt-0.5">
                          Tarifas oficiales para 1 o 2 personas por moto: <strong>15 min (30€)</strong>, <strong>20 min (40€)</strong>, <strong>30 min (60€)</strong> y <strong>40 min (80€)</strong>.
                        </p>
                      </div>

                      <div className="border-b border-white/25 pb-3">
                        <h4 className="font-condensed text-lg font-bold uppercase text-[#8FD6F2]">
                          2. Tu Teléfono te Avisa 5 Minutos Antes
                        </h4>
                        <p className="text-xs text-white/90 mt-0.5">
                          Al apartar tu horario recibes tu Ticket Digital con auto-alarma sonora para que bajes a la orilla justo cuando te toca abordar.
                        </p>
                      </div>

                      <div>
                        <h4 className="font-condensed text-lg font-bold uppercase text-[#8FD6F2]">
                          3. Adelanta tu Firma Digital desde el Toldo
                        </h4>
                        <p className="text-xs text-white/90 mt-0.5">
                          Firma el contrato de alquiler más abajo desde tu celular para llegar directo a ponerte el chaleco salvavidas.
                        </p>
                      </div>
                    </div>
                  </div>

                  {/* MOTO DE AGUA CENITAL CENTRAL */}
                  <div className="hidden lg:flex absolute inset-y-0 left-1/2 -translate-x-1/2 z-20 items-center justify-center pointer-events-none">
                    <Icons.JetSkiTopDown className="w-36 h-auto drop-shadow-2xl" />
                  </div>

                  {/* DERECHA BLANCA: COLA DE TURNOS EN VIVO (TRANSPARENCIA TOTAL POR UNIDAD #01, #02, #03) */}
                  <div className="lg:col-span-6 bg-white px-6 sm:px-14 py-12 flex flex-col justify-between space-y-6">
                    <div className="lg:pl-12">
                      <h3 className="font-condensed text-2xl sm:text-3xl font-bold uppercase text-[#0D1B2A]">
                        ORDEN DE <span className="text-[#1DA1DB]">SALIDAS EN VIVO (3 MOTOS)</span>
                      </h3>
                      <p className="text-xs text-slate-500">
                        Contamos con 3 motos Yamaha (#01, #02 y #03). Si 1 moto está en el agua o reservada, las otras 2 siguen disponibles en ese mismo horario.
                      </p>
                    </div>

                    <div className="lg:pl-12 space-y-5">
                      {(() => {
                        const turnosActivosYCola = slots.filter(s => {
                          const ev = evaluarEstadoSlot(s);
                          return !ev.esPasado && ev.cantOcupadas > 0;
                        });
                        if (turnosActivosYCola.length === 0) {
                          return (
                            <div className="p-6 border border-dashed border-[#1DA1DB] bg-[#8FD6F2]/15 text-center text-xs text-[#0D1B2A] font-bold">
                              ¡Las 3 motos están libres en este momento! Puedes bajar o apartar el próximo horario de inmediato.
                            </div>
                          );
                        }
                        return turnosActivosYCola.slice(0, 3).map((turno, idx) => {
                          const ev = evaluarEstadoSlot(turno);
                          const esMio = miTicketClienteId === turno.id;
                          return (
                            <div key={turno.id} className="flex items-center gap-4 pb-4 border-b border-slate-100 last:border-b-0">
                              <div className={`w-16 h-16 rounded-full text-white border-4 flex flex-col items-center justify-center shrink-0 shadow ${
                                ev.esEnAgua ? 'bg-[#E5097F] border-[#8FD6F2]' : esMio ? 'bg-[#E5097F] border-[#8FD6F2]' : 'bg-[#0D1B2A] border-[#8FD6F2]'
                              }`}>
                                <span className="font-condensed text-[9px] uppercase text-[#8FD6F2] font-bold leading-none">
                                  {ev.cantOcupadas}/3 OCUP.
                                </span>
                                <strong className="font-mono text-xs font-extrabold mt-0.5">
                                  {ev.horaInicioReal.replace(' AM', '').replace(' PM', '')}
                                </strong>
                              </div>

                              <div className="flex-1 min-w-0 space-y-1">
                                <div className="flex items-center gap-2 flex-wrap">
                                  <h4 className="font-condensed text-base font-bold uppercase text-[#0D1B2A] truncate">
                                    {ev.motosOcupadas
                                      .map(m =>
                                        `Moto #${m.numero}: ${
                                          esMio && m.reserva && m.reserva.idReserva === miReservaClienteId
                                            ? `${m.reserva.cli} (TÚ)`
                                            : anonimizarNombre(m.reserva ? m.reserva.cli : turno.cli)
                                        } (${m.reserva ? m.reserva.duracionMin : turno.duracionMin}m • Libre ${m.horaSeDesocupa || ''})`
                                      )
                                      .join(' • ')}
                                  </h4>
                                </div>
                                <p className="text-xs text-slate-500">
                                  Horario: <strong>{ev.horaInicioReal}</strong> •{' '}
                                  {ev.cantLibres > 0 ? (
                                    <strong className="text-[#1DA1DB]">
                                      Quedan {ev.cantLibres} de 3 motos LIBRES ({ev.motosLibres.map(n => {
                                        const ml = ev.detalleMotos.find(d => d.numero === n);
                                        return `#${n}${ml && ml.horaLibreDesde ? ` (desde ${ml.horaLibreDesde})` : ''}`;
                                      }).join(', ')})
                                    </strong>
                                  ) : (
                                    <strong className="text-[#E5097F]">
                                      3/3 Motos Ocupadas • Próxima libre: {ev.horaLibreReal}
                                    </strong>
                                  )}
                                </p>
                              </div>
                            </div>
                          );
                        });
                      })()}
                    </div>
                  </div>
                </section>

                {/* ----------------------------------------------------------- */}
                {/* 4. HORARIOS DISPONIBLES PARA QUE EL CLIENTE RESERVE         */}
                {/*    (Muestra disponibilidad simultánea de las 3 motos)       */}
                {/* ----------------------------------------------------------- */}
                <section id="cli-horarios" className="bg-[#F2F6FA] px-6 sm:px-14 py-14 space-y-8">
                  <div className="flex flex-col md:flex-row items-center justify-between gap-4">
                    <div>
                      <h2 className="font-condensed text-3xl sm:text-4xl font-bold uppercase text-[#0D1B2A]">
                        ELIGE TU HORARIO DE <span className="text-[#E5097F]">SALIDA AL AGUA (3 MOTOS POR TURNO)</span>
                      </h2>
                      <p className="text-xs text-slate-500 mt-1">
                        Cada horario cuenta con <strong>3 Motos Yamaha (#01, #02 y #03)</strong>. Si 1 o 2 motos están alquiladas en una hora, aún puedes reservar las motos libres restantes en ese mismo horario.
                      </p>
                    </div>

                    <div className="flex items-center bg-white p-1 rounded-full border border-slate-200">
                      {[
                        { id: 'manana', label: 'MAÑANA (09:00-13:00)' },
                        { id: 'tarde', label: 'TARDE (13:00-17:00)' },
                        { id: 'todos', label: 'VER TODOS' }
                      ].map(tab => (
                        <button
                          key={tab.id}
                          type="button"
                          onClick={() => setFiltroJornada(tab.id)}
                          className={`px-4 py-1.5 rounded-full font-condensed text-xs font-bold uppercase tracking-wider cursor-pointer transition-all ${
                            filtroJornada === tab.id
                              ? 'bg-[#E5097F] text-white shadow'
                              : 'text-slate-600 hover:text-black'
                          }`}
                        >
                          {tab.label}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* SELECTOR DE DÍA Y JORNADA SEMANAL (HOY, MAÑANA, VIERNES A DOMINGO) */}
                  <div className="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="w-2.5 h-2.5 rounded-full bg-[#1DA1DB] animate-pulse"></span>
                          <span className="font-condensed text-xs font-bold uppercase tracking-wider text-[#0D1B2A]">
                            PROGRAMACIÓN DE SALIDAS (HOY, MAÑANA Y FIN DE SEMANA)
                          </span>
                        </div>
                        <p className="text-xs text-slate-500 mt-0.5">
                          Operación activa de <strong>Viernes a Domingo</strong> en Playa Parguito y Sunsol Isla Caribe. Puedes ver y apartar turnos para cualquier día.
                        </p>
                      </div>

                      {/* Botones de Días Clave */}
                      <div className="flex items-center gap-1.5 flex-wrap">
                        {[
                          diasOperativos.hoy,
                          diasOperativos.manana,
                          diasOperativos.viernes,
                          diasOperativos.sabado,
                          diasOperativos.domingo
                        ].map(d => {
                          const activo = fechaSeleccionada === d.fecha;
                          const stats = obtenerEstadisticasFecha(d.fecha);
                          return (
                            <button
                              key={d.id}
                              type="button"
                              onClick={() => {
                                setFechaSeleccionada(d.fecha);
                                setPagoFecha(d.fecha);
                                setPagoSlotIdSeleccionado('');
                              }}
                              className={`px-3 py-1.5 rounded-xl text-left font-condensed transition-all cursor-pointer border ${
                                activo
                                  ? 'bg-[#0D1B2A] text-white border-[#0D1B2A] shadow-md ring-2 ring-[#E5097F]'
                                  : 'bg-[#F8FAFC] text-slate-700 border-slate-200 hover:border-[#1DA1DB] hover:bg-white'
                              }`}
                            >
                              <div className="flex items-center gap-1.5">
                                <span className="font-bold text-xs uppercase">{d.etiqueta}</span>
                                {stats.totalReservas > 0 && (
                                  <span className={`px-1.5 py-0.2 rounded-full text-[9px] font-mono font-bold ${
                                    activo ? 'bg-[#E5097F] text-white' : 'bg-[#E0F2FE] text-[#0284C7]'
                                  }`}>
                                    {stats.totalReservas} {stats.totalReservas === 1 ? 'cita' : 'citas'}
                                  </span>
                                )}
                              </div>
                              <div className={`text-[10px] font-mono ${activo ? 'text-[#7DD3FC]' : 'text-slate-400'}`}>
                                {d.corta}
                              </div>
                            </button>
                          );
                        })}

                        {/* Date Picker Input */}
                        <div className="flex items-center gap-1.5 bg-[#F8FAFC] px-3 py-1.5 rounded-xl border border-slate-200">
                          <span className="text-[10px] font-mono font-bold text-slate-500 uppercase">Otro:</span>
                          <input
                            type="date"
                            value={fechaSeleccionada}
                            onChange={(e) => {
                              if (e.target.value) {
                                setFechaSeleccionada(e.target.value);
                                setPagoFecha(e.target.value);
                                setPagoSlotIdSeleccionado('');
                              }
                            }}
                            className="text-xs font-mono font-bold text-[#0D1B2A] bg-transparent outline-none cursor-pointer"
                          />
                        </div>
                      </div>
                    </div>

                    {/* Resumen del Día Seleccionado */}
                    <div className="pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-600 gap-2">
                      <div className="flex items-center gap-2 flex-wrap">
                        <span>Viendo disponibilidad para:</span>
                        <strong className="text-[#0D1B2A] font-bold text-sm">{formatFechaBonita(fechaSeleccionada)}</strong>
                        {fechaSeleccionada === diasOperativos.hoy.fecha ? (
                          <span className="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">HOY (En Vivo)</span>
                        ) : fechaSeleccionada === diasOperativos.manana.fecha ? (
                          <span className="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">MAÑANA</span>
                        ) : [diasOperativos.viernes.fecha, diasOperativos.sabado.fecha, diasOperativos.domingo.fecha].includes(fechaSeleccionada) ? (
                          <span className="px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold">FIN DE SEMANA OPERATIVO</span>
                        ) : (
                          <span className="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold">FECHA PROGRAMADA</span>
                        )}
                      </div>
                      <div className="font-mono text-[11px] text-slate-500">
                        Capacidad: <strong className="text-[#0284C7]">{obtenerEstadisticasFecha(fechaSeleccionada).slotsConDisponibilidad}</strong> horarios libres con motos disponibles
                      </div>
                    </div>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    {slots
                      .filter(s => filtroJornada === 'todos' || s.jornada === filtroJornada)
                      .map((slot) => {
                        const ev = evaluarEstadoSlot(slot);
                        const esMio = miTicketClienteId === slot.id;

                        return (
                          <div
                            key={slot.id}
                            className={`bg-white shadow-sm border transition-all flex flex-col justify-between ${
                              esMio
                                ? 'border-[#E5097F] ring-2 ring-[#E5097F]/25'
                                : ev.esDisponible
                                ? 'border-slate-200 hover:border-[#1DA1DB]'
                                : 'border-slate-200 opacity-75'
                            }`}
                          >
                            <div>
                              <div className="relative h-24 bg-[#0D1B2A] text-white px-4 pt-3 flex justify-between items-start overflow-hidden">
                                <div className={`absolute bottom-0 left-0 w-36 h-20 corner-ribbon-red flex flex-col justify-end p-2.5 text-white ${
                                  ev.todasOcupadas
                                    ? 'bg-[#E5097F]'
                                    : ev.parcialmenteOcupado
                                    ? 'bg-[#1DA1DB]'
                                    : ev.esDisponible
                                    ? 'bg-[#1DA1DB]'
                                    : 'bg-slate-600'
                                }`}>
                                  <strong className="font-condensed text-base font-bold leading-none">
                                    {ev.horaInicioReal}
                                  </strong>
                                  <span className="text-[9px] font-mono uppercase opacity-90">
                                    {ev.esDisponible ? `${ev.cantLibres} DE ${ev.motosOperativasTotal} LIBRES` : `${ev.motosOperativasTotal}/${ev.motosOperativasTotal} OCUPADAS`}
                                  </span>
                                </div>

                                <div className="ml-auto text-right z-10 flex flex-col items-end gap-1">
                                  <span className={`text-[10px] font-condensed font-bold uppercase tracking-widest px-2 py-0.5 ${
                                    ev.esPasado
                                      ? 'bg-white/15 text-slate-300'
                                      : ev.todasOcupadas
                                      ? 'bg-[#E5097F] text-white'
                                      : ev.parcialmenteOcupado
                                      ? 'bg-[#8FD6F2] text-[#0D1B2A]'
                                      : 'bg-[#8FD6F2] text-[#0D1B2A]'
                                  }`}>
                                    {ev.esPasado
                                      ? 'CONCLUIDO'
                                      : ev.todasOcupadas
                                      ? `AGOTADO • ${ev.motosOperativasTotal}/${ev.motosOperativasTotal} OCUPADAS`
                                      : `${ev.cantLibres}/${ev.motosOperativasTotal} MOTOS LIBRES`}
                                  </span>
                                  {esMio && (
                                    <span className="text-[9px] font-condensed font-bold uppercase px-1.5 py-0.5 bg-[#E5097F] text-white">
                                      TIENES RESERVA AQUÍ
                                    </span>
                                  )}
                                </div>
                              </div>

                              <div className="p-4 text-xs space-y-2.5">
                                {/* ESTADO INDIVIDUAL DE LAS 3 MOTOS (#01, #02 y #03) EN ESTE HORARIO */}
                                <div className="grid grid-cols-3 gap-1.5">
                                  {ev.detalleMotos.map(dm => (
                                    <div
                                      key={dm.numero}
                                      className={`p-1.5 text-center border font-mono ${
                                        dm.disponible && !ev.esPasado
                                          ? 'bg-[#8FD6F2]/20 border-[#1DA1DB] text-[#0D1B2A]'
                                          : dm.estado === 'en_agua'
                                          ? 'bg-[#E5097F]/15 border-[#E5097F] text-[#E5097F]'
                                          : 'bg-slate-100 border-slate-300 text-slate-500'
                                      }`}
                                    >
                                      <strong className="block text-[10px] font-bold">MOTO #{dm.numero}</strong>
                                      <span className="block text-[8px] font-condensed uppercase font-bold leading-tight">
                                        {ev.esPasado
                                          ? 'CERRADO'
                                          : dm.disponible
                                          ? `LIBRE (${dm.minutosLibreAntes < 180 && dm.minutosLibreAntes > 0 ? `hace ${dm.minutosLibreAntes}m` : 'AHORA'})`
                                          : dm.estado === 'en_agua'
                                          ? `AGUA (${dm.reserva ? dm.reserva.duracionMin : 15}M)`
                                          : dm.estado === 'taller'
                                          ? 'EN TALLER'
                                          : `OCUP. -> ${dm.horaSeDesocupa || ''}`}
                                      </span>
                                    </div>
                                  ))}
                                </div>

                                {ev.esPasado ? (
                                  <p className="text-slate-400 py-1">Horario ya transcurrido hoy.</p>
                                ) : ev.todasOcupadas ? (
                                  <div className="space-y-1 text-slate-600">
                                    <p className="font-semibold text-[#E5097F]">
                                      Las 3 motos están ocupadas en este horario:
                                    </p>
                                    {ev.motosOcupadas.map(mo => (
                                      <p key={mo.numero} className="font-mono text-[10px] text-slate-700">
                                        • Moto #{mo.numero}: {mo.textoOcupada || `Se desocupa a las ${mo.horaSeDesocupa || ''}`}
                                      </p>
                                    ))}
                                    <p className="font-mono text-[11px] pt-0.5">
                                      Primera libre a las: <strong className="text-[#0D1B2A]">{ev.horaLibreReal}</strong>
                                    </p>
                                  </div>
                                ) : ev.parcialmenteOcupado ? (
                                  <div className="space-y-1 text-slate-600">
                                    <p className="text-[11px] font-semibold text-[#0D1B2A]">
                                      {ev.cantLibres} {ev.cantLibres === 1 ? 'Moto Libre' : 'Motos Libres'} ({ev.motosLibres.map(n => `#${n}`).join(', ')})
                                    </p>
                                    {ev.motosOcupadas.map(mo => (
                                      <p key={mo.numero} className="text-[10px] text-slate-500 font-mono">
                                        • Moto #{mo.numero}: {mo.textoOcupada || `Ocupada • Se desocupa a las ${mo.horaSeDesocupa || ''}`}
                                      </p>
                                    ))}
                                    {ev.motosLibres.map(mlNum => {
                                      const ml = ev.detalleMotos.find(d => d.numero === mlNum);
                                      return ml && ml.minutosLibreAntes < 180 ? (
                                        <p key={mlNum} className="text-[10px] text-[#0284C7] font-mono font-bold">
                                          • Moto #{mlNum}: {ml.textoLibre}
                                        </p>
                                      ) : null;
                                    })}
                                  </div>
                                ) : (
                                  <div className="space-y-1 text-slate-600">
                                    <p>
                                      Las <strong>3 motos (#01, #02 y #03)</strong> están libres a las <strong>{ev.horaInicioReal}</strong>.
                                    </p>
                                    {ev.detalleMotos.map(dm => dm.minutosLibreAntes < 180 ? (
                                      <p key={dm.numero} className="text-[10px] text-[#0284C7] font-mono">
                                        • Moto #{dm.numero}: {dm.textoLibre}
                                      </p>
                                    ) : null)}
                                  </div>
                                )}
                              </div>
                            </div>

                            <div className="px-4 pb-4 pt-2 border-t border-slate-100 space-y-1.5">
                              {ev.esDisponible ? (
                                <button
                                  type="button"
                                  onClick={() => {
                                    const inicial = ev.motosLibres[0] || '01';
                                    setModalReservarSlot(slot);
                                    setReservaMotoNum(inicial);
                                    setReservaMotosSeleccionadas([inicial]);
                                    setReservaCantidadMotos(1);
                                    setReservaDuracion(15);
                                  }}
                                  className="w-full py-2.5 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer shadow"
                                >
                                  {ev.parcialmenteOcupado
                                    ? `APARTAR MOTO LIBRE (${ev.motosLibres.map(n => `#${n}`).join(' / ')})`
                                    : 'SOLICITAR ESTE HORARIO (3 LIBRES)'}
                                </button>
                              ) : (
                                <span className="block text-center text-[11px] font-condensed uppercase text-slate-400 py-1">
                                  {ev.esPasado ? 'HORARIO CONCLUIDO' : 'AGOTADO (3/3 MOTOS OCUPADAS)'}
                                </span>
                              )}

                              {esMio && (
                                <button
                                  type="button"
                                  onClick={() => handleEliminarCitaSlot(slot.id, miReservaClienteId)}
                                  className="w-full py-1.5 rounded-full bg-[#E5097F]/10 hover:bg-[#E5097F]/20 text-[#E5097F] font-condensed text-[11px] font-bold uppercase tracking-wider cursor-pointer"
                                >
                                  CANCELAR MI RESERVA AQUÍ
                                </button>
                              )}
                            </div>
                          </div>
                        );
                      })}
                  </div>
                </section>

                {/* ----------------------------------------------------------- */}
                {/* 5. CALCULADORA BCV, SELECCIÓN DE MOTOS Y AGENDAMIENTO       */}
                {/*    (Diseño limpio y armónico: Blanco + Marino + Fucsia)     */}
                {/* ----------------------------------------------------------- */}
                <section id="cli-precios" className="bg-[#F4F8FB] text-[#0D1B2A] border-t border-slate-200 py-14 px-6 sm:px-14">
                  <div className="max-w-3xl mx-auto text-center mb-10">
                    <span className="inline-block px-3.5 py-1 rounded-full bg-[#E0F2FE] text-[#0284C7] font-mono text-[11px] font-bold uppercase tracking-widest mb-2">
                       RESERVA DIRECTA MULTIMOTO • TASA EURO BCV Bs. {tasaEUR.toFixed(2)}
                    </span>
                    <h2 className="font-condensed text-3xl sm:text-4xl font-bold uppercase tracking-wide text-[#0D1B2A]">
                      TARIFAS OFICIALES, <span className="text-[#E5097F]">ELECCIÓN DE MOTOS</span> & PAGO MÓVIL
                    </h2>
                    <p className="text-xs text-slate-600 mt-1.5 leading-relaxed">
                      Contamos con <strong>3 motos Yamaha en muelle (#01, #02 y #03)</strong>. Elige tu tiempo de paseo, selecciona el horario y haz clic en la(s) moto(s) que deseas apartar sin choques de horario.
                    </p>
                  </div>

                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    {/* COLUMNA IZQUIERDA: PASO 1 (TIEMPO), PASO 2 (HORARIO), PASO 3 (ELECCIÓN DE MOTOS #01, #02, #03) */}
                    <div className="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">

                      {/* PASO 1: DURACIÓN Y TARIFA */}
                      <div className="space-y-2.5">
                        <div className="flex items-center justify-between">
                          <span className="font-condensed text-sm font-bold uppercase tracking-wider text-[#0D1B2A]">
                            1. Elige la Duración del Paseo (Por Moto):
                          </span>
                          <span className="text-[11px] font-mono text-slate-500">
                            15/20m = 1 bloque • 30/40m = 2 bloques
                          </span>
                        </div>
                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                          {TARIFAS_OFICIALES.map(t => {
                            const activo = calcDuracion === t.min;
                            return (
                              <button
                                key={t.min}
                                type="button"
                                onClick={() => setCalcDuracion(t.min)}
                                className={`p-3.5 rounded-xl text-center font-condensed cursor-pointer transition-all border ${
                                  activo
                                    ? 'bg-[#E5097F] text-white border-[#E5097F] shadow-md'
                                    : 'bg-[#F8FAFC] text-[#0D1B2A] border-slate-200 hover:border-[#1DA1DB]'
                                }`}
                              >
                                <span className="text-base font-bold block leading-none">{t.min} MIN</span>
                                <strong className="font-mono text-2xl font-black block mt-1">{t.eur}€</strong>
                                <span className={`text-[10px] uppercase block mt-0.5 ${activo ? 'text-white/90' : 'text-slate-500'}`}>
                                  {t.desc}
                                </span>
                              </button>
                            );
                          })}
                        </div>
                      </div>

                      {/* PASO 1.5: SELECCIÓN DE DÍA (HOY, MAÑANA, FIN DE SEMANA) */}
                      <div className="space-y-3 pt-4 border-t border-slate-100">
                        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                          <div>
                            <span className="font-condensed text-sm font-bold uppercase tracking-wider text-[#0D1B2A] block">
                              2. Selecciona la Fecha de tu Paseo:
                            </span>
                            <span className="text-[11px] text-slate-500">
                              Trabajamos de <strong>Viernes a Domingo</strong> y todos los días de la semana.
                            </span>
                          </div>
                          <span className="px-2.5 py-1 rounded-full bg-[#E0F2FE] text-[#0284C7] font-mono text-[11px] font-bold">
                            {formatFechaBonita(pagoFecha || fechaSeleccionada)}
                          </span>
                        </div>

                        <div className="flex items-center gap-2 flex-wrap">
                          {[
                            diasOperativos.hoy,
                            diasOperativos.manana,
                            diasOperativos.viernes,
                            diasOperativos.sabado,
                            diasOperativos.domingo
                          ].map(d => {
                            const activo = (pagoFecha || fechaSeleccionada) === d.fecha;
                            return (
                              <button
                                key={d.id}
                                type="button"
                                onClick={() => {
                                  setPagoFecha(d.fecha);
                                  setFechaSeleccionada(d.fecha);
                                  setPagoSlotIdSeleccionado('');
                                }}
                                className={`px-3 py-1.5 rounded-xl text-left font-condensed transition-all cursor-pointer border ${
                                  activo
                                    ? 'bg-[#0D1B2A] text-white border-[#0D1B2A] shadow-md ring-2 ring-[#E5097F]'
                                    : 'bg-[#F8FAFC] text-slate-700 border-slate-200 hover:border-[#1DA1DB]'
                                }`}
                              >
                                <span className="font-bold text-xs uppercase block">{d.etiqueta}</span>
                                <span className={`text-[10px] font-mono ${activo ? 'text-[#7DD3FC]' : 'text-slate-400'}`}>
                                  {d.corta}
                                </span>
                              </button>
                            );
                          })}

                          <div className="flex items-center gap-1.5 bg-[#F8FAFC] px-3 py-1.5 rounded-xl border border-slate-200">
                            <span className="text-[10px] font-mono font-bold text-slate-500 uppercase">Otro:</span>
                            <input
                              type="date"
                              value={pagoFecha || fechaSeleccionada}
                              onChange={(e) => {
                                if (e.target.value) {
                                  setPagoFecha(e.target.value);
                                  setFechaSeleccionada(e.target.value);
                                  setPagoSlotIdSeleccionado('');
                                }
                              }}
                              className="text-xs font-mono font-bold text-[#0D1B2A] bg-transparent outline-none cursor-pointer"
                            />
                          </div>
                        </div>
                      </div>

                      {/* PASO 3: SELECCIÓN DE HORARIO DISPONIBLE */}
                      <div className="space-y-3 pt-4 border-t border-slate-100">
                        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                          <div>
                            <span className="font-condensed text-sm font-bold uppercase tracking-wider text-[#0D1B2A] block">
                              3. Selecciona el Horario de Salida:
                            </span>
                            <span className="text-[11px] text-slate-500">
                              Si 1 moto está ocupada en una hora, las otras 2 siguen libres a esa misma hora.
                            </span>
                          </div>
                          {primerHorarioDisponible && (
                            <span className="px-3 py-1 rounded-full bg-[#F0F9FF] border border-[#BAE6FD] text-[#0284C7] font-mono text-[11px] font-bold">
                              Próxima salida disponible: {evaluarEstadoSlot(primerHorarioDisponible, fechaSeleccionada).horaInicioReal}
                            </span>
                          )}
                        </div>

                        {horariosDisponiblesParaAgendar.length === 0 ? (
                          <div className="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs space-y-2.5">
                            <div className="font-bold uppercase text-[11px] flex items-center gap-1.5 text-amber-800">
                              <span>Horarios de Navegación Concluidos para esta Fecha</span>
                            </div>
                            <p className="text-slate-600">
                              {fechaSeleccionada === diasOperativos.hoy.fecha
                                ? `Por regulaciones de Capitanía de Puerto y luz solar, no hay más salidas programables para hoy a las ${horaVET}. ¡Puedes apartar tu paseo para Mañana o para el Fin de Semana!`
                                : 'No hay salidas disponibles para la duración seleccionada en esta fecha. Elige otra fecha o duración.'}
                            </p>
                            <div className="flex items-center gap-2 pt-1 flex-wrap">
                              <button
                                type="button"
                                onClick={() => {
                                  setFechaSeleccionada(diasOperativos.manana.fecha);
                                  setPagoFecha(diasOperativos.manana.fecha);
                                  setPagoSlotIdSeleccionado('');
                                }}
                                className="px-3 py-1.5 rounded-lg bg-[#0D1B2A] text-white font-condensed font-bold uppercase text-xs cursor-pointer hover:bg-black shadow-sm"
                              >
                                Ver Horarios de Mañana ({diasOperativos.manana.corta})
                              </button>
                              <button
                                type="button"
                                onClick={() => {
                                  setFechaSeleccionada(diasOperativos.viernes.fecha);
                                  setPagoFecha(diasOperativos.viernes.fecha);
                                  setPagoSlotIdSeleccionado('');
                                }}
                                className="px-3 py-1.5 rounded-lg bg-[#E5097F] text-white font-condensed font-bold uppercase text-xs cursor-pointer hover:bg-[#C8066C] shadow-sm"
                              >
                                Ver Fin de Semana ({diasOperativos.viernes.corta})
                              </button>
                            </div>
                          </div>
                        ) : (
                          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 max-h-52 overflow-y-auto pr-1">
                            {horariosDisponiblesParaAgendar.map(disp => {
                              const evDisp = evaluarEstadoSlot(disp, fechaSeleccionada);
                              const aptasEnSlot = evDisp.detalleMotos.filter(d => d.disponible && d.maxMinPosibles >= calcDuracion);
                              const seleccionado = Boolean(slotParaPagoActual && slotParaPagoActual.id === disp.id);
                              return (
                                <button
                                  key={disp.id}
                                  type="button"
                                  onClick={() => setPagoSlotIdSeleccionado(disp.id)}
                                  className={`py-2.5 px-3 rounded-lg text-left font-mono text-xs border cursor-pointer transition-all ${
                                    seleccionado
                                      ? 'bg-[#0D1B2A] text-white border-[#0D1B2A] shadow-sm'
                                      : 'bg-[#F8FAFC] text-[#0D1B2A] border-slate-200 hover:border-[#1DA1DB]'
                                  }`}
                                >
                                  <div className="font-bold text-xs">{evDisp.horaInicioReal}</div>
                                  <div className={`text-[10px] font-condensed uppercase mt-0.5 ${
                                    seleccionado ? 'text-[#7DD3FC]' : aptasEnSlot.length === 3 ? 'text-[#0284C7]' : 'text-[#E5097F]'
                                  }`}>
                                    {aptasEnSlot.length}/{evDisp.motosOperativasTotal} MOTOS LIBRES
                                  </div>
                                </button>
                              );
                            })}
                          </div>
                        )}
                      </div>

                      {/* PASO 3: SELECCIÓN INTERACTIVA DE LAS 3 MOTOS (#01, #02, #03) EN EL HORARIO ELEGIDO */}
                      {slotParaPagoActual && (() => {
                        const evSel = evaluarEstadoSlot(slotParaPagoActual);
                        const motosAptas = evSel.detalleMotos.filter(d => d.disponible && d.maxMinPosibles >= calcDuracion).map(d => d.numero);
                        const seleccionActual = calcMotosSeleccionadas.filter(n => motosAptas.includes(n));
                        const listaFinalMotos = seleccionActual.length > 0 ? seleccionActual : motosAptas.slice(0, 1);
                        const cantSeleccionadas = listaFinalMotos.length;
                        const quedaranLibres = Math.max(0, evSel.cantLibres - cantSeleccionadas);
                        const totalEurosSel = (TARIFAS_MAP[calcDuracion] || 30) * cantSeleccionadas;
                        const totalBsSel = totalEurosSel * tasaEUR;

                        const toggleMoto = (numMoto) => {
                          if (!motosAptas.includes(numMoto)) return;
                          setCalcMotosSeleccionadas(prev => {
                            const limpias = prev.filter(n => motosAptas.includes(n));
                            // Si estamos en modo 1 moto, cambiar directamente a la moto seleccionada
                            if (cantSeleccionadas === 1) {
                              return [numMoto];
                            }
                            if (limpias.includes(numMoto)) {
                              if (limpias.length === 1) return limpias;
                              return limpias.filter(n => n !== numMoto);
                            }
                            return [...limpias, numMoto].sort();
                          });
                        };

                        const seleccionarCantidadRapida = (n) => {
                          const tope = Math.min(n, motosAptas.length);
                          setCalcMotosSeleccionadas(motosAptas.slice(0, tope));
                          setCalcCantidadMotos(tope);
                        };

                        return (
                          <div className="space-y-4 pt-4 border-t border-slate-100">
                            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                              <div>
                                <span className="font-condensed text-sm font-bold uppercase tracking-wider text-[#0D1B2A] block">
                                  3. Elige tu(s) Unidad(es) para las {evSel.horaInicioReal}:
                                </span>
                                <span className="text-[11px] text-slate-500">
                                  Haz clic en la moto que deseas alquilar. Cada moto tiene su carril independiente de horarios.
                                </span>
                              </div>

                              <div className="flex items-center gap-1.5">
                                {[1, 2, 3].map(n => {
                                  const habilitado = n <= motosAptas.length;
                                  const esActivo = cantSeleccionadas === n;
                                  return (
                                    <button
                                      key={n}
                                      type="button"
                                      disabled={!habilitado}
                                      onClick={() => seleccionarCantidadRapida(n)}
                                      className={`px-3 py-1 rounded-full text-xs font-condensed font-bold uppercase transition-all ${
                                        !habilitado
                                          ? 'bg-slate-100 text-slate-300 cursor-not-allowed'
                                          : esActivo
                                          ? 'bg-[#E5097F] text-white cursor-pointer shadow-sm'
                                          : 'bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer'
                                      }`}
                                    >
                                      {n} {n === 1 ? 'Moto' : 'Motos'}
                                    </button>
                                  );
                                })}
                              </div>
                            </div>

                            {/* TARJETAS DE LAS 3 MOTOS (#01, #02, #03) CON ESTADO Y HORA EXACTA DE DESOCUPACIÓN */}
                            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                              {evSel.detalleMotos.map(dm => {
                                const esApta = dm.disponible && dm.maxMinPosibles >= calcDuracion;
                                const estaMarcada = esApta && listaFinalMotos.includes(dm.numero);
                                return (
                                  <button
                                    key={dm.numero}
                                    type="button"
                                    disabled={!esApta}
                                    onClick={() => toggleMoto(dm.numero)}
                                    className={`p-3.5 rounded-xl border text-left transition-all flex flex-col justify-between ${
                                      !esApta
                                        ? 'bg-slate-50 border-slate-200 text-slate-400 cursor-not-allowed opacity-80'
                                        : estaMarcada
                                        ? 'bg-[#0D1B2A] text-white border-[#0D1B2A] ring-2 ring-[#E5097F] cursor-pointer shadow-md'
                                        : 'bg-white text-[#0D1B2A] border-slate-300 hover:border-[#1DA1DB] cursor-pointer'
                                    }`}
                                  >
                                    <div>
                                      <div className="flex items-center justify-between gap-1">
                                        <span className="font-mono text-xs font-black">MOTO #{dm.numero}</span>
                                        <span className={`px-2 py-0.5 rounded-full text-[9px] font-condensed font-bold uppercase ${
                                          !esApta
                                            ? 'bg-slate-200 text-slate-600'
                                            : estaMarcada
                                            ? 'bg-[#E5097F] text-white'
                                            : 'bg-[#E0F2FE] text-[#0284C7]'
                                        }`}>
                                          {!dm.disponible
                                            ? dm.estado === 'en_agua'
                                              ? 'EN AGUA'
                                              : dm.estado === 'taller'
                                              ? 'TALLER'
                                              : 'OCUPADA'
                                            : !esApta
                                            ? 'TIEMPO INSUF.'
                                            : estaMarcada
                                            ? 'SELECCIONADA'
                                            : 'DISPONIBLE'}
                                        </span>
                                      </div>
                                      <div className={`font-condensed text-xs font-bold uppercase mt-1 truncate ${
                                        estaMarcada ? 'text-white' : 'text-[#0D1B2A]'
                                      }`}>
                                        {dm.nombreModelo.replace('YAMAHA ', '')}
                                      </div>
                                    </div>

                                    <div className={`text-[10px] font-mono mt-2 pt-1.5 border-t ${
                                      estaMarcada ? 'border-white/15 text-slate-200' : 'border-slate-100 text-slate-500'
                                    }`}>
                                      {dm.disponible ? (
                                        <div className="space-y-0.5">
                                          <div className={estaMarcada ? 'text-[#7DD3FC] font-bold' : 'text-[#0284C7] font-bold'}>
                                            {dm.textoLibre}
                                          </div>
                                          <div className="text-[9px] opacity-75">
                                            Base: {dm.ubicacion === 'sunsol' ? 'Sunsol Caribe' : 'Playa Parguito'}
                                          </div>
                                        </div>
                                      ) : (
                                        <div className="text-[#E5097F] font-bold text-[10px]">
                                          {dm.textoOcupada || `Ocupada • Se desocupa a las ${dm.horaSeDesocupa || ''}`}
                                        </div>
                                      )}
                                    </div>
                                  </button>
                                );
                              })}
                            </div>

                            {/* BARRA DE RESUMEN DE MONTO Y BLOQUEO DE HORARIO */}
                            <div className="bg-[#0D1B2A] text-white rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                              <div className="space-y-1">
                                <span className="text-[10px] font-mono uppercase text-[#7DD3FC] block">
                                  RESUMEN DE TU RESERVA ({cantSeleccionadas} {cantSeleccionadas === 1 ? 'MOTO' : 'MOTOS'} • {calcDuracion} MIN)
                                </span>
                                <div className="text-sm font-condensed font-bold uppercase">
                                  {listaFinalMotos.map(n => `Moto #${n}`).join(' + ')} • Salida {evSel.horaInicioReal} a{' '}
                                  {formatMinutesToHora(slotParaPagoActual.minDia + retrasoGlobal + calcDuracion)}
                                </div>
                                <p className="text-[11px] text-slate-300 font-mono">
                                  {quedaranLibres > 0
                                    ? `En este horario de las ${evSel.horaInicioReal} aún ${quedaranLibres === 1 ? 'quedará 1 moto libre' : `quedarán ${quedaranLibres} motos libres`}.`
                                    : `Con esta selección se ocupan las 3/3 motos a las ${evSel.horaInicioReal}.`}
                                </p>
                              </div>

                              <div className="sm:text-right shrink-0 border-t sm:border-t-0 pt-3 sm:pt-0 border-white/15">
                                <div className="font-condensed text-3xl font-bold text-white leading-none">
                                  {totalEurosSel}€
                                </div>
                                <div className="font-mono text-sm font-bold text-[#7DD3FC] mt-1">
                                  Bs. {totalBsSel.toFixed(2)}
                                </div>
                              </div>
                            </div>
                          </div>
                        );
                      })()}
                    </div>

                    {/* COLUMNA DERECHA: DATOS BANCARIOS Y FORMULARIO DE CONFIRMACIÓN */}
                    <div className="lg:col-span-5 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-5">
                      <div>
                        <span className="text-[10px] font-mono uppercase tracking-widest text-[#E5097F] font-bold block">
                          REGISTRO DIRECTO EN OPERACIONES DE MUELLE
                        </span>
                        <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A] mt-0.5">
                          CONFIRMAR HORARIO & PAGO
                        </h3>
                        <p className="text-xs text-slate-500 mt-1">
                          Completa tus datos para bloquear tu(s) moto(s) en la agenda oficial y activar tu ticket con alarma.
                        </p>
                      </div>

                      {/* SELECTOR DE MÉTODO DE PAGO */}
                      <div className="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl">
                        {['Pago Móvil BCV', 'Efectivo € en Muelle'].map(met => (
                          <button
                            key={met}
                            type="button"
                            onClick={() => setPagoMetodo(met)}
                            className={`py-2 px-3 rounded-lg font-condensed text-xs font-bold uppercase tracking-wider cursor-pointer transition-all ${
                              pagoMetodo === met
                                ? 'bg-[#0D1B2A] text-white shadow-sm'
                                : 'text-slate-600 hover:text-[#0D1B2A]'
                            }`}
                          >
                            {met}
                          </button>
                        ))}
                      </div>

                      {pagoMetodo === 'Pago Móvil BCV' && (
                        <div className="p-4 bg-[#F8FAFC] border-l-4 border-[#1DA1DB] rounded-r-xl space-y-1.5 font-mono text-xs text-[#0D1B2A]">
                          <div className="flex justify-between py-1 border-b border-slate-200">
                            <span className="text-slate-500">BANCO:</span>
                            <strong>BANESCO (0134) / VENEZUELA (0102)</strong>
                          </div>
                          <div className="flex justify-between py-1 border-b border-slate-200">
                            <span className="text-slate-500">CÉDULA / RIF:</span>
                            <strong>V-18.492.310</strong>
                          </div>
                          <div className="flex justify-between py-1 border-b border-slate-200">
                            <span className="text-slate-500">TELÉFONO PAGO MÓVIL:</span>
                            <strong className="text-[#0284C7]">0412-8832100</strong>
                          </div>
                          <div className="flex justify-between pt-1">
                            <span className="text-slate-500">MONTO EXACTO BCV:</span>
                            <strong className="text-[#E5097F]">Bs. {montoCalculadoraBs.toFixed(2)} ({montoCalculadoraEUR}€)</strong>
                          </div>
                        </div>
                      )}

                      {pagoConfirmadoInfo && (
                        <div className="p-4 bg-[#F0F9FF] border border-[#BAE6FD] text-[#0D1B2A] rounded-xl space-y-1">
                          <div className="flex items-center justify-between text-[#0284C7]">
                            <strong className="font-condensed text-sm uppercase">
                              ¡RESERVA REGISTRADA EN OPERACIONES!
                            </strong>
                            <Icons.CheckCircle className="w-5 h-5 shrink-0" />
                          </div>
                          <p className="text-xs font-mono">
                            Piloto: <strong>{pagoConfirmadoInfo.cliente}</strong> • Unidad: <strong>{pagoConfirmadoInfo.motosAsignadas}</strong>
                          </p>
                          <p className="text-xs font-mono text-slate-600">
                            Horario: <strong>{pagoConfirmadoInfo.horaSalida} a {pagoConfirmadoInfo.horaRetorno} ({pagoConfirmadoInfo.duracionMin} min)</strong> • Zona: <strong>{pagoConfirmadoInfo.puntoNombre}</strong>
                          </p>
                        </div>
                      )}

                      <form onSubmit={handleReportarPagoYAgendar} className="space-y-4">
                        <div className="space-y-1.5">
                          <label className="text-[11px] font-condensed uppercase font-bold text-slate-700 block">
                            ¿En cuál punto vas a abordar la moto? *
                          </label>
                          <div className="grid grid-cols-2 gap-2">
                            {[
                              { id: 'parguito', label: 'Playa Parguito (Toldos)' },
                              { id: 'sunsol', label: 'Sunsol Isla Caribe' }
                            ].map(p => (
                              <button
                                key={p.id}
                                type="button"
                                onClick={() => setPagoPunto(p.id)}
                                className={`py-2.5 px-3 rounded-lg text-xs font-condensed font-bold uppercase tracking-wider border cursor-pointer transition-all ${
                                  pagoPunto === p.id
                                    ? 'bg-[#0284C7] text-white border-[#0284C7]'
                                    : 'bg-[#F8FAFC] text-slate-700 border-slate-200 hover:border-slate-300'
                                }`}
                              >
                                {p.label}
                              </button>
                            ))}
                          </div>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                          <div>
                            <label className="text-[11px] font-condensed uppercase font-bold text-slate-700 block mb-1">
                              Nombre y Apellido *
                            </label>
                            <input
                              type="text"
                              required
                              placeholder="Ej: Andrés Gómez"
                              value={pagoNombre}
                              onChange={e => setPagoNombre(e.target.value)}
                              className="w-full px-3.5 py-2.5 rounded-lg bg-[#F8FAFC] border border-slate-300 text-[#0D1B2A] text-xs focus:outline-none focus:border-[#0284C7]"
                            />
                          </div>
                          <div>
                            <label className="text-[11px] font-condensed uppercase font-bold text-slate-700 block mb-1">
                              Nº de Toldo / Habitación *
                            </label>
                            <input
                              type="text"
                              required
                              placeholder={pagoPunto === 'sunsol' ? 'Ej: Sunsol Hab. 204' : 'Ej: Toldo #08 / 0414-...'}
                              value={pagoToldo}
                              onChange={e => setPagoToldo(e.target.value)}
                              className="w-full px-3.5 py-2.5 rounded-lg bg-[#F8FAFC] border border-slate-300 text-[#0D1B2A] text-xs focus:outline-none focus:border-[#0284C7]"
                            />
                          </div>
                        </div>

                        {pagoMetodo === 'Pago Móvil BCV' && (
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start">
                            <div>
                              <label className="text-[11px] font-condensed uppercase font-bold text-slate-700 block mb-1">
                                Nº Referencia Pago Móvil *
                              </label>
                              <input
                                type="text"
                                required
                                placeholder="Ej: 849302"
                                value={pagoReferencia}
                                onChange={e => setPagoReferencia(e.target.value)}
                                className="w-full px-3.5 py-2.5 rounded-lg bg-[#F8FAFC] border border-slate-300 text-[#0D1B2A] font-mono text-xs font-bold focus:outline-none focus:border-[#0284C7]"
                              />
                            </div>

                            <div>
                              <label className="text-[11px] font-condensed uppercase font-bold text-slate-700 block mb-1">
                                Capture de Pago (Opcional)
                              </label>
                              <label className="w-full px-3 py-2.5 rounded-lg bg-[#F0F9FF] hover:bg-[#E0F2FE] border border-dashed border-[#0284C7] text-[#0284C7] text-xs font-condensed font-bold uppercase tracking-wider flex items-center justify-center gap-1.5 cursor-pointer">
                                <Icons.CheckCircle className="w-4 h-4 shrink-0" />
                                <span className="truncate">
                                  {pagoCaptureNombre ? pagoCaptureNombre : 'ADJUNTAR CAPTURE'}
                                </span>
                                <input
                                  type="file"
                                  accept="image/*"
                                  onChange={e => handleSubirArchivoCapture(e, 'directo')}
                                  className="hidden"
                                />
                              </label>
                            </div>
                          </div>
                        )}

                        {pagoCaptureDataUrl && (
                          <div className="p-2.5 rounded-lg bg-[#F8FAFC] border border-slate-200 flex items-center justify-between gap-3">
                            <div className="flex items-center gap-3">
                              <img
                                src={pagoCaptureDataUrl}
                                alt="Vista previa Capture"
                                className="h-12 w-12 rounded object-cover border border-slate-300"
                              />
                              <div className="text-xs">
                                <strong className="text-[#0D1B2A] block font-condensed uppercase">
                                  Comprobante Adjuntado
                                </strong>
                                <span className="text-[11px] text-slate-500 font-mono">
                                  Visible en el Panel del Operador
                                </span>
                              </div>
                            </div>
                            <button
                              type="button"
                              onClick={() => {
                                setPagoCaptureDataUrl(null);
                                setPagoCaptureNombre('');
                              }}
                              className="text-xs text-[#E5097F] font-bold underline cursor-pointer"
                            >
                              Quitar
                            </button>
                          </div>
                        )}

                        <button
                          type="submit"
                          className="w-full py-3.5 rounded-xl bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-sm font-bold uppercase tracking-widest cursor-pointer shadow-md transition-all"
                        >
                          CONFIRMAR Y AGENDAR ({calcMotosSeleccionadas.map(n => `#${n}`).join(', ')} • {calcDuracion} MIN • {montoCalculadoraEUR}€)
                        </button>
                      </form>
                    </div>
                  </div>
                </section>

                {/* ----------------------------------------------------------- */}
                {/* 6. CLÁUSULAS DE ATENCIÓN & FIRMA DIGITAL DEL CONTRATO       */}
                {/* (Fondo Fucsia #E5097F con tarjeta blanca ATENCIÓN + Firma)  */}
                {/* ----------------------------------------------------------- */}
                <section id="cli-waiver" className="relative overflow-hidden bg-[#E5097F] text-white pt-12 pb-0">

                  {/* Decoración de fondo: Manchas / Splash Fucsia Oscuro (#C8066C) como en tu captura */}
                  <svg
                    viewBox="0 0 1200 900"
                    className="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-45"
                    preserveAspectRatio="none"
                  >
                    <path
                      d="M-80,80 C120,20 260,180 420,120 C580,60 740,-40 960,60 C1120,130 1250,40 1300,180 L1300,900 L-80,900 Z"
                      fill="#C8066C"
                    />
                    <circle cx="110" cy="240" r="95" fill="#B50460" opacity="0.55" />
                    <circle cx="1080" cy="340" r="130" fill="#B50460" opacity="0.45" />
                    <circle cx="950" cy="120" r="45" fill="#B50460" opacity="0.6" />
                    <circle cx="180" cy="540" r="70" fill="#B50460" opacity="0.5" />
                  </svg>

                  <div className="relative max-w-4xl mx-auto px-5 sm:px-10 z-10">

                    {/* TARJETA BLANCA REDONDEADA: "ATENCIÓN" + 5 CLÁUSULAS + FIRMA DIGITAL */}
                    <div className="bg-white text-[#0D1B2A] rounded-[32px] shadow-2xl p-6 sm:p-10 border-4 border-white/90">

                      {/* Encabezado ATENCIÓN con triángulos fucsia */}
                      <div className="flex items-center justify-center gap-3 mb-6">
                        <svg viewBox="0 0 36 36" className="w-8 h-8 text-[#E5097F] shrink-0" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                          <path d="M18 4 L33 30 L3 30 Z" />
                          <line x1="18" y1="13" x2="18" y2="21" />
                          <circle cx="18" cy="25.5" r="1.5" fill="currentColor" />
                        </svg>
                        <h3 className="font-condensed font-black uppercase text-3xl sm:text-4xl tracking-wider text-[#E5097F]">
                          ATENCIÓN
                        </h3>
                        <svg viewBox="0 0 36 36" className="w-8 h-8 text-[#E5097F] shrink-0" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                          <path d="M18 4 L33 30 L3 30 Z" />
                          <line x1="18" y1="13" x2="18" y2="21" />
                          <circle cx="18" cy="25.5" r="1.5" fill="currentColor" />
                        </svg>
                      </div>

                      {/* Las 5 Cláusulas Oficiales del Arte con sus iconos exactos y líneas divisoras */}
                      <div className="divide-y divide-slate-300 border-t border-b border-slate-300">

                        {/* Cláusula 1: Escudo con Check */}
                        <div className="py-3.5 flex items-center gap-4">
                          <div className="w-11 h-11 shrink-0 flex items-center justify-center text-[#0D1B2A]">
                            <svg viewBox="0 0 40 40" className="w-9 h-9" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <path d="M20 4 L33 9 V19 C33 27.5 27 33.5 20 36 C13 33.5 7 27.5 7 19 V9 L20 4 Z" />
                              <polyline points="14,20 18,24 26,15" strokeWidth="2.8" />
                            </svg>
                          </div>
                          <p className="text-xs sm:text-sm font-medium text-[#0D1B2A] leading-snug">
                            La empresa no se hace responsable de daños y/o pérdidas de objetos pertenecientes al cliente (prendas, teléfonos, gorras, lentes, carteras, llaves, dinero, etc.)
                          </p>
                        </div>

                        {/* Cláusula 2: Persona en círculo */}
                        <div className="py-3.5 flex items-center gap-4">
                          <div className="w-11 h-11 shrink-0 flex items-center justify-center text-[#0D1B2A]">
                            <svg viewBox="0 0 40 40" className="w-9 h-9" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <circle cx="20" cy="20" r="15" />
                              <circle cx="20" cy="15" r="4.5" />
                              <path d="M11 30 C11 24.5, 29 24.5, 29 30" />
                            </svg>
                          </div>
                          <p className="text-xs sm:text-sm font-medium text-[#0D1B2A] leading-snug">
                            La empresa no responde por daños físicos hacia su persona y/o terceros involucrados.
                          </p>
                        </div>

                        {/* Cláusula 3: Triángulo de Advertencia */}
                        <div className="py-3.5 flex items-center gap-4">
                          <div className="w-11 h-11 shrink-0 flex items-center justify-center text-[#0D1B2A]">
                            <svg viewBox="0 0 40 40" className="w-9 h-9" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <path d="M20 6 L35 33 L5 33 Z" />
                              <line x1="20" y1="15" x2="20" y2="23" strokeWidth="2.8" />
                              <circle cx="20" cy="28" r="1.5" fill="currentColor" />
                            </svg>
                          </div>
                          <p className="text-xs sm:text-sm font-medium text-[#0D1B2A] leading-snug">
                            En caso de incumplimiento de la normativa, se harán máximo dos (2) llamados de atención; de no obedecer, se procederá de inmediato al retiro de la embarcación.
                          </p>
                        </div>

                        {/* Cláusula 4: Símbolo de Dinero / No Reembolso en círculo */}
                        <div className="py-3.5 flex items-center gap-4">
                          <div className="w-11 h-11 shrink-0 flex items-center justify-center text-[#0D1B2A]">
                            <svg viewBox="0 0 40 40" className="w-9 h-9" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <circle cx="20" cy="20" r="15" />
                              <path d="M24 14.5 C24 12.5, 16 12.5, 16 16 C16 19.5, 24 19.5, 24 23.5 C24 27, 16 27, 16 24.5" />
                              <line x1="20" y1="10" x2="20" y2="30" />
                            </svg>
                          </div>
                          <p className="text-xs sm:text-sm font-medium text-[#0D1B2A] leading-snug">
                            Por incumplimiento de la normativa no tendrá derecho al reembolso.
                          </p>
                        </div>

                        {/* Cláusula 5: X en círculo (Responsabilidad por daños o averías) */}
                        <div className="py-3.5 flex items-center gap-4">
                          <div className="w-11 h-11 shrink-0 flex items-center justify-center text-[#0D1B2A]">
                            <svg viewBox="0 0 40 40" className="w-9 h-9" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                              <circle cx="20" cy="20" r="15" />
                              <line x1="14" y1="14" x2="26" y2="26" strokeWidth="2.8" />
                              <line x1="26" y1="14" x2="14" y2="26" strokeWidth="2.8" />
                            </svg>
                          </div>
                          <p className="text-xs sm:text-sm font-medium text-[#0D1B2A] leading-snug">
                            En caso de deterioro o avería por imprudencia, no obedecer las normas, instrucciones del monitor o hacer un mal uso, el cliente será responsable del pago de la reparación y daños causados al vehículo y otros.
                          </p>
                        </div>
                      </div>

                      {/* FORMULARIO INTERACTIVO DE FIRMA DEL CONTRATO DIGITAL */}
                      <div className="mt-7 pt-6 border-t-2 border-dashed border-[#E5097F]/35">
                        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                          <div>
                            <span className="inline-block px-3 py-0.5 rounded-full bg-[#E5097F]/10 text-[#E5097F] font-condensed text-xs font-extrabold uppercase tracking-wider">
                              PASO OBLIGATORIO ANTES DE ABORDAR
                            </span>
                            <h4 className="font-condensed text-xl sm:text-2xl font-black uppercase text-[#0D1B2A] mt-0.5">
                              FIRMA DIGITAL DEL CONTRATO DE ALQUILER
                            </h4>
                          </div>
                          <span className="text-xs text-slate-500">
                            Se envía directo al Panel de Muelle
                          </span>
                        </div>

                        {miWaiverFirmado && (
                          <div className="mb-5 p-4 rounded-2xl bg-[#1DA1DB] text-white flex items-center justify-between shadow-md">
                            <div>
                              <strong className="font-condensed text-base uppercase block">
                                ¡Contrato de Alquiler Firmado y Registrado en Muelle!
                              </strong>
                              <span className="text-xs opacity-90">
                                Piloto: {miWaiverFirmado.nombre} ({miWaiverFirmado.documento}) • Hora: {miWaiverFirmado.hora}
                              </span>
                            </div>
                            <Icons.CheckCircle className="w-7 h-7 shrink-0" />
                          </div>
                        )}

                        <form onSubmit={handleGuardarWaiver} className="space-y-4">
                          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <input
                              type="text"
                              required
                              placeholder="Tu Nombre y Apellido *"
                              value={waiverNombre}
                              onChange={e => setWaiverNombre(e.target.value)}
                              className="px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-xs text-[#0D1B2A] focus:outline-none focus:border-[#E5097F]"
                            />
                            <input
                              type="text"
                              required
                              placeholder="Tu Cédula o Pasaporte *"
                              value={waiverDoc}
                              onChange={e => setWaiverDoc(e.target.value)}
                              className="px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-xs text-[#0D1B2A] focus:outline-none focus:border-[#E5097F]"
                            />
                            <input
                              type="text"
                              placeholder="Tu Teléfono o Nº de Toldo"
                              value={waiverTel}
                              onChange={e => setWaiverTel(e.target.value)}
                              className="px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-xs text-[#0D1B2A] focus:outline-none focus:border-[#E5097F]"
                            />
                          </div>

                          <div>
                            <div className="flex justify-between items-center mb-1.5">
                              <span className="font-condensed text-xs uppercase font-bold text-[#0D1B2A]">
                                DIBUJA TU FIRMA CON EL DEDO AQUÍ ABAJO:
                              </span>
                              <button
                                type="button"
                                onClick={limpiarCanvasFirma}
                                className="text-xs font-bold text-[#E5097F] underline cursor-pointer"
                              >
                                Borrar y repetir firma
                              </button>
                            </div>
                            <div className="relative h-44 w-full rounded-2xl bg-slate-50 border-2 border-dashed border-[#E5097F]/50 overflow-hidden">
                              <canvas
                                ref={canvasRef}
                                onMouseDown={iniciarTrazo}
                                onMouseMove={dibujarTrazo}
                                onMouseUp={terminarTrazo}
                                onMouseLeave={terminarTrazo}
                                onTouchStart={iniciarTrazo}
                                onTouchMove={dibujarTrazo}
                                onTouchEnd={terminarTrazo}
                                className="w-full h-full touch-canvas cursor-crosshair relative z-10"
                              />
                              {!haFirmadoCanvas && (
                                <div className="absolute inset-0 flex items-center justify-center pointer-events-none text-xs text-slate-400">
                                  Traza tu firma aquí para aceptar las cláusulas de atención
                                </div>
                              )}
                            </div>
                          </div>

                          <button
                            type="submit"
                            className="w-full py-4 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-base font-black uppercase tracking-widest cursor-pointer shadow-lg transition"
                          >
                            ACEPTAR NORMAS DE DIVINA ACUÁTICA Y ENVIAR FIRMA AL MUELLE
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>

                  {/* PIE DE SECCIÓN CON OLAS AZULES (#8FD6F2 + #1DA1DB) Y SELLOS ALIADOS */}
                  <div className="relative mt-8 pt-6">
                    <svg
                      viewBox="0 0 1440 130"
                      className="w-full h-14 sm:h-20 block -mb-1"
                      preserveAspectRatio="none"
                    >
                      <path
                        d="M0,45 C240,115 480,-15 720,45 C960,105 1200,5 1440,55 L1440,130 L0,130 Z"
                        fill="#8FD6F2"
                      />
                      <path
                        d="M0,70 C300,10 600,125 920,60 C1160,15 1320,85 1440,65 L1440,130 L0,130 Z"
                        fill="#1DA1DB"
                      />
                    </svg>

                    <div className="bg-[#1DA1DB] text-white px-6 sm:px-12 pb-8 pt-2">
                      <div className="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-6 text-center sm:text-left">
                        <div className="flex flex-wrap items-center justify-center sm:justify-start gap-6">
                          <Icons.LogoDivinaAcuatica className="h-11 w-auto" theme="dark" />
                          <div className="h-8 w-px bg-white/35 hidden sm:block" />
                          <div className="leading-tight">
                            <span className="font-serif italic text-base sm:text-lg font-bold block tracking-wide">
                              La Divina Comedia
                            </span>
                            <span className="text-[10px] uppercase tracking-widest text-white/90 block">
                              El Club de Playa Parguito
                            </span>
                          </div>
                          <div className="h-8 w-px bg-white/35 hidden sm:block" />
                          <div className="flex items-center gap-2">
                            <span className="px-2.5 py-1 rounded bg-white/15 font-condensed font-black text-xs tracking-widest uppercase">
                              INEA
                            </span>
                            <span className="px-2.5 py-1 rounded bg-white/15 font-condensed font-extrabold text-xs tracking-wider uppercase">
                              UUF! ESTUDIO
                            </span>
                          </div>
                        </div>

                        <div className="flex items-center gap-2.5 mx-auto sm:mx-0 bg-white/15 px-4 py-2 rounded-2xl">
                          <svg viewBox="0 0 24 24" className="w-6 h-6 text-white shrink-0" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <circle cx="12" cy="12" r="4.5" />
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                          </svg>
                          <div className="text-left text-xs font-bold leading-tight">
                            <span className="block">@divinacomedia.acuatica</span>
                            <span className="block text-white/90">@ladivina.comedia</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>
              </>
            ) : (
              /* ============================================================= */
              /* VISTA 2: PANEL DE CONTROL EXCLUSIVO DEL OPERADOR DE MUELLE    */
              /* (Sin relleno publicitario: puro control técnico y de caja)    */
              /* ============================================================= */
              <div className="bg-[#F2F6FA] min-h-[750px]">

                {/* CABECERA OPERATIVA DEL MUELLE */}
                <div className="bg-[#0D1B2A] text-white px-6 sm:px-10 py-6 border-b-4 border-[#E5097F]">
                  <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div className="flex items-center gap-4">
                      <Icons.LogoDivinaAcuatica className="h-10 sm:h-11 w-auto shrink-0" />
                      <div className="border-l border-white/20 pl-4">
                        <span className="text-[10px] font-mono uppercase tracking-widest text-[#8FD6F2] font-bold block">
                          CENTRO DE MANDO EXCLUSIVO DEL PERSONAL • PLAYA PARGUITO
                        </span>
                        <h1 className="font-condensed text-2xl sm:text-3xl font-bold uppercase">
                          PANEL OPERATIVO DE MUELLE Y ADMINISTRACIÓN
                        </h1>
                      </div>
                    </div>

                    {/* BOTONES DE RETRASO GLOBAL RÁPIDO EN LA CABECERA DEL OPERADOR */}
                    <div className="bg-[#07111C] p-3 border border-white/15 flex flex-wrap items-center gap-2">
                      <span className="text-[10px] font-mono uppercase text-[#8FD6F2] font-bold mr-1">
                        Retraso Muelle:
                      </span>
                      {[0, 10, 15, 20].map((min) => (
                        <button
                          key={min}
                          type="button"
                          onClick={() => setRetrasoGlobal(min)}
                          className={`px-3 py-1 font-condensed text-xs font-bold uppercase cursor-pointer transition-all ${
                            retrasoGlobal === min
                              ? min === 0 ? 'bg-[#1DA1DB] text-white' : 'bg-[#E5097F] text-white'
                              : 'bg-white/10 text-slate-300 hover:bg-white/20'
                          }`}
                        >
                          {min === 0 ? '0M (EN HORA)' : `+${min}M`}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* SUB-NAVEGACIÓN DE MÓDULOS DEL OPERADOR */}
                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-6">
                    <button
                      type="button"
                      onClick={() => setTabOperador('operaciones')}
                      className={`py-3 px-4 font-condensed text-xs sm:text-sm font-bold uppercase tracking-wider cursor-pointer flex items-center justify-between ${
                        tabOperador === 'operaciones'
                          ? 'bg-[#E5097F] text-white'
                          : 'bg-white/10 text-slate-300 hover:bg-white/20'
                      }`}
                    >
                      <span>1. DESPACHO & FLOTA (60L / HORÓMETRO)</span>
                      <span className="font-mono text-xs bg-black/30 px-2 py-0.5">{motosEnAgua.length} agua</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => setTabOperador('agenda_admin')}
                      className={`py-3 px-4 font-condensed text-xs sm:text-sm font-bold uppercase tracking-wider cursor-pointer flex items-center justify-between ${
                        tabOperador === 'agenda_admin'
                          ? 'bg-[#E5097F] text-white'
                          : 'bg-white/10 text-slate-300 hover:bg-white/20'
                      }`}
                    >
                      <span>2. GESTIÓN DE CITAS & DURACIONES</span>
                      <span className="font-mono text-xs bg-black/30 px-2 py-0.5">{reservasPendientes.length} cola</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => setTabOperador('caja_admin')}
                      className={`py-3 px-4 font-condensed text-xs sm:text-sm font-bold uppercase tracking-wider cursor-pointer flex items-center justify-between ${
                        tabOperador === 'caja_admin'
                          ? 'bg-[#E5097F] text-white'
                          : 'bg-white/10 text-slate-300 hover:bg-white/20'
                      }`}
                    >
                      <span>3. ARQUEO DE CAJA & VUELTOS</span>
                      <span className="font-mono text-xs bg-black/30 px-2 py-0.5">{totalEurosDia}€</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => setTabOperador('waivers_admin')}
                      className={`py-3 px-4 font-condensed text-xs sm:text-sm font-bold uppercase tracking-wider cursor-pointer flex items-center justify-between ${
                        tabOperador === 'waivers_admin'
                          ? 'bg-[#E5097F] text-white'
                          : 'bg-white/10 text-slate-300 hover:bg-white/20'
                      }`}
                    >
                      <span>4. CONTROL DE FIRMAS RECIBIDAS</span>
                      <span className="font-mono text-xs bg-black/30 px-2 py-0.5">{firmasDia.length}</span>
                    </button>
                  </div>
                </div>

                {/* CONTENIDO INTERNO DEL OPERADOR */}
                <div className="p-6 sm:p-10 space-y-8">

                  {/* SUB-MÓDULO 1: CONTROL TÉCNICO DE MOTOS (DESPACHO, RETORNO, HORÓMETRO, GASOLINA, ZONAS Y MANTENIMIENTO) */}
                  {tabOperador === 'operaciones' && (
                    <div className="space-y-8">

                      {/* RADAR DE ZONAS EN VIVO: PLAYA PARGUITO vs SUNSOL ISLA CARIBE + ALERTAS DE MANTENIMIENTO */}
                      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5">
                        {/* ZONA 1: PLAYA PARGUITO (TOLDOS Y MUELLE PRINCIPAL) */}
                        <div className="lg:col-span-4 bg-[#0D1B2A] text-white p-5 border-t-4 border-[#1DA1DB] space-y-3">
                          <div className="flex items-center justify-between border-b border-white/15 pb-2">
                            <div>
                              <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">PUNTO OPERATIVO #1</span>
                              <h3 className="font-condensed text-xl font-bold uppercase text-white">PLAYA PARGUITO (TOLDOS)</h3>
                            </div>
                            <span className="px-2.5 py-1 bg-[#1DA1DB] text-white font-mono text-xs font-bold">
                              {resumenPuntos.parguito.motos.length} MOTOS AQUÍ
                            </span>
                          </div>
                          <div className="space-y-1.5 text-xs font-mono">
                            <div>
                              <span className="text-slate-400">Unidades en este punto: </span>
                              <strong className="text-[#8FD6F2]">
                                {resumenPuntos.parguito.motos.length > 0
                                  ? resumenPuntos.parguito.motos.map(m => `#${m.numero} (${m.estado === 'en_agua' ? 'AGUA' : m.estado === 'disponible' ? 'ORILLA' : 'TALLER'})`).join(' • ')
                                  : 'Ninguna'}
                              </strong>
                            </div>
                            <div>
                              <span className="text-slate-400">Navegando desde Parguito: </span>
                              <strong className="text-white">
                                {resumenPuntos.parguito.enAgua.length > 0
                                  ? resumenPuntos.parguito.enAgua.map(m => `${m.alquiler.cliente} (#${m.numero})`).join(', ')
                                  : '0 en agua'}
                              </strong>
                            </div>
                            <div>
                              <span className="text-slate-400">En cola esperando en Parguito: </span>
                              <strong className="text-[#8FD6F2]">
                                {resumenPuntos.parguito.clientesCola.length > 0
                                  ? resumenPuntos.parguito.clientesCola.slice(0, 3).map(r => `${r.cli} (#${r.motoNum} ${r.horaInicioReal})`).join(' • ')
                                  : 'Sin espera'}
                              </strong>
                            </div>
                          </div>
                        </div>

                        {/* ZONA 2: SUNSOL ISLA CARIBE (FRENTE AL HOTEL) */}
                        <div className="lg:col-span-4 bg-[#0D1B2A] text-white p-5 border-t-4 border-[#8FD6F2] space-y-3">
                          <div className="flex items-center justify-between border-b border-white/15 pb-2">
                            <div>
                              <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">PUNTO OPERATIVO #2</span>
                              <h3 className="font-condensed text-xl font-bold uppercase text-white">SUNSOL ISLA CARIBE</h3>
                            </div>
                            <span className="px-2.5 py-1 bg-[#8FD6F2] text-[#0D1B2A] font-mono text-xs font-bold">
                              {resumenPuntos.sunsol.motos.length} MOTOS AQUÍ
                            </span>
                          </div>
                          <div className="space-y-1.5 text-xs font-mono">
                            <div>
                              <span className="text-slate-400">Unidades en este punto: </span>
                              <strong className="text-[#8FD6F2]">
                                {resumenPuntos.sunsol.motos.length > 0
                                  ? resumenPuntos.sunsol.motos.map(m => `#${m.numero} (${m.estado === 'en_agua' ? 'AGUA' : m.estado === 'disponible' ? 'ORILLA' : 'TALLER'})`).join(' • ')
                                  : 'Ninguna'}
                              </strong>
                            </div>
                            <div>
                              <span className="text-slate-400">Navegando desde Sunsol: </span>
                              <strong className="text-white">
                                {resumenPuntos.sunsol.enAgua.length > 0
                                  ? resumenPuntos.sunsol.enAgua.map(m => `${m.alquiler.cliente} (#${m.numero})`).join(', ')
                                  : '0 en agua'}
                              </strong>
                            </div>
                            <div>
                              <span className="text-slate-400">En cola esperando en Sunsol: </span>
                              <strong className="text-[#8FD6F2]">
                                {resumenPuntos.sunsol.clientesCola.length > 0
                                  ? resumenPuntos.sunsol.clientesCola.slice(0, 3).map(r => `${r.cli} (#${r.motoNum} ${r.horaInicioReal})`).join(' • ')
                                  : 'Sin espera'}
                              </strong>
                            </div>
                          </div>
                        </div>

                        {/* PANEL DE SALUD MECÁNICA Y MANTENIMIENTO DE LAS 3 MOTOS */}
                        <div className="lg:col-span-4 bg-white p-5 border-2 border-slate-300 space-y-2.5 flex flex-col justify-between">
                          <div>
                            <div className="flex items-center justify-between border-b border-slate-200 pb-2">
                              <div>
                                <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">CONTROL MECÁNICO YAMAHA (50H / 60L)</span>
                                <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">ESTADO DE MANTENIMIENTO</h3>
                              </div>
                              <span className={`px-2 py-0.5 font-mono text-[10px] font-bold uppercase ${
                                alertasMantenimiento.length > 0 ? 'bg-[#E5097F] text-white' : 'bg-[#1DA1DB] text-white'
                              }`}>
                                {alertasMantenimiento.length > 0 ? `${alertasMantenimiento.length} ALERTA(S)` : 'FLOTA OK'}
                              </span>
                            </div>
                            <div className="pt-2 space-y-1.5 text-xs font-mono">
                              {motos.map(m => {
                                const srv = estadoServicioMoto(m);
                                return (
                                  <div key={m.id} className="flex items-center justify-between py-1 border-b border-slate-100 last:border-b-0">
                                    <span className="font-bold text-[#0D1B2A]">#{m.numero} ({m.horometro.toFixed(1)}h):</span>
                                    <span className={`px-1.5 py-0.5 text-[10px] font-bold ${
                                      m.estado === 'mantenimiento'
                                        ? 'bg-slate-800 text-[#8FD6F2]'
                                        : srv.vencido
                                        ? 'bg-[#E5097F] text-white'
                                        : srv.proximo
                                        ? 'bg-[#8FD6F2] text-[#0D1B2A]'
                                        : 'bg-slate-100 text-slate-700'
                                    }`}>
                                      {m.estado === 'mantenimiento'
                                        ? 'EN TALLER (CITAS REUBICADAS)'
                                        : `Faltan ${srv.hrsRestantes}h para Serv. 50h`}
                                    </span>
                                  </div>
                                );
                              })}
                            </div>
                          </div>
                          <p className="text-[10px] text-slate-500 font-mono">
                            Si envías 1 moto a Taller, el sistema bloquea su carril y reubica sus reservas pendientes en las otras motos operativas.
                          </p>
                        </div>
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {motos.map(moto => {
                          const enAgua = moto.estado === 'en_agua' && moto.alquiler;
                          const disponible = moto.estado === 'disponible';
                          const taller = moto.estado === 'mantenimiento';
                          const timer = enAgua ? formatCountdown(moto.alquiler.horaRetornoMs) : null;
                          const pctGas = Math.round((moto.gasolinaLts / moto.gasolinaMax) * 100);
                          const srv = estadoServicioMoto(moto);

                          return (
                            <div key={moto.id} className="bg-white border-2 border-slate-300 shadow-sm flex flex-col justify-between">
                              <div>
                                <div className={`px-5 py-3 flex items-center justify-between ${
                                  enAgua ? 'bg-[#E5097F] text-white' : disponible ? 'bg-[#0D1B2A] text-white' : 'bg-slate-300 text-slate-800'
                                }`}>
                                  <div>
                                    <span className="font-condensed text-lg font-bold uppercase block leading-none">
                                      #{moto.numero} • {moto.nombre}
                                    </span>
                                    <span className="font-mono text-[10px] text-[#8FD6F2] uppercase">
                                      BASE ACTUAL: {moto.ubicacion === 'sunsol' ? 'SUNSOL ISLA CARIBE' : 'PLAYA PARGUITO'}
                                    </span>
                                  </div>
                                  <span className="font-mono text-[10px] font-bold uppercase px-2 py-0.5 bg-black/25">
                                    {enAgua ? 'EN AGUA' : disponible ? 'DISPONIBLE' : 'TALLER'}
                                  </span>
                                </div>

                                <div className="p-5 space-y-4">
                                  {/* SELECTOR RÁPIDO DE UBICACIÓN DE LA UNIDAD: PLAYA PARGUITO vs SUNSOL ISLA CARIBE */}
                                  <div className="flex items-center justify-between bg-slate-100 p-2 border border-slate-200 text-xs">
                                    <span className="font-condensed font-bold uppercase text-slate-600 text-[11px]">
                                      Ubicación Unidad #{moto.numero}:
                                    </span>
                                    <div className="flex gap-1">
                                      {[
                                        { id: 'parguito', label: 'Parguito' },
                                        { id: 'sunsol', label: 'Sunsol' }
                                      ].map(ub => (
                                        <button
                                          key={ub.id}
                                          type="button"
                                          onClick={() => handleCambiarUbicacionMoto(moto.numero, ub.id)}
                                          className={`px-2 py-0.5 font-mono text-[10px] font-bold uppercase cursor-pointer ${
                                            moto.ubicacion === ub.id
                                              ? 'bg-[#1DA1DB] text-white'
                                              : 'bg-white text-slate-600 border border-slate-300'
                                          }`}
                                        >
                                          {ub.label}
                                        </button>
                                      ))}
                                    </div>
                                  </div>

                                  {enAgua ? (
                                    <div className="p-4 bg-[#E5097F]/10 border-l-4 border-[#E5097F] space-y-2">
                                      <div className="flex items-center justify-between">
                                        <span className="text-[10px] font-mono uppercase font-bold text-slate-500">CRONÓMETRO REGRESIVO</span>
                                        <button
                                          type="button"
                                          onClick={playWhistle}
                                          className="px-2.5 py-1 bg-[#8FD6F2] text-[#0D1B2A] font-condensed text-xs font-bold uppercase flex items-center gap-1 cursor-pointer"
                                        >
                                          <Icons.Volume className="w-3.5 h-3.5" />
                                          <span>Silbato Fox 40</span>
                                        </button>
                                      </div>
                                      <div className="flex items-baseline justify-between">
                                        <strong className="font-mono text-4xl font-black text-[#E5097F]">{timer.txt}</strong>
                                        <span className="font-mono text-xs font-bold">{moto.alquiler.duracionMin}m ({moto.alquiler.tarifaEUR}€)</span>
                                      </div>
                                      <div className="text-xs pt-2 border-t border-[#E5097F]/25">
                                        <strong className="block text-[#0D1B2A]">Piloto: {moto.alquiler.cliente}</strong>
                                        <span className="text-slate-600">
                                          {moto.alquiler.puntoEmbarque === 'sunsol' ? 'Salió de Sunsol Isla Caribe' : 'Salió de Playa Parguito'} • {moto.alquiler.doc} • Chaleco #{moto.alquiler.chaleco}
                                        </span>
                                      </div>
                                    </div>
                                  ) : disponible ? (
                                    <div className="p-4 bg-[#8FD6F2]/20 border-l-4 border-[#1DA1DB] text-xs">
                                      <strong className="text-[#0D1B2A] block uppercase font-condensed text-sm">
                                        Unidad Lista en {moto.ubicacion === 'sunsol' ? 'Sunsol Isla Caribe' : 'Playa Parguito'}
                                      </strong>
                                      <span className="text-slate-700">Puedes cargar al siguiente cliente de la cola o lanzar directo.</span>
                                    </div>
                                  ) : (
                                    <div className="p-4 bg-slate-100 border-l-4 border-slate-500 text-xs">
                                      <strong className="text-slate-800 block uppercase font-condensed text-sm">En Mantenimiento (Carril Bloqueado)</strong>
                                      <span className="text-slate-600">{moto.motivoTaller}</span>
                                    </div>
                                  )}

                                  {/* CONTROL DE GASOLINA 60L Y HORÓMETRO + SERVICIO 50H */}
                                  <div className="grid grid-cols-2 gap-3 text-xs">
                                    <div className="p-3 bg-slate-50 border border-slate-200">
                                      <div className="flex justify-between items-center">
                                        <span className="font-bold text-slate-500 uppercase text-[10px]">Gasolina</span>
                                        {moto.gasolinaLts < 60 && (
                                          <button
                                            type="button"
                                            onClick={() => handleSurtirTanque(moto.numero)}
                                            className="text-[10px] font-bold text-[#E5097F] underline cursor-pointer"
                                          >
                                            +Surtir 60L
                                          </button>
                                        )}
                                      </div>
                                      <strong className="font-mono text-base block mt-1">{moto.gasolinaLts}L / 60L</strong>
                                      <div className="w-full h-1.5 bg-slate-200 mt-1.5">
                                        <div className={`h-full ${moto.gasolinaLts <= 12 ? 'bg-[#E5097F]' : 'bg-[#1DA1DB]'}`} style={{ width: `${pctGas}%` }}></div>
                                      </div>
                                    </div>

                                    <div className="p-3 bg-slate-50 border border-slate-200">
                                      <div className="flex justify-between items-center">
                                        <span className="font-bold text-slate-500 uppercase text-[10px]">Horómetro</span>
                                        <span className={`text-[9px] font-mono font-bold px-1 ${
                                          srv.vencido ? 'bg-[#E5097F] text-white' : srv.proximo ? 'bg-[#8FD6F2] text-[#0D1B2A]' : 'bg-slate-200 text-slate-700'
                                        }`}>
                                          -{srv.hrsRestantes}h serv.
                                        </span>
                                      </div>
                                      <strong className="font-mono text-base block mt-1">{moto.horometro.toFixed(1)} hrs</strong>
                                      <span className="text-[10px] text-slate-400">Próx. 50h: {srv.proximoServicioHrs}h</span>
                                    </div>
                                  </div>

                                  {/* BOTONES RÁPIDOS DE MANTENIMIENTO PREVENTIVO: SERVICIO 50H Y ENDULZADO */}
                                  <div className="flex items-center justify-between gap-2 pt-1 border-t border-slate-100 text-[10px] font-condensed uppercase">
                                    <button
                                      type="button"
                                      onClick={() => handleRegistrarServicio50h(moto.numero)}
                                      className="flex-1 py-1.5 px-2 bg-slate-100 hover:bg-[#1DA1DB] hover:text-white text-slate-700 font-bold border border-slate-200 cursor-pointer transition-colors"
                                    >
                                      Registrar Servicio 50h (Aceite/Bujías)
                                    </button>
                                    <button
                                      type="button"
                                      onClick={() => handleRegistrarLavadoAguaDulce(moto.numero)}
                                      className="py-1.5 px-2.5 bg-slate-100 hover:bg-[#0D1B2A] hover:text-white text-slate-700 font-bold border border-slate-200 cursor-pointer transition-colors"
                                    >
                                      Endulzado ({moto.ultimoLavadoDulce || 'Hoy'})
                                    </button>
                                  </div>
                                </div>
                              </div>

                              <div className="p-5 pt-0">
                                {disponible && (
                                  <div className="flex gap-2">
                                    <button
                                      type="button"
                                      onClick={() => {
                                        const reservaParaEstaMoto =
                                          reservasPendientes.find(r => r.motoNum === moto.numero) ||
                                          reservasPendientes[0] ||
                                          null;
                                        abrirModalDespacho(
                                          moto,
                                          reservaParaEstaMoto ? reservaParaEstaMoto.slotRef : null,
                                          reservaParaEstaMoto
                                        );
                                      }}
                                      className="flex-1 py-3 bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer"
                                    >
                                      DESPACHAR AL AGUA
                                    </button>
                                    <button
                                      type="button"
                                      onClick={() => handleEnviarMotoATaller(moto.numero, 'Revisión preventiva / turbina')}
                                      className="px-3 py-3 bg-slate-200 text-slate-700 font-condensed text-xs font-bold uppercase cursor-pointer"
                                    >
                                      TALLER
                                    </button>
                                  </div>
                                )}
                                {enAgua && (
                                  <button
                                    type="button"
                                    onClick={() => {
                                      setModalRetornoMoto(moto);
                                      setRetornoPunto(moto.ubicacion || 'parguito');
                                      setInputNuevoHorometro((moto.horometro + (moto.alquiler.duracionMin / 60)).toFixed(1));
                                    }}
                                    className="w-full py-3 bg-[#0D1B2A] hover:bg-black text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer"
                                  >
                                    REGISTRAR RETORNO Y NUEVO HORÓMETRO
                                  </button>
                                )}
                                {taller && (
                                  <button
                                    type="button"
                                    onClick={() => handleHabilitarMotoEnMuelle(moto.numero)}
                                    className="w-full py-3 bg-[#1DA1DB] text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer"
                                  >
                                    HABILITAR UNIDAD EN MUELLE
                                  </button>
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>

                      {/* COLA DE DESPACHO INMEDIATO PARA EL OPERADOR (POR UNIDAD #01, #02, #03) */}
                      <div className="bg-white p-6 border border-slate-300">
                        <div className="flex items-center justify-between pb-4 border-b border-slate-200">
                          <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">
                            PRÓXIMOS CLIENTES EN COLA PARA ABORDAR ({reservasPendientes.length})
                          </h3>
                          <button
                            type="button"
                            onClick={() => setTabOperador('agenda_admin')}
                            className="text-xs font-condensed font-bold uppercase text-[#E5097F] underline cursor-pointer"
                          >
                            Ver / Editar Toda la Agenda (3 Motos por Turno)
                          </button>
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4">
                          {reservasPendientes.slice(0, 6).map((resItem, idx) => {
                            const motoPreferida = motosDisponibles.find(m => m.numero === resItem.motoNum) || motosDisponibles[0];
                            return (
                              <div key={resItem.idReserva || idx} className="p-4 bg-slate-50 border border-slate-200 flex flex-col justify-between gap-3">
                                <div>
                                  <div className="flex justify-between items-center">
                                    <span className="px-2 py-0.5 bg-[#0D1B2A] text-[#8FD6F2] font-mono text-[10px] font-bold">
                                      MOTO #{resItem.motoNum} • {resItem.horaInicioReal}
                                    </span>
                                    <span className={`px-2 py-0.5 font-mono text-[10px] font-bold uppercase ${
                                      resItem.puntoEmbarque === 'sunsol' ? 'bg-[#8FD6F2] text-[#0D1B2A]' : 'bg-[#1DA1DB] text-white'
                                    }`}>
                                      {resItem.puntoEmbarque === 'sunsol' ? 'SUNSOL' : 'PARGUITO'}
                                    </span>
                                  </div>
                                  <div className="flex items-center justify-between mt-2">
                                    <strong className="font-condensed text-base uppercase block">{resItem.cli}</strong>
                                    <strong className="font-mono text-xs text-[#E5097F]">{resItem.duracionMin}m ({resItem.tarifaEUR}€)</strong>
                                  </div>
                                  <span className="text-xs text-slate-500 block">
                                    {resItem.toldo} • {resItem.personas === 2 ? '2 Personas' : '1 Piloto'} • Chaleco #{resItem.chaleco}
                                  </span>
                                </div>

                                <div className="flex gap-2">
                                  {motoPreferida && (
                                    <button
                                      type="button"
                                      onClick={() => abrirModalDespacho(motoPreferida, resItem.slotRef, resItem)}
                                      className="flex-1 py-2 bg-[#E5097F] text-white font-condensed text-xs font-bold uppercase cursor-pointer"
                                    >
                                      LANZAR EN MOTO #{motoPreferida.numero}
                                    </button>
                                  )}
                                  <button
                                    type="button"
                                    onClick={() => handleEliminarCitaSlot(resItem.slotId, resItem.idReserva)}
                                    className="px-3 py-2 bg-[#E5097F]/15 text-[#E5097F] font-condensed text-xs font-bold uppercase cursor-pointer"
                                  >
                                    ELIMINAR
                                  </button>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SUB-MÓDULO 2: ADMINISTRACIÓN COMPLETA DE LA AGENDA (CONTROL DE LAS 3 MOTOS POR HORARIO) */}
                  {tabOperador === 'agenda_admin' && (
                    <div className="space-y-6">
                      {/* RESUMEN SEMANAL DE JORNADA OPERATIVA (VIERNES A DOMINGO) */}
                      <div className="bg-gradient-to-r from-[#0D1B2A] to-[#1E3A8A] text-white p-5 rounded-2xl shadow-lg space-y-4">
                        <div className="flex flex-col md:flex-row md:items-center justify-between gap-3">
                          <div>
                            <div className="flex items-center gap-2">
                              <span className="px-2 py-0.5 rounded bg-[#E5097F] text-white font-condensed text-[10px] font-bold uppercase tracking-widest">
                                PROGRAMACIÓN SEMANAL
                              </span>
                              <span className="text-xs text-[#7DD3FC] font-mono">3 Motos Operativas (#01, #02, #03)</span>
                            </div>
                            <h3 className="font-condensed text-2xl font-bold uppercase mt-1">
                              JORNADA OPERATIVA DE VIERNES A DOMINGO
                            </h3>
                            <p className="text-xs text-white/80">
                              Resumen de citas agendadas, capacidad disponible e ingresos previstos para el fin de semana.
                            </p>
                          </div>

                          {/* Selector rápido de fecha de administración */}
                          <div className="flex items-center gap-1.5 flex-wrap">
                            {[
                              diasOperativos.hoy,
                              diasOperativos.manana,
                              diasOperativos.viernes,
                              diasOperativos.sabado,
                              diasOperativos.domingo
                            ].map(d => {
                              const activo = fechaSeleccionada === d.fecha;
                              return (
                                <button
                                  key={d.id}
                                  type="button"
                                  onClick={() => setFechaSeleccionada(d.fecha)}
                                  className={`px-3 py-1.5 rounded-lg font-condensed text-xs font-bold uppercase cursor-pointer transition-all ${
                                    activo
                                      ? 'bg-[#E5097F] text-white shadow ring-2 ring-white'
                                      : 'bg-white/10 hover:bg-white/20 text-white'
                                  }`}
                                >
                                  {d.etiqueta} ({d.corta.split(' ')[1]} {d.corta.split(' ')[2]})
                                </button>
                              );
                            })}
                            <input
                              type="date"
                              value={fechaSeleccionada}
                              onChange={(e) => e.target.value && setFechaSeleccionada(e.target.value)}
                              className="bg-white/10 hover:bg-white/20 text-white px-2.5 py-1 rounded-lg text-xs font-mono font-bold cursor-pointer outline-none border border-white/20"
                            />
                          </div>
                        </div>

                        {/* 3 Tarjetas de Resumen para Viernes, Sábado y Domingo */}
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-3.5 pt-2">
                          {[
                            { dia: diasOperativos.viernes, borderCol: 'border-[#1DA1DB]' },
                            { dia: diasOperativos.sabado, borderCol: 'border-[#E5097F]' },
                            { dia: diasOperativos.domingo, borderCol: 'border-[#8FD6F2]' }
                          ].map(({ dia, borderCol }) => {
                            const stats = obtenerEstadisticasFecha(dia.fecha);
                            const esSeleccionado = fechaSeleccionada === dia.fecha;
                            return (
                              <div
                                key={dia.id}
                                onClick={() => setFechaSeleccionada(dia.fecha)}
                                className={`p-4 rounded-xl border bg-white/5 backdrop-blur-sm cursor-pointer transition-all ${
                                  esSeleccionado
                                    ? `ring-2 ring-[#E5097F] bg-white/15 shadow-md ${borderCol}`
                                    : 'hover:bg-white/10 border-white/15'
                                }`}
                              >
                                <div className="flex items-center justify-between">
                                  <span className="font-condensed font-bold text-sm uppercase text-[#7DD3FC]">
                                    {dia.nombreDia}
                                  </span>
                                  <span className="text-[11px] font-mono text-white/70">{dia.corta}</span>
                                </div>

                                <div className="mt-2.5 flex items-baseline justify-between">
                                  <div>
                                    <span className="text-2xl font-mono font-black text-white">{stats.totalReservas}</span>
                                    <span className="text-xs text-white/70 ml-1.5 font-condensed uppercase">Paseos Agendados</span>
                                  </div>
                                  <div className="text-right">
                                    <span className="text-base font-mono font-bold text-[#E5097F]">{stats.totalEUR}€</span>
                                    <span className="block text-[10px] font-mono text-white/60">Bs. {stats.totalBs}</span>
                                  </div>
                                </div>

                                <div className="mt-3 pt-2.5 border-t border-white/10 flex items-center justify-between text-[11px] text-white/80">
                                  <span>Motos activas: <strong>{stats.motosConCitas.length > 0 ? stats.motosConCitas.map(n => `#${n}`).join(', ') : 'Libres'}</strong></span>
                                  <span className="text-[#7DD3FC] font-bold">{stats.slotsConDisponibilidad} slots libres</span>
                                </div>

                                <button
                                  type="button"
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    setFechaSeleccionada(dia.fecha);
                                  }}
                                  className={`w-full mt-3 py-1.5 rounded-lg font-condensed text-xs font-bold uppercase transition-all cursor-pointer ${
                                    esSeleccionado
                                      ? 'bg-[#E5097F] text-white'
                                      : 'bg-white/10 hover:bg-white/20 text-white'
                                  }`}
                                >
                                  {esSeleccionado ? 'Mostrando este día' : `Ver Agenda ${dia.nombreDia}`}
                                </button>
                              </div>
                            );
                          })}
                        </div>
                      </div>

                      {/* BARRA DE FILTROS Y CONTROL DE JORNADA */}
                      <div className="bg-white p-5 border border-slate-300 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div className="flex items-center gap-3 flex-wrap">
                          <div className="flex items-center gap-2">
                            {['manana', 'tarde', 'todos'].map(j => (
                              <button
                                key={j}
                                type="button"
                                onClick={() => setFiltroJornada(j)}
                                className={`px-4 py-2 font-condensed text-xs font-bold uppercase cursor-pointer ${
                                  filtroJornada === j ? 'bg-[#E5097F] text-white' : 'bg-slate-100 text-slate-700'
                                }`}
                              >
                                {j === 'manana' ? 'MAÑANA' : j === 'tarde' ? 'TARDE' : 'TODOS LOS HORARIOS'}
                              </button>
                            ))}
                          </div>

                          <div className="px-3 py-1.5 bg-[#F0F9FF] border border-[#BAE6FD] text-[#0284C7] rounded-lg text-xs font-mono font-bold">
                            Viendo: {formatFechaBonita(fechaSeleccionada)} ({obtenerEstadisticasFecha(fechaSeleccionada).totalReservas} reservas)
                          </div>
                        </div>

                        <button
                          type="button"
                          onClick={() => {
                            setModalNuevoHorario(true);
                            setErrorCapitania('');
                          }}
                          className="px-5 py-2.5 bg-[#0D1B2A] text-white font-condensed text-xs font-bold uppercase tracking-wider cursor-pointer"
                        >
                          + AGREGAR HORARIO PERSONALIZADO
                        </button>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        {slots
                          .filter(s => filtroJornada === 'todos' || s.jornada === filtroJornada)
                          .map(slot => {
                            const ev = evaluarEstadoSlot(slot, fechaSeleccionada);
                            return (
                              <div key={slot.id} className="bg-white border border-slate-300 p-4 flex flex-col justify-between space-y-3">
                                <div>
                                  <div className="flex justify-between items-start pb-2 border-b border-slate-200">
                                    <div>
                                      <strong className="font-mono text-lg font-black text-[#0D1B2A]">{ev.horaInicioReal}</strong>
                                      <span className="block text-[10px] font-mono text-slate-400">
                                        Capacidad: {ev.cantOcupadas}/3 ocupadas • {ev.cantLibres}/3 libres
                                      </span>
                                    </div>
                                    <span className={`px-2 py-0.5 text-[10px] font-condensed font-bold uppercase ${
                                      ev.todasOcupadas
                                        ? 'bg-[#E5097F] text-white'
                                        : ev.parcialmenteOcupado
                                        ? 'bg-[#8FD6F2] text-[#0D1B2A]'
                                        : 'bg-[#0D1B2A] text-white'
                                    }`}>
                                      {ev.texto}
                                    </span>
                                  </div>

                                  {/* DETALLE DE LAS 3 UNIDADES (#01, #02, #03) EN ESTE HORARIO */}
                                  <div className="pt-2 space-y-2">
                                    {ev.detalleMotos.map(dm => {
                                      const r = dm.reserva;
                                      const esReservaDeEsteSlot = r && dm.slotOrigenId === slot.id;
                                      const motoDispObj = motosDisponibles.find(m => m.numero === dm.numero) || motosDisponibles[0];

                                      return (
                                        <div
                                          key={dm.numero}
                                          className={`p-2.5 border text-xs ${
                                            dm.disponible
                                              ? 'bg-[#8FD6F2]/15 border-[#1DA1DB]/40'
                                              : dm.estado === 'en_agua'
                                              ? 'bg-[#E5097F]/10 border-[#E5097F]'
                                              : 'bg-slate-50 border-slate-200'
                                          }`}
                                        >
                                          <div className="flex items-center justify-between">
                                            <span className="font-mono text-[10px] font-bold uppercase text-[#0D1B2A]">
                                              MOTO #{dm.numero}
                                            </span>
                                            <span className={`px-1.5 py-0.5 text-[9px] font-condensed font-bold uppercase ${
                                              dm.disponible
                                                ? 'bg-[#1DA1DB] text-white'
                                                : dm.estado === 'en_agua'
                                                ? 'bg-[#E5097F] text-white'
                                                : 'bg-[#0D1B2A] text-[#8FD6F2]'
                                            }`}>
                                              {dm.disponible
                                                ? 'LIBRE'
                                                : dm.estado === 'en_agua'
                                                ? `EN AGUA (${r ? r.duracionMin : 15}M)`
                                                : dm.estado === 'taller'
                                                ? 'EN TALLER'
                                                : `RESERVADA (${r ? r.duracionMin : 15}M)`}
                                            </span>
                                          </div>

                                          {r ? (
                                            <div className="mt-1.5 space-y-1.5">
                                              <div>
                                                <strong className="font-condensed text-sm uppercase block text-[#0D1B2A]">
                                                  {r.cli} {!esReservaDeEsteSlot ? '(Viene de turno anterior)' : ''}
                                                </strong>
                                                <span className="text-[11px] text-slate-500 block">
                                                  {r.toldo} • Chaleco #{r.chaleco} • Se desocupa: <strong className="text-[#E5097F]">{dm.horaSeDesocupa || dm.horaLibreReal}</strong>
                                                </span>
                                              </div>

                                              {r.referenciaPago && (
                                                <div className="flex items-center justify-between gap-1 bg-white px-2 py-1 border border-slate-200 text-[10px] font-mono">
                                                  <span>Ref: <strong>#{r.referenciaPago}</strong></span>
                                                  {r.captureDataUrl ? (
                                                    <button
                                                      type="button"
                                                      onClick={() =>
                                                        setModalVerCapture({
                                                          cliente: r.cli,
                                                          referencia: r.referenciaPago,
                                                          horarioTurno: `${ev.horaInicioReal} (${r.duracionMin}m • Moto #${dm.numero})`,
                                                          montoEUR: r.tarifaEUR,
                                                          captureDataUrl: r.captureDataUrl,
                                                          slotId: dm.slotOrigenId,
                                                          verificado: !!r.pagoVerificado
                                                        })
                                                      }
                                                      className="px-1.5 py-0.5 bg-[#E5097F] text-white font-condensed uppercase font-bold cursor-pointer"
                                                    >
                                                      Ver Capture
                                                    </button>
                                                  ) : (
                                                    <span className="text-[#1DA1DB] font-bold">Registrado</span>
                                                  )}
                                                </div>
                                              )}

                                              {esReservaDeEsteSlot && (
                                                <>
                                                  <div className="grid grid-cols-4 gap-1 pt-0.5">
                                                    {[15, 20, 30, 40].map(m => (
                                                      <button
                                                        key={m}
                                                        type="button"
                                                        onClick={() => handleCambiarDuracionSlot(slot.id, m, r.idReserva)}
                                                        className={`py-0.5 font-mono text-[10px] font-bold border cursor-pointer ${
                                                          r.duracionMin === m
                                                            ? 'bg-[#E5097F] text-white border-[#E5097F]'
                                                            : 'bg-white text-slate-700 border-slate-200'
                                                        }`}
                                                      >
                                                        {m}m
                                                      </button>
                                                    ))}
                                                  </div>

                                                  <div className="flex gap-1 pt-1">
                                                    {dm.estado !== 'en_agua' && !ev.esPasado && motoDispObj && (
                                                      <button
                                                        type="button"
                                                        onClick={() => abrirModalDespacho(motoDispObj, slot, r)}
                                                        className="flex-1 py-1 bg-[#E5097F] text-white font-condensed text-[10px] font-bold uppercase cursor-pointer"
                                                      >
                                                        LANZAR #{dm.numero}
                                                      </button>
                                                    )}
                                                    <button
                                                      type="button"
                                                      onClick={() =>
                                                        setModalTicketDetalle({
                                                          ...slot,
                                                          cli: r.cli,
                                                          toldo: r.toldo,
                                                          chaleco: r.chaleco,
                                                          duracionMin: r.duracionMin,
                                                          tarifaEUR: r.tarifaEUR
                                                        })
                                                      }
                                                      className="px-2 py-1 bg-[#0D1B2A] text-white font-condensed text-[10px] font-bold uppercase cursor-pointer"
                                                    >
                                                      TICKET
                                                    </button>
                                                    <button
                                                      type="button"
                                                      onClick={() => handleEliminarCitaSlot(slot.id, r.idReserva)}
                                                      className="px-2 py-1 bg-[#E5097F]/15 text-[#E5097F] font-condensed text-[10px] font-bold uppercase cursor-pointer"
                                                    >
                                                      BORRAR
                                                    </button>
                                                  </div>
                                                </>
                                              )}
                                            </div>
                                          ) : (
                                            <div className="mt-1 flex items-center justify-between gap-1">
                                              <span className="text-[11px] font-mono text-[#0284C7] font-bold">
                                                {ev.esPasado ? 'Horario concluido' : dm.textoLibre || `Unidad #${dm.numero} disponible`}
                                              </span>
                                              {!ev.esPasado && dm.disponible && (
                                                <button
                                                  type="button"
                                                  onClick={() => {
                                                    setModalReservarSlot(slot);
                                                    setReservaMotoNum(dm.numero);
                                                    setReservaMotosSeleccionadas([dm.numero]);
                                                    setReservaCantidadMotos(1);
                                                    setReservaDuracion(15);
                                                  }}
                                                  className="px-2 py-0.5 bg-[#1DA1DB] text-white font-condensed text-[10px] font-bold uppercase cursor-pointer"
                                                >
                                                  + Agendar #{dm.numero}
                                                </button>
                                              )}
                                            </div>
                                          )}
                                        </div>
                                      );
                                    })}
                                  </div>
                                </div>

                                <div className="pt-2 border-t border-slate-100">
                                  {!ev.esPasado && ev.cantLibres > 0 ? (
                                    <button
                                      type="button"
                                      onClick={() => {
                                        const inicial = ev.motosLibres[0] || '01';
                                        setModalReservarSlot(slot);
                                        setReservaMotoNum(inicial);
                                        setReservaMotosSeleccionadas([inicial]);
                                        setReservaCantidadMotos(1);
                                        setReservaDuracion(15);
                                      }}
                                      className="w-full py-2 bg-[#1DA1DB] hover:bg-[#0D1B2A] text-white font-condensed text-xs font-bold uppercase cursor-pointer"
                                    >
                                      + AGENDAR EN MOTO LIBRE ({ev.motosLibres.map(n => `#${n}`).join(', ')})
                                    </button>
                                  ) : (
                                    <span className="block text-center text-[11px] font-condensed uppercase text-slate-400">
                                      {ev.esPasado ? 'Turno Concluido' : '3/3 Motos Ocupadas en este horario'}
                                    </span>
                                  )}
                                </div>
                              </div>
                            );
                          })}
                      </div>
                    </div>
                  )}

                  {/* SUB-MÓDULO 3: ARQUEO DE CAJA, AJUSTE TASA BCV Y BACKEND DE CAPTURES RECIBIDOS */}
                  {tabOperador === 'caja_admin' && (
                    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                      <div className="lg:col-span-5 bg-white p-6 border border-slate-300 space-y-5">
                        <div className="flex items-center justify-between pb-3 border-b border-slate-200">
                          <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">
                            AJUSTE BCV & CALCULADORA DE VUELTO
                          </h3>
                          <button
                            type="button"
                            onClick={() => setEditandoTasa(!editandoTasa)}
                            className="text-xs font-bold text-[#E5097F] underline cursor-pointer"
                          >
                            {editandoTasa ? 'Cerrar' : `Editar Tasa (${tasaEUR.toFixed(2)})`}
                          </button>
                        </div>

                        {editandoTasa && (
                          <div className="p-3 bg-slate-100 flex items-center justify-between gap-2">
                            <span className="text-xs font-bold">Nueva Tasa Euro BCV:</span>
                            <div className="flex gap-1.5">
                              <input
                                type="number"
                                step="0.01"
                                value={inputTasaManual}
                                onChange={e => setInputTasaManual(e.target.value)}
                                className="w-24 px-2 py-1 border border-slate-400 font-mono text-xs"
                              />
                              <button
                                type="button"
                                onClick={() => {
                                  const v = parseFloat(inputTasaManual);
                                  if (!isNaN(v) && v > 0) setTasaEUR(v);
                                  setEditandoTasa(false);
                                }}
                                className="px-3 py-1 bg-[#E5097F] text-white text-xs font-bold cursor-pointer"
                              >
                                GUARDAR
                              </button>
                            </div>
                          </div>
                        )}

                        <form onSubmit={handleRegistrarCobroManual} className="space-y-4">
                          <div className="grid grid-cols-4 gap-2">
                            {TARIFAS_OFICIALES.map(t => (
                              <button
                                key={t.min}
                                type="button"
                                onClick={() => setCalcDuracion(t.min)}
                                className={`p-2.5 border text-center font-condensed cursor-pointer ${
                                  calcDuracion === t.min ? 'bg-[#E5097F] text-white border-[#E5097F]' : 'bg-slate-50 text-black border-slate-300'
                                }`}
                              >
                                <div className="text-sm font-bold">{t.min}M</div>
                                <div className="text-xs font-mono">{t.eur}€</div>
                              </button>
                            ))}
                          </div>

                          <div className="p-4 bg-[#0D1B2A] text-white flex justify-between items-center">
                            <div>
                              <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">A Cobrar:</span>
                              <strong className="font-mono text-2xl font-black text-[#8FD6F2]">{montoCalculadoraEUR}€</strong>
                            </div>
                            <div className="text-right">
                              <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">En Bolívares BCV:</span>
                              <strong className="font-mono text-xl font-black text-white">Bs. {montoCalculadoraBs.toFixed(2)}</strong>
                            </div>
                          </div>

                          <div>
                            <label className="text-xs font-bold uppercase text-slate-600 block mb-1">
                              Billete entregado por el cliente (€) para calcular vuelto:
                            </label>
                            <input
                              type="number"
                              placeholder="Ej: 50 o 100"
                              value={calcRecibidoEUR}
                              onChange={e => setCalcRecibidoEUR(e.target.value)}
                              className="w-full px-3.5 py-2 border border-slate-300 font-mono text-xs"
                            />
                            {vueltoEUR > 0 && (
                              <div className="mt-2 p-3 bg-[#8FD6F2]/20 border border-[#1DA1DB] text-xs font-mono flex justify-between">
                                <span>Vuelto en €: <strong>{vueltoEUR.toFixed(2)}€</strong></span>
                                <span>Vuelto en Bs: <strong className="text-[#0D1B2A]">Bs. {(vueltoEUR * tasaEUR).toFixed(2)}</strong></span>
                              </div>
                            )}
                          </div>

                          <div className="grid grid-cols-2 gap-2">
                            <input
                              type="text"
                              placeholder="Nombre cliente"
                              value={calcClienteManual}
                              onChange={e => setCalcClienteManual(e.target.value)}
                              className="px-3 py-2 border border-slate-300 text-xs"
                            />
                            <select
                              value={calcMetodoManual}
                              onChange={e => setCalcMetodoManual(e.target.value)}
                              className="px-3 py-2 border border-slate-300 text-xs font-bold bg-white"
                            >
                              <option value="Efectivo €">Efectivo €</option>
                              <option value="Pago Móvil BCV">Pago Móvil BCV</option>
                              <option value="Punto / Tarjeta">Punto / Tarjeta</option>
                            </select>
                          </div>

                          <button
                            type="submit"
                            className="w-full py-3 bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer"
                          >
                            + REGISTRAR COBRO EN CAJA ({montoCalculadoraEUR}€)
                          </button>
                        </form>
                      </div>

                      <div className="lg:col-span-7 bg-white p-6 border border-slate-300 space-y-4">
                        {(() => {
                          const ventasFiltradas = ventasDia.filter(
                            v => filtroFechaCaja === 'todos' || (v.fecha || fechaHoyISO) === filtroFechaCaja
                          );
                          const totalEurosFiltrado = ventasFiltradas.reduce((acc, v) => acc + (v.montoEUR || 0), 0);
                          const totalBsFiltrado = totalEurosFiltrado * tasaEUR;
                          const minutosFiltrados = ventasFiltradas.reduce((acc, v) => acc + (Number(v.duracionMin) || 0), 0);
                          const pendientesFiltrados = ventasFiltradas.filter(v => !v.verificado).length;

                          return (
                            <>
                              <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-200 gap-3">
                                <div>
                                  <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">
                                    BACKEND DE PAGOS, REFERENCIAS Y CAPTURES ({ventasFiltradas.length})
                                  </h3>
                                  <span className="text-xs text-slate-500">
                                    Total navegado/pagado: {minutosFiltrados} min •{' '}
                                    {pendientesFiltrados > 0
                                      ? `${pendientesFiltrados} pago(s) por verificar`
                                      : 'Todos los pagos verificados'}
                                  </span>
                                </div>
                                <div className="text-right font-mono">
                                  <strong className="text-2xl font-black text-[#E5097F] block">{totalEurosFiltrado}€</strong>
                                  <span className="text-xs text-slate-500">Bs. {totalBsFiltrado.toFixed(2)}</span>
                                </div>
                              </div>

                              {/* Filtro por Fecha de Operación */}
                              <div className="flex items-center gap-1.5 flex-wrap bg-[#F8FAFC] p-2 rounded-xl border border-slate-200">
                                <span className="text-[10px] font-mono font-bold text-slate-500 uppercase mr-1">Filtrar:</span>
                                {[
                                  { id: 'todos', etiqueta: 'Todos' },
                                  { id: diasOperativos.hoy.fecha, etiqueta: 'Hoy' },
                                  { id: diasOperativos.manana.fecha, etiqueta: 'Mañana' },
                                  { id: diasOperativos.viernes.fecha, etiqueta: 'Viernes' },
                                  { id: diasOperativos.sabado.fecha, etiqueta: 'Sábado' },
                                  { id: diasOperativos.domingo.fecha, etiqueta: 'Domingo' }
                                ].map(f => {
                                  const activo = filtroFechaCaja === f.id;
                                  return (
                                    <button
                                      key={f.id}
                                      type="button"
                                      onClick={() => setFiltroFechaCaja(f.id)}
                                      className={`px-2.5 py-1 rounded-lg text-xs font-condensed font-bold uppercase transition-all cursor-pointer ${
                                        activo
                                          ? 'bg-[#0D1B2A] text-white shadow'
                                          : 'bg-white border border-slate-300 text-slate-700 hover:border-[#1DA1DB]'
                                      }`}
                                    >
                                      {f.etiqueta}
                                    </button>
                                  );
                                })}
                              </div>

                              <div className="overflow-x-auto">
                                <table className="w-full text-left text-xs">
                                  <thead>
                                    <tr className="border-b border-slate-200 font-mono text-[10px] uppercase text-slate-400">
                                      <th className="py-2">Fecha / Horario</th>
                                      <th className="py-2">Cliente</th>
                                      <th className="py-2">Referencia / Capture</th>
                                      <th className="py-2">Estado</th>
                                      <th className="py-2 text-right">Monto</th>
                                    </tr>
                                  </thead>
                                  <tbody className="divide-y divide-slate-100">
                                    {ventasFiltradas.length === 0 ? (
                                      <tr>
                                        <td colSpan="5" className="py-6 text-center text-slate-400 font-mono">
                                          No hay cobros registrados para esta fecha seleccionada.
                                        </td>
                                      </tr>
                                    ) : (
                                      ventasFiltradas.map(v => (
                                        <tr key={v.id}>
                                          <td className="py-2.5 font-mono text-slate-700">
                                            <span className="inline-block px-1.5 py-0.2 rounded bg-slate-100 text-[#0284C7] text-[9px] font-mono font-bold mb-0.5">
                                              {v.fechaTexto || formatFechaBonita(v.fecha || fechaHoyISO)}
                                            </span>
                                            <strong className="block">{v.horarioTurno || v.hora}</strong>
                                            <span className="text-[10px] text-slate-400">{v.moto} ({v.duracionMin}m)</span>
                                          </td>
                                          <td className="py-2.5">
                                            <strong className="block">{v.cliente}</strong>
                                            <span className="text-[10px] text-slate-400">{v.toldo || 'Muelle'}</span>
                                          </td>
                                          <td className="py-2.5 font-mono">
                                            <span className="block text-[11px] font-bold text-[#0D1B2A]">
                                              {v.metodo} {v.referencia ? `• Ref #${v.referencia}` : ''}
                                            </span>
                                            {v.captureDataUrl ? (
                                              <button
                                                type="button"
                                                onClick={() => setModalVerCapture(v)}
                                                className="mt-1 px-2 py-0.5 bg-[#E5097F] text-white font-condensed text-[10px] uppercase font-bold cursor-pointer inline-flex items-center gap-1"
                                              >
                                                <span>Ver Foto Capture</span>
                                              </button>
                                            ) : (
                                              <span className="text-[10px] text-slate-400">Sin imagen adjunta</span>
                                            )}
                                          </td>
                                          <td className="py-2.5">
                                            <button
                                              type="button"
                                              onClick={() => handleAlternarVerificacionPago(v.id, v.slotId)}
                                              className={`px-2 py-1 font-condensed text-[10px] font-bold uppercase cursor-pointer ${
                                                v.verificado
                                                  ? 'bg-[#8FD6F2]/30 text-[#0D1B2A] border border-[#1DA1DB]'
                                                  : 'bg-[#8FD6F2]/30 text-[#0D1B2A] border border-[#8FD6F2]'
                                              }`}
                                            >
                                              {v.verificado ? '✓ VERIFICADO' : '⏳ PENDIENTE'}
                                            </button>
                                          </td>
                                          <td className="py-2.5 text-right font-mono">
                                            <strong className="text-sm font-bold text-[#0D1B2A] block">{v.montoEUR}€</strong>
                                            <span className="text-[10px] text-slate-400">Bs. {(v.montoEUR * tasaEUR).toFixed(2)}</span>
                                          </td>
                                        </tr>
                                      ))
                                    )}
                                  </tbody>
                                </table>
                              </div>
                            </>
                          );
                        })()}
                      </div>
                    </div>
                  )}

                  {/* SUB-MÓDULO 4: VERIFICACIÓN DE FIRMAS WAIVER RECIBIDAS */}
                  {tabOperador === 'waivers_admin' && (
                    <div className="bg-white p-6 border border-slate-300 space-y-4">
                      <div className="flex items-center justify-between pb-3 border-b border-slate-200">
                        <div>
                          <h3 className="font-condensed text-xl font-bold uppercase text-[#0D1B2A]">
                            CONTRATOS Y CLÁUSULAS FIRMADOS POR CLIENTES ({firmasDia.length})
                          </h3>
                          <p className="text-xs text-slate-500">
                            Cuando un cliente firma desde la Vista Cliente en su teléfono, aparece automáticamente aquí.
                          </p>
                        </div>
                      </div>

                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {firmasDia.map(f => (
                          <div key={f.id} className="p-4 bg-slate-50 border-l-4 border-[#E5097F] flex items-center justify-between">
                            <div>
                              <strong className="font-condensed text-base uppercase block">{f.nombre}</strong>
                              <span className="text-xs font-mono text-slate-500 block">Cédula/Pasaporte: {f.documento}</span>
                              <span className="text-xs font-mono text-slate-400">Tel/Toldo: {f.telefono} • Hora: {f.hora}</span>
                            </div>
                            {f.firmaDataUrl ? (
                              <img src={f.firmaDataUrl} alt="Firma" className="h-12 w-28 object-contain bg-white border border-slate-300 p-1" />
                            ) : (
                              <span className="px-2.5 py-1 bg-[#8FD6F2]/30 text-[#0D1B2A] font-condensed text-xs font-bold uppercase">
                                FIRMA VERIFICADA
                              </span>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                </div>
              </div>
            )}

            {/* =============================================================== */}
            {/* FOOTER PLAYERO CON PIN FUCSIA CENTRAL                           */}
            {/* =============================================================== */}
            <footer className="relative">
              <div className="relative bg-[#0D1B2A] text-white py-12 px-6 text-center overflow-hidden">
                <div
                  className="absolute inset-0 bg-cover bg-center opacity-30"
                  style={{ backgroundImage: "url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80')" }}
                ></div>
                <div className="relative z-10 max-w-xl mx-auto flex flex-col items-center space-y-2">
                  <Icons.LogoDivinaAcuatica className="h-12 sm:h-14 w-auto drop-shadow-xl" />
                  <p className="text-xs text-[#8FD6F2] font-semibold tracking-wider uppercase">
                    Playa Parguito • Muelle frente a Sunsol Isla Caribe • 09:00 AM - 05:00 PM
                  </p>
                </div>
              </div>

              <div className="relative bg-white pt-10 pb-6 px-6 sm:px-14">
                <div className="absolute -top-7 left-1/2 -translate-x-1/2 w-14 h-14 rounded-full bg-[#E5097F] text-white flex items-center justify-center shadow-xl border-4 border-white">
                  <Icons.MapPin className="w-6 h-6" />
                </div>

                <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-center max-w-4xl mx-auto text-xs">
                  <div>
                    <strong className="font-condensed uppercase text-[#0D1B2A] block">SEGURIDAD MARÍTIMA</strong>
                    <span className="text-slate-500">Chalecos Salvavidas & Canal VHF 68</span>
                  </div>
                  <div>
                    <strong className="font-condensed uppercase text-[#0D1B2A] block">TARIFAS EN EUROS (€)</strong>
                    <span className="text-slate-500">15m: 30€ • 20m: 40€ • 30m: 60€ • 40m: 80€</span>
                  </div>
                  <div>
                    <strong className="font-condensed uppercase text-[#0D1B2A] block">UBICACIÓN</strong>
                    <span className="text-slate-500">Playa Parguito, Isla de Margarita</span>
                  </div>
                </div>
              </div>

              <div className="bg-[#E5097F] text-white text-center py-3 px-6 text-[11px] font-condensed uppercase tracking-widest">
                DIVINA ACUÁTICA • SISTEMA SINCRONIZADO A LA HORA OFICIAL DE VENEZUELA (VET UTC-4)
              </div>
            </footer>

          </div>

          {/* ================================================================= */}
          {/* MODALES COMPARTIDOS Y DE OPERADOR                                 */}
          {/* ================================================================= */}
          {modalReservarSlot && (() => {
            const fechaModalActiva = modalFechaReserva || fechaSeleccionada || fechaHoyISO;
            const evModal = evaluarEstadoSlot(modalReservarSlot, fechaModalActiva);
            const motosAptasModal = evModal.detalleMotos
              .filter(d => d.disponible && d.maxMinPosibles >= reservaDuracion)
              .map(d => d.numero);
            const seleccionModal = (reservaMotosSeleccionadas || []).filter(n => motosAptasModal.includes(n));
            const listaMotosModal = seleccionModal.length > 0 ? seleccionModal : motosAptasModal.slice(0, 1);
            const cantSel = Math.max(1, listaMotosModal.length);
            const totalModalEUR = (TARIFAS_MAP[reservaDuracion] || 30) * cantSel;
            const totalModalBs = totalModalEUR * tasaEUR;

            const toggleMotoModal = (numMoto) => {
              if (!motosAptasModal.includes(numMoto)) return;
              setReservaMotosSeleccionadas(prev => {
                const limpias = (prev || []).filter(n => motosAptasModal.includes(n));
                if (cantSel === 1) {
                  setReservaMotoNum(numMoto);
                  return [numMoto];
                }
                if (limpias.includes(numMoto)) {
                  if (limpias.length <= 1) return limpias;
                  const nuevas = limpias.filter(n => n !== numMoto);
                  setReservaCantidadMotos(nuevas.length);
                  setReservaMotoNum(nuevas[0]);
                  return nuevas;
                }
                const nuevas = [...limpias, numMoto].sort();
                setReservaCantidadMotos(nuevas.length);
                setReservaMotoNum(nuevas[0]);
                return nuevas;
              });
            };

            const seleccionarCantidadModal = (n) => {
              const tope = Math.min(n, motosAptasModal.length);
              const nuevas = motosAptasModal.slice(0, tope);
              setReservaMotosSeleccionadas(nuevas);
              setReservaCantidadMotos(nuevas.length);
              if (nuevas[0]) setReservaMotoNum(nuevas[0]);
            };

            return (
              <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
                <div className="bg-white max-w-md w-full p-6 rounded-2xl shadow-2xl border-t-8 border-[#E5097F] relative my-8">
                  <button
                    type="button"
                    onClick={() => setModalReservarSlot(null)}
                    className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                  >
                    <Icons.X className="w-5 h-5" />
                  </button>

                  <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">
                    {modoVista === 'cliente' ? 'RESERVA Y REPORTE DE PAGO DESDE TU TOLDO' : 'AGENDAR TURNO EN MUELLE'}
                  </span>
                  <div className="flex items-center justify-between gap-2">
                    <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A]">
                      HORARIO DE LAS {evModal.horaInicioReal}
                    </h3>
                    <span className="px-2.5 py-1 rounded-full bg-[#E0F2FE] text-[#0284C7] font-condensed text-xs font-bold uppercase">
                      {motosAptasModal.length}/{evModal.motosOperativasTotal} MOTOS LIBRES
                    </span>
                  </div>

                  <form onSubmit={handleGuardarReservaSlot} className="space-y-3.5 mt-3">
                    {/* SELECCIÓN DE FECHA DE LA RESERVA */}
                    <div className="p-3 rounded-xl bg-[#F8FAFC] border border-slate-200 space-y-2">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-bold uppercase text-[#0D1B2A]">
                          Fecha de la Cita:
                        </span>
                        <span className="text-[11px] font-mono font-bold text-[#0284C7]">
                          {formatFechaBonita(fechaModalActiva)}
                        </span>
                      </div>
                      <div className="flex items-center gap-1.5 flex-wrap">
                        {[
                          diasOperativos.hoy,
                          diasOperativos.manana,
                          diasOperativos.viernes,
                          diasOperativos.sabado,
                          diasOperativos.domingo
                        ].map(d => {
                          const activo = fechaModalActiva === d.fecha;
                          return (
                            <button
                              key={d.id}
                              type="button"
                              onClick={() => setModalFechaReserva(d.fecha)}
                              className={`px-2.5 py-1 rounded-lg text-xs font-condensed font-bold uppercase transition-all cursor-pointer ${
                                activo
                                  ? 'bg-[#0D1B2A] text-white shadow ring-2 ring-[#E5097F]'
                                  : 'bg-white border border-slate-300 text-slate-700 hover:border-[#0284C7]'
                              }`}
                            >
                              {d.etiqueta}
                            </button>
                          );
                        })}
                        <input
                          type="date"
                          value={fechaModalActiva}
                          onChange={e => e.target.value && setModalFechaReserva(e.target.value)}
                          className="px-2 py-1 bg-white border border-slate-300 text-xs font-mono font-bold rounded-lg cursor-pointer"
                        />
                      </div>
                    </div>
                    {/* SELECCIÓN DE UNIDAD (#01, #02, #03) Y CANTIDAD DE MOTOS EN ESTE HORARIO */}
                    <div className="p-3 rounded-xl bg-[#F8FAFC] border border-slate-200 space-y-2.5">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-bold uppercase text-[#0D1B2A]">
                          Haz clic en la(s) Moto(s) a Reservar:
                        </span>
                        {motosAptasModal.length > 1 && (
                          <div className="flex items-center gap-1">
                            {[1, 2, 3]
                              .filter(n => n <= motosAptasModal.length)
                              .map(n => (
                                <button
                                  key={n}
                                  type="button"
                                  onClick={() => seleccionarCantidadModal(n)}
                                  className={`px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold cursor-pointer ${
                                    cantSel === n
                                      ? 'bg-[#E5097F] text-white'
                                      : 'bg-white border border-slate-300 text-slate-700'
                                  }`}
                                >
                                  {n} {n === 1 ? 'Moto' : 'Motos'}
                                </button>
                              ))}
                          </div>
                        )}
                      </div>

                      <div className="grid grid-cols-3 gap-2">
                        {evModal.detalleMotos.map(dm => {
                          const esApta = dm.disponible && dm.maxMinPosibles >= reservaDuracion;
                          const seleccionada = esApta && listaMotosModal.includes(dm.numero);
                          return (
                            <button
                              key={dm.numero}
                              type="button"
                              disabled={!esApta}
                              onClick={() => toggleMotoModal(dm.numero)}
                              className={`p-2.5 rounded-lg border text-center font-condensed transition-all ${
                                !esApta
                                  ? 'bg-slate-100 border-slate-200 text-slate-400 cursor-not-allowed'
                                  : seleccionada
                                  ? 'bg-[#0D1B2A] text-white border-[#0D1B2A] ring-2 ring-[#E5097F] shadow cursor-pointer'
                                  : 'bg-white text-[#0D1B2A] border-slate-300 hover:border-[#0284C7] cursor-pointer'
                              }`}
                            >
                              <div className="text-xs font-bold">MOTO #{dm.numero}</div>
                              <div className={`text-[9px] font-mono uppercase mt-0.5 truncate ${
                                seleccionada ? 'text-[#7DD3FC]' : esApta ? 'text-[#0284C7]' : 'text-slate-400'
                              }`}>
                                {!dm.disponible
                                  ? (dm.textoOcupada || 'YA OCUPADA')
                                  : !esApta
                                  ? 'TIEMPO INSUF.'
                                  : seleccionada
                                  ? 'SELECCIONADA'
                                  : (dm.textoLibre || 'LIBRE AHORA')}
                              </div>
                            </button>
                          );
                        })}
                      </div>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                      <div>
                        <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Punto de Embarque *</label>
                        <div className="grid grid-cols-2 gap-1.5">
                          {[
                            { id: 'parguito', label: 'Playa Parguito' },
                            { id: 'sunsol', label: 'Sunsol Caribe' }
                          ].map(p => (
                            <button
                              key={p.id}
                              type="button"
                              onClick={() => setReservaPunto(p.id)}
                              className={`py-2 px-2 rounded-lg text-[11px] font-condensed font-bold uppercase border cursor-pointer ${
                                reservaPunto === p.id
                                  ? 'bg-[#0284C7] text-white border-[#0284C7]'
                                  : 'bg-slate-50 text-slate-700 border-slate-300'
                              }`}
                            >
                              {p.label}
                            </button>
                          ))}
                        </div>
                      </div>

                      <div>
                        <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Ocupantes en la Moto *</label>
                        <div className="grid grid-cols-2 gap-1.5">
                          {[
                            { n: 1, label: '1 Piloto (1 Chaleco)' },
                            { n: 2, label: '2 Pers. (2 Chalecos)' }
                          ].map(oc => (
                            <button
                              key={oc.n}
                              type="button"
                              onClick={() => setReservaPersonas(oc.n)}
                              className={`py-2 px-2 rounded-lg text-[11px] font-condensed font-bold uppercase border cursor-pointer ${
                                reservaPersonas === oc.n
                                  ? 'bg-[#0D1B2A] text-white border-[#0D1B2A]'
                                  : 'bg-slate-50 text-slate-700 border-slate-300'
                              }`}
                            >
                              {oc.label}
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                      <div>
                        <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Tu Nombre y Apellido *</label>
                        <input
                          type="text"
                          required
                          placeholder="Ej: María Pérez"
                          value={reservaNombre}
                          onChange={e => setReservaNombre(e.target.value)}
                          className="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs"
                        />
                      </div>

                      <div>
                        <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Nº de Toldo / Habitación *</label>
                        <input
                          type="text"
                          required
                          placeholder={reservaPunto === 'sunsol' ? 'Ej: Sunsol Hab. 310' : 'Ej: Toldo #14'}
                          value={reservaToldo}
                          onChange={e => setReservaToldo(e.target.value)}
                          className="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs"
                        />
                      </div>
                    </div>

                    <div>
                      <label className="text-xs font-bold uppercase text-slate-600 block mb-1.5">
                        Elige tu Tiempo de Navegación (Bloquea tus minutos sin choques) *
                      </label>
                      <div className="grid grid-cols-4 gap-2">
                        {TARIFAS_OFICIALES.map(t => (
                          <button
                            key={t.min}
                            type="button"
                            onClick={() => setReservaDuracion(t.min)}
                            className={`p-2 rounded-lg border text-center cursor-pointer font-condensed ${
                              reservaDuracion === t.min
                                ? 'bg-[#E5097F] text-white border-[#E5097F]'
                                : 'bg-slate-50 text-[#0D1B2A] border-slate-300'
                            }`}
                          >
                            <div className="text-sm font-bold">{t.min} MIN</div>
                            <div className="text-xs font-mono">{t.eur}€</div>
                          </button>
                        ))}
                      </div>
                    </div>

                    {/* MÉTODO DE PAGO + REFERENCIA + FOTO CAPTURE */}
                    <div className="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-2.5">
                      <div className="flex items-center justify-between">
                        <span className="text-[11px] font-bold uppercase text-slate-700">Método de Pago:</span>
                        <div className="flex gap-1.5">
                          {['Pago Móvil BCV', 'Efectivo €'].map(met => (
                            <button
                              key={met}
                              type="button"
                              onClick={() => setReservaMetodoPago(met)}
                              className={`px-2.5 py-1 rounded-lg text-[11px] font-condensed font-bold uppercase cursor-pointer ${
                                reservaMetodoPago === met
                                  ? 'bg-[#0D1B2A] text-white'
                                  : 'bg-white border border-slate-300 text-slate-600'
                              }`}
                            >
                              {met}
                            </button>
                          ))}
                        </div>
                      </div>

                      {reservaMetodoPago === 'Pago Móvil BCV' && (
                        <div className="space-y-2 pt-1 border-t border-slate-200">
                          <div className="text-[10px] font-mono text-slate-600 bg-white p-2 rounded border border-slate-200">
                            Pago Móvil: <strong>Banesco (0134) / Venezuela (0102)</strong> • CI: <strong>V-18.492.310</strong> • Tel: <strong>0412-8832100</strong>
                          </div>
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                              <label className="text-[10px] font-bold uppercase text-slate-600 block mb-0.5">
                                Nº Referencia Pago Móvil *
                              </label>
                              <input
                                type="text"
                                required
                                placeholder="Ej: 849201"
                                value={reservaReferencia}
                                onChange={e => setReservaReferencia(e.target.value)}
                                className="w-full px-2.5 py-1.5 rounded border border-slate-300 font-mono text-xs bg-white"
                              />
                            </div>
                            <div>
                              <label className="text-[10px] font-bold uppercase text-slate-600 block mb-0.5">
                                Foto Capture (Opcional)
                              </label>
                              <label className="w-full px-2.5 py-1.5 rounded bg-[#0284C7] text-white text-[11px] font-condensed uppercase font-bold flex items-center justify-center gap-1 cursor-pointer">
                                <span className="truncate">
                                  {reservaCaptureNombre ? reservaCaptureNombre : '+ Adjuntar Capture'}
                                </span>
                                <input
                                  type="file"
                                  accept="image/*"
                                  onChange={e => handleSubirArchivoCapture(e, 'modal')}
                                  className="hidden"
                                />
                              </label>
                            </div>
                          </div>
                          {reservaCaptureDataUrl && (
                            <div className="flex items-center gap-2 bg-white p-1.5 rounded border border-[#0284C7]">
                              <img src={reservaCaptureDataUrl} alt="Capture" className="h-10 w-10 object-cover border" />
                              <span className="text-[10px] font-mono text-[#0284C7] font-bold">Capture listo para enviar a Operaciones</span>
                            </div>
                          )}
                        </div>
                      )}
                    </div>

                    <div className="p-3 rounded-xl bg-[#F0F9FF] border-l-4 border-[#0284C7] text-xs font-mono space-y-1">
                      <div className="flex justify-between">
                        <span>Unidades: <strong>{listaMotosModal.map(n => `Moto #${n}`).join(', ')}</strong></span>
                        <strong>
                          {evModal.horaInicioReal} a{' '}
                          {formatMinutesToHora(modalReservarSlot.minDia + retrasoGlobal + reservaDuracion)} ({reservaDuracion}m)
                        </strong>
                      </div>
                      <div className="flex justify-between text-[11px] text-slate-500">
                        <span>Motos que siguen libres a esta hora:</span>
                        <strong>
                          {evModal.cantLibres - cantSel > 0
                            ? `${evModal.cantLibres - cantSel} de ${evModal.motosOperativasTotal} libres`
                            : `3/3 completadas en este horario`}
                        </strong>
                      </div>
                      <div className="flex justify-between pt-1 border-t border-slate-200">
                        <span>Total a Pagar:</span>
                        <strong className="text-[#E5097F]">{totalModalEUR}€ (Bs. {totalModalBs.toFixed(2)})</strong>
                      </div>
                    </div>

                    <button
                      type="submit"
                      className="w-full py-3 rounded-xl bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-sm font-bold uppercase tracking-widest cursor-pointer shadow-md"
                    >
                      CONFIRMAR RESERVA ({listaMotosModal.map(n => `#${n}`).join(', ')} • {totalModalEUR}€)
                    </button>
                  </form>
                </div>
              </div>
            );
          })()}

          {/* MODAL VISOR DE FOTO DEL CAPTURE DE PAGO EN EL BACKEND DE OPERACIONES */}
          {modalVerCapture && (
            <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white max-w-lg w-full p-6 shadow-2xl border-t-8 border-[#E5097F] relative space-y-4">
                <button
                  type="button"
                  onClick={() => setModalVerCapture(null)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                >
                  <Icons.X className="w-5 h-5" />
                </button>

                <div>
                  <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">
                    COMPROBANTE DE PAGO RECIBIDO EN BACKEND DE OPERACIONES
                  </span>
                  <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A]">
                    PILOTO: {modalVerCapture.cliente}
                  </h3>
                  <p className="text-xs font-mono text-slate-600">
                    Referencia: <strong>#{modalVerCapture.referencia}</strong> • Horario Bloqueado: <strong>{modalVerCapture.horarioTurno || modalVerCapture.hora}</strong> • Monto: <strong>{modalVerCapture.montoEUR}€ (Bs. {(modalVerCapture.montoEUR * tasaEUR).toFixed(2)})</strong>
                  </p>
                </div>

                {modalVerCapture.captureDataUrl ? (
                  <div className="bg-[#0D1B2A] p-2 border border-slate-300 flex items-center justify-center max-h-[380px] overflow-auto">
                    <img
                      src={modalVerCapture.captureDataUrl}
                      alt="Capture de Pago Móvil"
                      className="max-h-[350px] w-auto object-contain"
                    />
                  </div>
                ) : (
                  <div className="p-8 bg-slate-100 text-center text-xs text-slate-500">
                    Este registro no tiene imagen de capture adjunta.
                  </div>
                )}

                <div className="flex gap-2">
                  {modalVerCapture.id && (
                    <button
                      type="button"
                      onClick={() => {
                        handleAlternarVerificacionPago(modalVerCapture.id, modalVerCapture.slotId);
                        setModalVerCapture(prev => prev ? { ...prev, verificado: !prev.verificado } : null);
                      }}
                      className={`flex-1 py-3 font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer ${
                        modalVerCapture.verificado
                          ? 'bg-[#1DA1DB] text-white'
                          : 'bg-[#8FD6F2] text-[#0D1B2A]'
                      }`}
                    >
                      {modalVerCapture.verificado ? 'PAGO VERIFICADO EN BANCO' : 'APROBAR Y MARCAR COMO VERIFICADO'}
                    </button>
                  )}
                  <button
                    type="button"
                    onClick={() => setModalVerCapture(null)}
                    className="px-5 py-3 bg-[#0D1B2A] text-white font-condensed text-xs font-bold uppercase cursor-pointer"
                  >
                    CERRAR
                  </button>
                </div>
              </div>
            </div>
          )}

          {modalDespachoMoto && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white max-w-md w-full p-6 shadow-2xl border-t-8 border-[#E5097F] relative">
                <button
                  type="button"
                  onClick={() => setModalDespachoMoto(null)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                >
                  <Icons.X className="w-5 h-5" />
                </button>
                <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">
                  DESPACHO DE UNIDAD AL AGUA
                </span>
                <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A]">
                  MOTO #{modalDespachoMoto.numero} • {modalDespachoMoto.nombre}
                </h3>

                <form onSubmit={handleConfirmarDespachoMoto} className="space-y-4 mt-4">
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Nombre del Piloto *</label>
                    <input
                      type="text"
                      required
                      value={despachoNombre}
                      onChange={e => setDespachoNombre(e.target.value)}
                      className="w-full px-3.5 py-2.5 border border-slate-300 text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Toldo / Documento</label>
                    <input
                      type="text"
                      value={despachoToldo}
                      onChange={e => setDespachoToldo(e.target.value)}
                      className="w-full px-3.5 py-2.5 border border-slate-300 text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Duración y Tarifa *</label>
                    <div className="grid grid-cols-4 gap-2">
                      {TARIFAS_OFICIALES.map(t => (
                        <button
                          key={t.min}
                          type="button"
                          onClick={() => setDespachoDuracion(t.min)}
                          className={`p-2 border text-center font-condensed cursor-pointer ${
                            despachoDuracion === t.min
                              ? 'bg-[#E5097F] text-white border-[#E5097F]'
                              : 'bg-slate-50 text-slate-800 border-slate-300'
                          }`}
                        >
                          <div className="text-sm font-bold">{t.min}M</div>
                          <div className="text-xs font-mono">{t.eur}€</div>
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* CHECKLIST OBLIGATORIO DE SEGURIDAD ANTES DEL ZARPE */}
                  <div className="p-3 bg-[#F2F6FA] border-l-4 border-[#1DA1DB] space-y-1.5">
                    <label className="flex items-start gap-2 text-xs text-[#0D1B2A] cursor-pointer">
                      <input
                        type="checkbox"
                        checked={despachoChecklistSeguridad}
                        onChange={e => setDespachoChecklistSeguridad(e.target.checked)}
                        className="mt-0.5"
                      />
                      <span>
                        <strong>Checklist de Zarpe OK:</strong> Llave cortacorriente (Lanyard) sujeta a la muñeca del piloto, chaleco(s) abrochado(s), canal de boyas explicado y tanque con reserva segura ({modalDespachoMoto.gasolinaLts}L disponibles).
                      </span>
                    </label>
                  </div>

                  <button
                    type="submit"
                    className="w-full py-3 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-sm font-bold uppercase tracking-widest cursor-pointer"
                  >
                    LANZAR AL AGUA ({despachoDuracion} MIN • {TARIFAS_MAP[despachoDuracion]}€)
                  </button>
                </form>
              </div>
            </div>
          )}

          {modalRetornoMoto && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white max-w-sm w-full p-6 shadow-2xl border-t-8 border-[#1DA1DB] relative">
                <button
                  type="button"
                  onClick={() => setModalRetornoMoto(null)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                >
                  <Icons.X className="w-5 h-5" />
                </button>
                <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">
                  CIERRE DE PASEO Y HORÓMETRO
                </span>
                <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A]">
                  MOTO #{modalRetornoMoto.numero}
                </h3>
                <form onSubmit={handleConfirmarRetornoMoto} className="space-y-4 mt-4">
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">
                      Nuevo Horómetro Yamaha (Mín: {modalRetornoMoto.horometro}) *
                    </label>
                    <input
                      type="number"
                      step="0.1"
                      required
                      value={inputNuevoHorometro}
                      onChange={e => setInputNuevoHorometro(e.target.value)}
                      className="w-full px-3.5 py-2.5 border-2 border-[#0D1B2A] font-mono text-lg font-black"
                    />
                  </div>
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">
                      ¿En qué punto quedó fondeada la moto al regresar? *
                    </label>
                    <div className="grid grid-cols-2 gap-2">
                      {[
                        { id: 'parguito', label: 'Playa Parguito' },
                        { id: 'sunsol', label: 'Sunsol Caribe' }
                      ].map(p => (
                        <button
                          key={p.id}
                          type="button"
                          onClick={() => setRetornoPunto(p.id)}
                          className={`py-2 px-2 text-xs font-condensed font-bold uppercase border cursor-pointer ${
                            retornoPunto === p.id
                              ? 'bg-[#1DA1DB] text-white border-[#1DA1DB]'
                              : 'bg-slate-50 text-slate-700 border-slate-300'
                          }`}
                        >
                          {p.label}
                        </button>
                      ))}
                    </div>
                  </div>
                  <button
                    type="submit"
                    className="w-full py-3 rounded-full bg-[#1DA1DB] text-white font-condensed text-sm font-bold uppercase tracking-widest cursor-pointer"
                  >
                    LIBERAR MOTO EN MUELLE
                  </button>
                </form>
              </div>
            </div>
          )}

          {modalTicketDetalle && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white max-w-sm w-full p-6 shadow-2xl border-t-8 border-[#E5097F] relative space-y-4">
                <button
                  type="button"
                  onClick={() => setModalTicketDetalle(null)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                >
                  <Icons.X className="w-5 h-5" />
                </button>
                <div className="text-center">
                  <span className="px-2.5 py-0.5 bg-[#0D1B2A] text-white font-mono text-[10px] uppercase">
                    TICKET #{modalTicketDetalle.id}
                  </span>
                  <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A] mt-2">
                    {modalTicketDetalle.cli}
                  </h3>
                  <p className="text-xs text-slate-500">{modalTicketDetalle.toldo} • Chaleco #{modalTicketDetalle.chaleco}</p>
                </div>
                <div className="p-4 bg-[#0D1B2A] text-white text-center">
                  <span className="text-[10px] font-mono uppercase text-[#8FD6F2] block">SALIDA PROGRAMADA</span>
                  <strong className="font-condensed text-4xl font-bold text-[#8FD6F2] block">
                    {evaluarEstadoSlot(modalTicketDetalle).horaInicioReal}
                  </strong>
                  <span className="text-xs font-mono text-white">
                    {modalTicketDetalle.duracionMin} Minutos ({modalTicketDetalle.tarifaEUR}€) • Retorno {evaluarEstadoSlot(modalTicketDetalle).horaRetornoReal}
                  </span>
                </div>
                <button
                  type="button"
                  onClick={() => {
                    setAlarmaSonando(true);
                    playChimeSound();
                  }}
                  className="w-full py-2.5 rounded-full bg-[#E5097F] text-white font-condensed text-xs font-bold uppercase tracking-widest cursor-pointer"
                >
                  {alarmaSonando ? '¡SONANDO ALARMA 5 MIN ANTES!' : 'PROBAR AUTO-ALARMA DEL CLIENTE'}
                </button>
              </div>
            </div>
          )}

          {modalNuevoHorario && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white max-w-md w-full p-6 shadow-2xl border-t-8 border-[#1DA1DB] relative">
                <button
                  type="button"
                  onClick={() => setModalNuevoHorario(false)}
                  className="absolute top-4 right-4 text-slate-400 hover:text-black cursor-pointer"
                >
                  <Icons.X className="w-5 h-5" />
                </button>
                <span className="text-[10px] font-mono uppercase text-[#E5097F] font-bold block">
                  HORARIO ESPECIAL (09:00 AM - 05:00 PM)
                </span>
                <h3 className="font-condensed text-2xl font-bold uppercase text-[#0D1B2A]">
                  AGREGAR HORA PERSONALIZADA
                </h3>
                <form onSubmit={handleCrearHorarioEspecial} className="space-y-4 mt-4">
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Hora (Ej: 01:15 PM) *</label>
                    <input
                      type="text"
                      required
                      placeholder="Ej: 01:15 PM"
                      value={customHoraInput}
                      onChange={e => {
                        setCustomHoraInput(e.target.value);
                        setErrorCapitania('');
                      }}
                      className="w-full px-3.5 py-2.5 border border-slate-300 font-mono text-xs"
                    />
                  </div>
                  {errorCapitania && (
                    <div className="p-3 bg-[#E5097F]/10 border-l-4 border-[#E5097F] text-xs text-[#0D1B2A]">
                      {errorCapitania}
                    </div>
                  )}
                  <div>
                    <label className="text-xs font-bold uppercase text-slate-600 block mb-1">Cliente (Opcional)</label>
                    <input
                      type="text"
                      placeholder="Nombre del cliente"
                      value={customNombreInput}
                      onChange={e => setCustomNombreInput(e.target.value)}
                      className="w-full px-3.5 py-2.5 border border-slate-300 text-xs"
                    />
                  </div>
                  <button
                    type="submit"
                    className="w-full py-3 rounded-full bg-[#E5097F] hover:bg-[#C8066C] text-white font-condensed text-sm font-bold uppercase tracking-widest cursor-pointer"
                  >
                    GUARDAR HORARIO EN AGENDA
                  </button>
                </form>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
