            { id: 'B-031', fecha: 'Hace 3 semanas', hora: '07:50 AM', tipo: 'SERVICIO REALIZADO', detalle: 'Servicio general: aceite, filtro, ánodos de sacrificio', horometro: 165 }
          ],
          estado: 'disponible',
          motivoTaller: 'Revisión preventiva en muelle',
          alquiler: null
        }
      ];

      return { slotsIniciales, motosIniciales };
    };

    // =========================================================================
    // 4. COMPONENTE PRINCIPAL CON ROLES BIEN SEPARADOS:
    //    - VISTA CLIENTE (La Web Pública estilo "Endless Ride" para el Turista)
    //    - VISTA OPERADOR (Panel de Control Interno del Muelle y Administración)
    // =========================================================================
    function App() {
      const estadoBaseRef = useRef(null);
      if (!estadoBaseRef.current) {
        estadoBaseRef.current = crearEstadoInicialSincronizado();
      }

      // Inicia en 'cliente' o 'operador' y permite alternar arriba
      const [modoVista, setModoVista] = useState('cliente');

      // Sub-pestaña del Panel Operador: 'operaciones' | 'agenda_admin' | 'caja_admin' | 'waivers_admin'
      const [tabOperador, setTabOperador] = useState('operaciones');

      // RELOJ OFICIAL DE VENEZUELA EN VIVO
      const [nowMs, setNowMs] = useState(Date.now());
      const [horaVET, setHoraVET] = useState(() => getHoraTextoVenezuela());
      const [fechaVET, setFechaVET] = useState(() => getFechaTextoVenezuela());
      const [minutosVET, setMinutosVET] = useState(() => getPartesHoraVenezuela().totalMinutos);

      useEffect(() => {
        const interval = setInterval(() => {
          const d = new Date();
          setNowMs(d.getTime());
          setHoraVET(getHoraTextoVenezuela(d));
          setFechaVET(getFechaTextoVenezuela(d));
          setMinutosVET(getPartesHoraVenezuela(d).totalMinutos);
        }, 1000);
        return () => clearInterval(interval);
      }, []);

      // TASA EURO BCV
      const [tasaEUR, setTasaEUR] = useState(49.85);
      const [editandoTasa, setEditandoTasa] = useState(false);
      const [inputTasaManual, setInputTasaManual] = useState('49.85');

      useEffect(() => {
        fetch('https://ve.dolarapi.com/v1/euros/oficial')
          .then(r => r.json())
          .then(data => {
            if (data && data.promedio) {
              const val = Number(data.promedio);
              setTasaEUR(val);
              setInputTasaManual(val.toFixed(2));
            }
          })
          .catch(() => {});
      }, []);

      // GESTIÓN MULTI-DÍA Y FECHAS DE OPERACIÓN (HOY, MAÑANA Y FIN DE SEMANA VIERNES A DOMINGO)
      const fechaHoyISO = getFechaISOVenezuela();
      const diasOperativos = useMemo(() => obtenerDiasOperativos(fechaHoyISO), [fechaHoyISO]);
      const [fechaSeleccionada, setFechaSeleccionada] = useState(fechaHoyISO);
      const [modalFechaReserva, setModalFechaReserva] = useState(fechaHoyISO);
      const [pagoFecha, setPagoFecha] = useState(fechaHoyISO);

      // LAS 3 MOTOS YAMAHA WAVERUNNER Y LA AGENDA SINCRONIZADA (CON PERSISTENCIA BACKEND LOCAL v10 MULTI-DÍA)
      const [motos, setMotos] = useState(() => {
        try {
          const saved = localStorage.getItem('divina_motos_v10');
          if (saved) return JSON.parse(saved).map(normalizarMoto);
        } catch (e) {}
        return estadoBaseRef.current.motosIniciales.map(normalizarMoto);
      });

      // Motos en taller: el motor de horarios deja de asignarles reservas y la capacidad por horario baja automáticamente
      const claveFueraServicio = motos
        .filter(m => m.estado === 'mantenimiento')
        .map(m => m.numero)
        .sort()
        .join(',');
      MOTOS_FUERA_SERVICIO = claveFueraServicio ? claveFueraServicio.split(',') : [];

      const [slots, setSlots] = useState(() => {
        try {
          const saved = localStorage.getItem('divina_slots_v10');
          if (saved) return recalcularHorariosCadena(JSON.parse(saved));
        } catch (e) {}
        return estadoBaseRef.current.slotsIniciales;
      });

      // Cada vez que una moto entra o sale del taller, se recalcula toda la agenda de las 3 unidades
      useEffect(() => {
        setSlots(prev => recalcularHorariosCadena(prev));
      }, [claveFueraServicio]);
      const [retrasoGlobal, setRetrasoGlobal] = useState(0);
      const [motivoRetraso, setMotivoRetraso] = useState('Surtiendo combustible en muelle');
      const [filtroJornada, setFiltroJornada] = useState('todos');
      const [filtroFechaCaja, setFiltroFechaCaja] = useState('todos');

      // VENTAS Y PAGOS RECIBIDOS EN EL BACKEND DE OPERACIONES (CON REFERENCIA, CAPTURE Y FECHA)
      const [ventasDia, setVentasDia] = useState(() => {
        try {
          const saved = localStorage.getItem('divina_ventas_v10');
          if (saved) return JSON.parse(saved);
        } catch (e) {}
        return [
          {
            id: 'V-101',
