<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Divina Acuática • Motos de Agua Playa Parguito | Isla de Margarita</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Fuentes estilo Endless Ride: Oswald (Condensada), Montserrat (Cuerpo), Kaushan Script (Hero) y JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Kaushan+Script&family=Montserrat:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- React 18 & Babel Standalone -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js" crossorigin="anonymous"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Montserrat"', 'sans-serif'],
            condensed: ['"Oswald"', 'sans-serif'],
            script: ['"Kaushan Script"', 'cursive'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              fuchsia: '#E5097F',
              darkfuchsia: '#C8066C',
              ocean: '#1DA1DB',
              lightocean: '#8FD6F2',
              gold: '#8FD6F2',
              charcoal: '#0D1B2A',
              dark: '#07111C',
              light: '#F2F6FA'
            }
          }
        }
      }
    };
  </script>

  <style>
    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #0D1B2A;
      color: #0D1B2A;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    .font-condensed {
      font-family: 'Oswald', sans-serif;
      letter-spacing: 0.02em;
    }
    .font-script {
      font-family: 'Kaushan Script', cursive;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    /* Cortes geométricos diagonales con colores Divina Acuática */
    .hero-red-wedge {
      clip-path: polygon(32% 0, 100% 0, 100% 100%, 82% 100%);
    }
    .hero-bottom-cut {
      clip-path: polygon(0 65%, 55% 0, 100% 60%, 100% 100%, 0 100%);
    }
    .corner-ribbon-red {
      clip-path: polygon(0 0, 0 100%, 100% 100%);
    }
    .touch-canvas {
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
    }
  </style>
</head>
<body class="antialiased selection:bg-[#E5097F] selection:text-white">
  <div id="root"></div>

  <!-- Interceptor de Diagnóstico -->
  <script>
    window.addEventListener('error', function(e) {
      var root = document.getElementById('root');
      if (root && root.innerHTML.trim() === '') {
        var msg = (e.error && e.error.message) || e.message || 'Error al cargar la aplicación.';
        root.innerHTML = '<div style="padding: 24px; background: #FDF2F8; border: 2px solid #E5097F; border-radius: 12px; color: #9D174D; font-family: sans-serif; max-width: 600px; margin: 40px auto;">' +
          '<h3 style="margin-top:0; font-size: 16px; font-weight: 800;">Aviso de Carga en Pantalla:</h3>' +
          '<p style="font-size: 13px; line-height: 1.5; font-family: monospace;">' + msg + '</p>' +
          '<button onclick="location.reload()" style="margin-top: 10px; padding: 8px 16px; background: #E5097F; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Recargar</button>' +
        '</div>';
      }
    });
  </script>

  <script type="text/babel">
    const { useState, useEffect, useRef, useMemo } = React;

    // =========================================================================
    // 1. SONIDOS NÁUTICOS (SILBATO FOX 40 OPERADOR & ALARMA DE CLIENTE)
    // =========================================================================
    const playWhistle = () => {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const blast = (delay) => {
          const osc1 = ctx.createOscillator();
          const osc2 = ctx.createOscillator();
          const gain = ctx.createGain();
          osc1.type = 'triangle';
          osc2.type = 'sawtooth';
          osc1.frequency.setValueAtTime(2750, ctx.currentTime + delay);
          osc2.frequency.setValueAtTime(2980, ctx.currentTime + delay);
          gain.gain.setValueAtTime(0, ctx.currentTime + delay);
          gain.gain.linearRampToValueAtTime(0.28, ctx.currentTime + delay + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + 0.35);
          osc1.connect(gain);
          osc2.connect(gain);
          gain.connect(ctx.destination);
          osc1.start(ctx.currentTime + delay);
          osc2.start(ctx.currentTime + delay);
          osc1.stop(ctx.currentTime + delay + 0.35);
          osc2.stop(ctx.currentTime + delay + 0.35);
        };
        blast(0);
        blast(0.38);
      } catch (e) {}
    };

    const playChimeSound = () => {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const chime = (freq, start, dur) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, ctx.currentTime + start);
          gain.gain.setValueAtTime(0, ctx.currentTime + start);
          gain.gain.linearRampToValueAtTime(0.3, ctx.currentTime + start + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + start + dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + start);
          osc.stop(ctx.currentTime + start + dur);
        };
        chime(587.33, 0, 0.35);
        chime(880.00, 0.22, 0.65);
      } catch (e) {}
    };

    // =========================================================================
    // 2. VECTORES SVG PUROS (CERO EMOJIS + ILUSTRACIONES WAVERUNNER)
    // =========================================================================
    const Icons = {
