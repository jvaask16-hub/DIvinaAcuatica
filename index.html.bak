            chaleco: '04',
            horaRetornoMs: Date.now() + msRestantes
          }
        },
        {
          id: 'yamaha-02',
          numero: '02',
          nombre: 'YAMAHA FX CRUISER HO',
          subtitulo: 'LUXURY CRUISING • 180 HP',
          descripcionCliente: 'Máxima estabilidad y asiento ergonómico tipo crucero, ideal para pasear en pareja o familia con total suavidad.',
          imagen: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80',
          capacidad: '1 a 2 Personas (Chalecos incluidos)',
          gasolinaLts: 60,
          gasolinaMax: 60,
          horometro: 89.6,
          horometroUltimoServicio: 50,
          intervaloServicioHrs: INTERVALO_SERVICIO_HRS,
          ubicacion: 'sunsol',
          bitacoraMantenimiento: [
            { id: 'B-021', fecha: 'Hace 2 semanas', hora: '08:10 AM', tipo: 'SERVICIO REALIZADO', detalle: 'Servicio 50 hrs: aceite, filtro y lavado de turbina con agua dulce', horometro: 50 }
          ],
          estado: 'disponible',
          alquiler: null
        },
        {
          id: 'yamaha-03',
