    };

    // =========================================================================
    // 3. HORA OFICIAL DE VENEZUELA (VET UTC-4) Y MOTOR DE AGENDA
    // =========================================================================
    const getPartesHoraVenezuela = (d = new Date()) => {
      try {
        const fmt = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Caracas',
          hour12: false,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit'
        });
        const parts = fmt.formatToParts(d);
        let h = parseInt(parts.find(p => p.type === 'hour')?.value || '0', 10);
        if (h === 24) h = 0;
        const m = parseInt(parts.find(p => p.type === 'minute')?.value || '0', 10);
        const s = parseInt(parts.find(p => p.type === 'second')?.value || '0', 10);
        return { h, m, s, totalMinutos: h * 60 + m };
      } catch (e) {
        return { h: d.getHours(), m: d.getMinutes(), s: d.getSeconds(), totalMinutos: d.getHours() * 60 + d.getMinutes() };
      }
    };

    const getHoraTextoVenezuela = (d = new Date()) => {
      try {
        return new Intl.DateTimeFormat('es-VE', {
          timeZone: 'America/Caracas',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: true
        }).format(d).toUpperCase();
      } catch (e) {
        return d.toLocaleTimeString();
      }
    };

    const getFechaTextoVenezuela = (d = new Date()) => {
      try {
        return new Intl.DateTimeFormat('es-VE', {
          timeZone: 'America/Caracas',
          weekday: 'short',
          day: 'numeric',
          month: 'short'
        }).format(d);
      } catch (e) {
        return '';
      }
    };

    // Fecha ISO 'YYYY-MM-DD' en zona horaria oficial de Venezuela (America/Caracas)
    const getFechaISOVenezuela = (d = new Date()) => {
      try {
        const formatter = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Caracas',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        });
        return formatter.format(d);
      } catch (e) {
        const pad = (n) => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      }
    };

    // Suma o resta días a una fecha ISO 'YYYY-MM-DD'
    const sumarDiasISO = (fechaISO, dias) => {
      try {
        const [y, m, d] = (fechaISO || getFechaISOVenezuela()).split('-').map(Number);
        const date = new Date(Date.UTC(y, m - 1, d + dias, 12, 0, 0));
        const pad = (n) => String(n).padStart(2, '0');
        return `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
      } catch (e) {
        return fechaISO;
      }
    };

    // Formatea fecha ISO a texto limpio en español: ej: "Viernes 23 Oct"
    const formatFechaBonita = (fechaISO) => {
      if (!fechaISO) return '';
      try {
        const [y, m, d] = fechaISO.split('-').map(Number);
        const date = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
        const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
        const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
        return `${dias[date.getUTCDay()]} ${d} ${meses[date.getUTCMonth()]}`;
      } catch (e) {
        return fechaISO;
      }
    };

    // Devuelve los días operativos clave relativos a la fecha de consulta:
    // Hoy, Mañana, y la jornada semanal de fin de semana (Viernes, Sábado y Domingo)
    const obtenerDiasOperativos = (fechaHoyISO = getFechaISOVenezuela()) => {
      const [y, m, d] = fechaHoyISO.split('-').map(Number);
      const dt = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
      const dow = dt.getUTCDay(); // 0: Dom, 1: Lun, 2: Mar, 3: Mie, 4: Jue, 5: Vie, 6: Sab

      let diffVie = 5 - dow;
      if (dow === 0) diffVie = -2;
      else if (dow === 6) diffVie = -1;

      const fechaVie = sumarDiasISO(fechaHoyISO, diffVie);
      const fechaSab = sumarDiasISO(fechaVie, 1);
      const fechaDom = sumarDiasISO(fechaVie, 2);
      const fechaManana = sumarDiasISO(fechaHoyISO, 1);

      return {
        hoy: { id: 'hoy', fecha: fechaHoyISO, etiqueta: 'Hoy', nombreDia: 'Hoy', corta: formatFechaBonita(fechaHoyISO) },
        manana: { id: 'manana', fecha: fechaManana, etiqueta: 'Mañana', nombreDia: 'Mañana', corta: formatFechaBonita(fechaManana) },
        viernes: { id: 'viernes', fecha: fechaVie, etiqueta: 'Viernes', nombreDia: 'Viernes', corta: formatFechaBonita(fechaVie) },
        sabado: { id: 'sabado', fecha: fechaSab, etiqueta: 'Sábado', nombreDia: 'Sábado', corta: formatFechaBonita(fechaSab) },
        domingo: { id: 'domingo', fecha: fechaDom, etiqueta: 'Domingo', nombreDia: 'Domingo', corta: formatFechaBonita(fechaDom) }
      };
    };

    const formatMinutesToHora = (min) => {
      const cleanMin = Math.max(0, Math.round(min));
      let h = Math.floor(cleanMin / 60) % 24;
      const m = cleanMin % 60;
      const ampm = h >= 12 ? 'PM' : 'AM';
      if (h === 0) h = 12;
      else if (h > 12) h -= 12;
      return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')} ${ampm}`;
    };

    const parseHoraToMinutes = (horaStr) => {
      if (!horaStr) return 0;
      const upper = horaStr.toUpperCase().trim();
      const m12 = upper.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/);
      const m24 = upper.match(/^(\d{1,2}):(\d{2})$/);
      let h = 0, m = 0;
      if (m12) {
        h = parseInt(m12[1], 10);
        m = parseInt(m12[2], 10);
        if (m12[3] === 'PM' && h < 12) h += 12;
        if (m12[3] === 'AM' && h === 12) h = 0;
      } else if (m24) {
        h = parseInt(m24[1], 10);
        m = parseInt(m24[2], 10);
      }
      return h * 60 + m;
    };

    const TARIFAS_OFICIALES = [
      { min: 15, eur: 30, gasLts: 4, label: '15 MIN', desc: 'Sprint Costero' },
      { min: 20, eur: 40, gasLts: 5, label: '20 MIN', desc: 'Paseo Estándar' },
      { min: 30, eur: 60, gasLts: 8, label: '30 MIN', desc: 'Aventura Media' },
      { min: 40, eur: 80, gasLts: 10, label: '40 MIN', desc: 'Tour Completo' }
    ];

    const TARIFAS_MAP = { 15: 30, 20: 40, 30: 60, 40: 80 };
    const GAS_MAP = { 15: 4, 20: 5, 30: 8, 40: 10 };
    const TIEMPO_MUELLE_CAMBIO = 5;
    const UNIDADES_FLOTA = ['01', '02', '03'];

    // PUNTOS DE OPERACIÓN: dónde está estacionada cada moto y dónde espera cada cliente
    const PUNTOS_OPERACION = {
      parguito: { id: 'parguito', nombre: 'Playa Parguito', corto: 'PARGUITO', detalle: 'Muelle principal en la orilla de Playa Parguito' },
      sunsol: { id: 'sunsol', nombre: 'Sunsol Isla Caribe', corto: 'SUNSOL', detalle: 'Punto de embarque frente al Hotel Sunsol Isla Caribe' }
    };
    const LISTA_PUNTOS = Object.values(PUNTOS_OPERACION);
    const nombrePunto = (id) => (PUNTOS_OPERACION[id] ? PUNTOS_OPERACION[id].nombre : 'Playa Parguito');

    // MANTENIMIENTO PREVENTIVO YAMAHA: servicio cada 50 horas de motor + reserva mínima de gasolina
    const INTERVALO_SERVICIO_HRS = 50;
    const RESERVA_GAS_MIN_LTS = 6;

    // Motos fuera de servicio (taller): el motor de horarios NO les asigna reservas nuevas.
    // Se actualiza en cada render del componente principal a partir del estado de las motos.
    let MOTOS_FUERA_SERVICIO = [];

    const normalizarMoto = (m) => ({
      ubicacion: 'parguito',
      horometroUltimoServicio: Math.floor((Number(m.horometro) || 0) / INTERVALO_SERVICIO_HRS) * INTERVALO_SERVICIO_HRS,
      intervaloServicioHrs: INTERVALO_SERVICIO_HRS,
      bitacoraMantenimiento: [],
      ...m
    });

    const estadoServicioMoto = (m) => {
      const intervalo = m.intervaloServicioHrs || INTERVALO_SERVICIO_HRS;
      const usadas = Math.max(0, (Number(m.horometro) || 0) - (Number(m.horometroUltimoServicio) || 0));
      const restantes = Number((intervalo - usadas).toFixed(1));
      const nivel = restantes <= 0 ? 'vencido' : restantes <= 5 ? 'proximo' : 'ok';
      return {
        intervalo,
        usadas: Number(usadas.toFixed(1)),
        restantes,
        nivel,
        pct: Math.min(100, Math.round((usadas / intervalo) * 100)),
        proximoEn: Number(((Number(m.horometroUltimoServicio) || 0) + intervalo).toFixed(1))
      };
    };

    // Normaliza cualquier turno para trabajar siempre con las 3 motos independientes (reservas por unidad #01, #02, #03)
    // Cada reserva guarda su fecha ('YYYY-MM-DD') para soportar programación de hoy, mañana y fin de semana
    const normalizarReservasDeSlot = (slot) => {
      const fechaBase = slot.fecha || getFechaISOVenezuela();
      if (Array.isArray(slot.reservas) && slot.reservas.length > 0) {
        return slot.reservas.map((r, idx) => ({
          ...r,
          fecha: r.fecha || fechaBase,
          idReserva: r.idReserva || `${slot.id}-M${r.motoNum || UNIDADES_FLOTA[idx] || '01'}`,
          motoNum: UNIDADES_FLOTA.includes(r.motoNum) ? r.motoNum : (UNIDADES_FLOTA[idx] || '01'),
          cli: r.cli,
          toldo: r.toldo || 'Toldo Playa',
          chaleco: r.chaleco || ('0' + ((idx % 8) + 1)),
          duracionMin: Number(r.duracionMin) || 15,
          tarifaEUR: TARIFAS_MAP[Number(r.duracionMin) || 15] || 30,
          metodoPago: r.metodoPago || 'Pago Móvil BCV',
          referenciaPago: r.referenciaPago || '',
          captureDataUrl: r.captureDataUrl || null,
          pagoVerificado: !!r.pagoVerificado,
          despachado: !!r.despachado,
          puntoEmbarque: r.puntoEmbarque || 'parguito',
          personas: Number(r.personas) || 1
        }));
      }
      if (slot.cli) {
        const dur = Number(slot.duracionMin) || 15;
        const motoLim = UNIDADES_FLOTA.includes(slot.motoAsignada) ? slot.motoAsignada : '01';
        return [
          {
            fecha: slot.fecha || fechaBase,
            idReserva: `${slot.id}-M${motoLim}`,
            motoNum: motoLim,
            cli: slot.cli,
            toldo: slot.toldo || 'Toldo Playa',
            chaleco: slot.chaleco || '01',
            duracionMin: dur,
            tarifaEUR: TARIFAS_MAP[dur] || 30,
            metodoPago: slot.metodoPago || 'Pago Móvil BCV',
            referenciaPago: slot.referenciaPago || '',
            captureDataUrl: slot.captureDataUrl || null,
            pagoVerificado: !!slot.pagoVerificado,
            despachado: !!slot.despachado,
            puntoEmbarque: slot.puntoEmbarque || 'parguito',
            personas: 1
          }
        ];
      }
      return [];
    };

    // Motor de Horarios Multicanal para las 3 Motos (#01, #02 y #03):
    // - Si 1 o 2 motos se alquilan a una hora, las otras 2 siguen libres en ese horario.
    // - Es multi-fecha: las reservas agendadas para el fin de semana (Viernes a Domingo)
    //   no chocan con los horarios de hoy ni de otros días.
    const recalcularHorariosCadena = (listaSlots) => {
      const fueraServicio = new Set(MOTOS_FUERA_SERVICIO);
      const ocupacionPorFechaYMoto = {};

      // Ordenamos los bloques por su hora fija (minFijo) o su secuencia natural cada 20 minutos
      const ordenados = [...listaSlots]
        .map((s, idx) => {
          const minBase =
            s.minFijo !== undefined
              ? s.minFijo
              : s.minDia !== undefined
              ? s.minDia
              : s.jornada === 'manana'
              ? 580 + idx * 20
              : 820 + Math.max(0, idx - 8) * 20;
          return {
            ...s,
            minBase,
            reservas: normalizarReservasDeSlot(s)
          };
        })
        .sort((a, b) => a.minBase - b.minBase || (a.orden || 0) - (b.orden || 0));

      const motoOcupadaEnRango = (fecha, numMoto, ini, fin) => {
        const clave = `${fecha}_${numMoto}`;
        return (ocupacionPorFechaYMoto[clave] || []).some(rango => ini < rango.fin && fin > rango.ini);
      };

      const resultado = ordenados.map((slot, idxGlobal) => {
        const minInicio = slot.minBase;
        const usadasPorFecha = {};

        const reservasCalculadas = (slot.reservas || []).map((r) => {
          const fechaR = r.fecha || getFechaISOVenezuela();
          if (!usadasPorFecha[fechaR]) usadasPorFecha[fechaR] = new Set();
          const usadasSet = usadasPorFecha[fechaR];

          const dur = Number(r.duracionMin) || 15;
          // Duración exacta del paseo en el agua: 15m termina en +15, 20m en +20, 30m en +30, 40m en +40
          const finAgua = minInicio + dur;
          const finMuelle = minInicio + dur;

          let motoNum = UNIDADES_FLOTA.includes(r.motoNum) ? r.motoNum : '01';
          if (
            !r.despachado &&
            (usadasSet.has(motoNum) ||
              fueraServicio.has(motoNum) ||
              motoOcupadaEnRango(fechaR, motoNum, minInicio, finMuelle))
          ) {
            const candidatas = UNIDADES_FLOTA.filter(
              num => !usadasSet.has(num) && !fueraServicio.has(num) && !motoOcupadaEnRango(fechaR, num, minInicio, finMuelle)
            );
            if (candidatas.length > 0) {
              motoNum = candidatas[0];
            }
          }

          usadasSet.add(motoNum);
          const claveOcup = `${fechaR}_${motoNum}`;
          if (!ocupacionPorFechaYMoto[claveOcup]) ocupacionPorFechaYMoto[claveOcup] = [];
          ocupacionPorFechaYMoto[claveOcup].push({ ini: minInicio, fin: finMuelle, slotId: slot.id, duracionMin: dur });

          return {
            ...r,
            fecha: fechaR,
            idReserva: r.idReserva || `${slot.id}-M${motoNum}`,
            motoNum,
            conflictoTaller: !r.despachado && fueraServicio.has(motoNum),
            duracionMin: dur,
            tarifaEUR: TARIFAS_MAP[dur] || 30,
            minInicio,
            finAguaMin: finAgua,
            finMuelleMin: finMuelle,
            horaInicio: formatMinutesToHora(minInicio),
            horaRetornoAgua: formatMinutesToHora(finAgua),
            horaMuelleLibre: formatMinutesToHora(finMuelle)
          };
        });

        const durMaxSlot =
          reservasCalculadas.length > 0
            ? Math.max(...reservasCalculadas.map(r => r.duracionMin))
            : 15;
        const finAguaSlot = minInicio + durMaxSlot;
        const finMuelleSlot = minInicio + durMaxSlot;
        const primeraRes = reservasCalculadas[0] || null;

        return {
          ...slot,
          orden: idxGlobal + 1,
          jornada: minInicio < 780 ? 'manana' : 'tarde',
          minFijo: minInicio,
          reservas: reservasCalculadas,
          cli: primeraRes ? primeraRes.cli : undefined,
          toldo: primeraRes ? primeraRes.toldo : undefined,
          chaleco: primeraRes ? primeraRes.chaleco : undefined,
          motoAsignada: primeraRes ? primeraRes.motoNum : undefined,
          referenciaPago: primeraRes ? primeraRes.referenciaPago : undefined,
          captureDataUrl: primeraRes ? primeraRes.captureDataUrl : undefined,
          metodoPago: primeraRes ? primeraRes.metodoPago : undefined,
          pagoVerificado: primeraRes ? primeraRes.pagoVerificado : undefined,
          despachado: reservasCalculadas.some(r => r.despachado),
          minDia: minInicio,
          duracionMin: durMaxSlot,
          tarifaEUR: reservasCalculadas.reduce((acc, r) => acc + (r.tarifaEUR || 30), 0) || 30,
          hora: formatMinutesToHora(minInicio),
          horaRetornoAgua: formatMinutesToHora(finAguaSlot),
          horaMuelleLibre: formatMinutesToHora(finMuelleSlot),
          finAguaMin: finAguaSlot,
          finMuelleMin: finMuelleSlot
        };
      });

      return resultado;
    };

    const crearEstadoInicialSincronizado = () => {
      const mActual = getPartesHoraVenezuela().totalMinutos;
      const fechaHoyISO = getFechaISOVenezuela();
      const diasOper = obtenerDiasOperativos(fechaHoyISO);
      const fechaVie = diasOper.viernes.fecha;
      const fechaSab = diasOper.sabado.fecha;
      const fechaDom = diasOper.domingo.fecha;

      // Grilla limpia cada 20 minutos desde las 09:40 AM hasta las 04:40 PM (22 bloques horarios en el día)
      const tiemposGrilla = [
        580, 600, 620, 640, 660, 680, 700, 720, 740, 760, // 09:40 AM - 12:40 PM
        780, 800, 820, 840, 860, 880, 900, 920, 940, 960, 980, 1000 // 01:00 PM - 04:40 PM
      ];

      // Identificamos el bloque actual o inmediatamente siguiente a la hora de Venezuela para mostrar 1 moto en el agua y 2 libres
      const minBloqueActivo =
        tiemposGrilla.find(t => t + 20 > mActual && t <= mActual + 20) ||
        tiemposGrilla.find(t => t >= mActual) ||
        820;

      const base = tiemposGrilla.map((minT, i) => {
        const idSlot = minT < 780 ? `TK-1${String(i + 1).padStart(2, '0')}` : `TK-2${String(i - 9).padStart(2, '0')}`;
        const jornadaSlot = minT < 780 ? 'manana' : 'tarde';
        const listaReservas = [];

        // --- RESERVAS DE HOY (EN VIVO) ---
        if (minT === 580) {
          listaReservas.push({
            idReserva: `${idSlot}-M01-HOY`,
            fecha: fechaHoyISO,
            motoNum: '01',
            cli: 'Ricardo Valera',
            toldo: 'Toldo #02 Sunsol',
            chaleco: '01',
            duracionMin: 15,
            tarifaEUR: 30,
            metodoPago: 'Efectivo €',
            referenciaPago: 'EFECTIVO-MUELLE',
            puntoEmbarque: 'sunsol',
            personas: 2,
            pagoVerificado: true,
            despachado: true
          });
        }

        if (minT === 620) {
          listaReservas.push({
            idReserva: `${idSlot}-M01-HOY`,
            fecha: fechaHoyISO,
            motoNum: '01',
            cli: 'Carlos A. Mendoza',
            toldo: 'Churuata Central Sunsol',
            chaleco: '03',
            duracionMin: 20,
            tarifaEUR: 40,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '849201',
            puntoEmbarque: 'sunsol',
            personas: 1,
            pagoVerificado: true,
            despachado: true
          });
        }

        if (minT === minBloqueActivo) {
          listaReservas.push({
            idReserva: `${idSlot}-M01-ACTIVO`,
            fecha: fechaHoyISO,
            motoNum: '01',
            cli: 'Alejandro Carrillo',
            toldo: 'Toldo VIP #09',
            chaleco: '04',
            duracionMin: 15,
            tarifaEUR: 30,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '910442',
            puntoEmbarque: 'parguito',
            personas: 1,
            pagoVerificado: true,
            despachado: true
          });
        }

        // --- CITAS AGENDADAS PARA EL FIN DE SEMANA OPERATIVO (VIERNES, SÁBADO Y DOMINGO) ---
        // VIERNES: Mariana Rivas (10:00 AM), Grupo Sunsol (11:40 AM, 2 motos), Leonardo Bracho (02:40 PM)
        if (minT === 600) {
          listaReservas.push({
            idReserva: `${idSlot}-M02-VIE`,
            fecha: fechaVie,
            motoNum: '02',
            cli: 'Mariana Rivas',
            toldo: 'Habitación #314 Sunsol',
            chaleco: '02',
            duracionMin: 20,
            tarifaEUR: 40,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '772109',
            puntoEmbarque: 'sunsol',
            personas: 2,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 700) {
          listaReservas.push(
            {
              idReserva: `${idSlot}-M01-VIE`,
              fecha: fechaVie,
              motoNum: '01',
              cli: 'Grupo Hotel Sunsol (M01)',
              toldo: 'Churuata Principal Sunsol',
              chaleco: '05',
              duracionMin: 30,
              tarifaEUR: 60,
              metodoPago: 'Efectivo €',
              referenciaPago: 'RECEPCION-HOTEL',
              puntoEmbarque: 'sunsol',
              personas: 2,
              pagoVerificado: true,
              despachado: false
            },
            {
              idReserva: `${idSlot}-M02-VIE`,
              fecha: fechaVie,
              motoNum: '02',
              cli: 'Grupo Hotel Sunsol (M02)',
              toldo: 'Churuata Principal Sunsol',
              chaleco: '06',
              duracionMin: 30,
              tarifaEUR: 60,
              metodoPago: 'Efectivo €',
              referenciaPago: 'RECEPCION-HOTEL',
              puntoEmbarque: 'sunsol',
              personas: 2,
              pagoVerificado: true,
              despachado: false
            }
          );
        }
        if (minT === 880) {
          listaReservas.push({
            idReserva: `${idSlot}-M03-VIE`,
            fecha: fechaVie,
            motoNum: '03',
            cli: 'Leonardo Bracho',
            toldo: 'Toldo Playa #12 Parguito',
            chaleco: '07',
            duracionMin: 40,
            tarifaEUR: 80,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '503192',
            puntoEmbarque: 'parguito',
            personas: 2,
            pagoVerificado: true,
            despachado: false
          });
        }

        // SÁBADO: Sofía Falcón (10:40 AM), Diego Arismendi (11:20 AM), Daniel Uzcátegui (01:20 PM), Valeria Gómez (03:00 PM)
        if (minT === 640) {
          listaReservas.push({
            idReserva: `${idSlot}-M01-SAB`,
            fecha: fechaSab,
            motoNum: '01',
            cli: 'Sofía Falcón',
            toldo: 'Sillas VIP #04 Parguito',
            chaleco: '01',
            duracionMin: 30,
            tarifaEUR: 60,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '619844',
            puntoEmbarque: 'parguito',
            personas: 2,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 680) {
          listaReservas.push({
            idReserva: `${idSlot}-M02-SAB`,
            fecha: fechaSab,
            motoNum: '02',
            cli: 'Diego Arismendi',
            toldo: 'Toldo Sunsol #07',
            chaleco: '03',
            duracionMin: 20,
            tarifaEUR: 40,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '338291',
            puntoEmbarque: 'sunsol',
            personas: 1,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 800) {
          listaReservas.push({
            idReserva: `${idSlot}-M01-SAB`,
            fecha: fechaSab,
            motoNum: '01',
            cli: 'Daniel Uzcátegui',
            toldo: 'Toldo Central Parguito',
            chaleco: '04',
            duracionMin: 40,
            tarifaEUR: 80,
            metodoPago: 'Efectivo €',
            referenciaPago: 'PAGO-ANTICIPADO',
            puntoEmbarque: 'parguito',
            personas: 2,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 900) {
          listaReservas.push({
            idReserva: `${idSlot}-M03-SAB`,
            fecha: fechaSab,
            motoNum: '03',
            cli: 'Valeria Gómez',
            toldo: 'Piscina Sunsol Caribe',
            chaleco: '08',
            duracionMin: 15,
            tarifaEUR: 30,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '920145',
            puntoEmbarque: 'sunsol',
            personas: 1,
            pagoVerificado: true,
            despachado: false
          });
        }

        // DOMINGO: Fernando Morales (10:20 AM), Camilo Rangel (12:00 PM), Familia Castillo (02:00 PM, 2 motos)
        if (minT === 620 && fechaDom !== fechaHoyISO) {
          listaReservas.push({
            idReserva: `${idSlot}-M02-DOM`,
            fecha: fechaDom,
            motoNum: '02',
            cli: 'Fernando Morales',
            toldo: 'Toldo Sunsol #11',
            chaleco: '02',
            duracionMin: 30,
            tarifaEUR: 60,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '448192',
            puntoEmbarque: 'sunsol',
            personas: 2,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 720) {
          listaReservas.push({
            idReserva: `${idSlot}-M03-DOM`,
            fecha: fechaDom,
            motoNum: '03',
            cli: 'Camilo Rangel',
            toldo: 'Toldo Familiar Parguito',
            chaleco: '05',
            duracionMin: 20,
            tarifaEUR: 40,
            metodoPago: 'Pago Móvil BCV',
            referenciaPago: '882014',
            puntoEmbarque: 'parguito',
            personas: 1,
            pagoVerificado: true,
            despachado: false
          });
        }
        if (minT === 840) {
          listaReservas.push(
            {
              idReserva: `${idSlot}-M01-DOM`,
              fecha: fechaDom,
              motoNum: '01',
              cli: 'Familia Castillo (M01)',
              toldo: 'Toldo Playa #03 Parguito',
              chaleco: '06',
              duracionMin: 30,
              tarifaEUR: 60,
              metodoPago: 'Efectivo €',
              referenciaPago: 'RESERVA-FAMILIAR',
              puntoEmbarque: 'parguito',
              personas: 2,
              pagoVerificado: true,
              despachado: false
            },
            {
              idReserva: `${idSlot}-M02-DOM`,
              fecha: fechaDom,
              motoNum: '02',
              cli: 'Familia Castillo (M02)',
              toldo: 'Toldo Playa #03 Parguito',
              chaleco: '07',
              duracionMin: 30,
              tarifaEUR: 60,
              metodoPago: 'Efectivo €',
              referenciaPago: 'RESERVA-FAMILIAR',
              puntoEmbarque: 'parguito',
              personas: 2,
              pagoVerificado: true,
              despachado: false
            }
          );
        }

        return {
          id: idSlot,
          orden: i + 1,
          jornada: jornadaSlot,
          minFijo: minT,
          reservas: listaReservas
        };
      });

      const slotsIniciales = recalcularHorariosCadena(base);
      const slotActivo = slotsIniciales.find(s => s.id === 'TK-105');
      const msRestantes = Math.max(60000, ((slotActivo ? slotActivo.finAguaMin : (mActual + 14)) - mActual) * 60 * 1000 + 32000);

      const motosIniciales = [
        {
          id: 'yamaha-01',
          numero: '01',
          nombre: 'YAMAHA GP1800R SVHO',
          subtitulo: 'RACING PERFORMANCE • 250 HP',
          descripcionCliente: 'Nuestra unidad más rápida con motor sobrealimentado 1.8L para adrenalina pura frente a la bahía de Playa Parguito.',
          imagen: 'https://images.unsplash.com/photo-1564689510742-4e9c7584181d?auto=format&fit=crop&w=800&q=80',
          capacidad: '1 a 2 Personas (Chalecos incluidos)',
          gasolinaLts: 56,
          gasolinaMax: 60,
          horometro: 142.6,
          horometroUltimoServicio: 100,
          intervaloServicioHrs: INTERVALO_SERVICIO_HRS,
          ubicacion: 'parguito',
          bitacoraMantenimiento: [
            { id: 'B-011', fecha: 'Semana pasada', hora: '08:30 AM', tipo: 'SERVICIO REALIZADO', detalle: 'Cambio de aceite, filtro y bujías (servicio 100 hrs)', horometro: 100 }
          ],
          estado: 'en_agua',
          alquiler: {
            slotId: 'TK-105',
